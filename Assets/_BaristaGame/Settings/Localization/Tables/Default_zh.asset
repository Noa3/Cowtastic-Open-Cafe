    m_Localized: "\u8C22\u8C22\u4F60\uFF01;\u6211\u5F88\u559C\u6B22\u8FD9\u91CC\u7684\u670D\u52A1\u548C\u996E\u6599\u3002\u592A\u597D\u4E86\uFF01;\u6211\u7231\u5B83\uFF01;\u5F88\u597D\u7684\u670D\u52A1\uFF01;\u7F8E\u5473\u7684\u996E\u6599\uFF01\u5F3A\u70C8\u63A8\u8350\uFF01;\u7F8E\u5999\u7684\u7ECF\u5386\uFF01\u6781\u597D\u7684\uFF01;\u5F88\u68D2\u7684\u670D\u52A1\uFF01\u559C\u6B22\u6BCF\u4E00\u53E3\uFF01\u9876\u5C16\uFF01;\u4E0D\u80FD\u66F4\u597D\u4E86\uFF01\u5B8C\u7F8E\u7684\u996E\u6599\uFF01\u5F88\u68D2\u7684\u670D\u52A1\uFF01;\u6B63\u662F\u6211\u6240\u9700\u8981\u7684\uFF01\u505A\u5F97\u597D\uFF01;\u7EE7\u7EED\u52AA\u529B\u5427\uFF01;\u4E00\u5B9A\u4F1A\u56DE\u6765\u7684\uFF01\u5370\u8C61\u6DF1\u523B\uFF01"
