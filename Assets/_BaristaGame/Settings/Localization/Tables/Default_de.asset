  - m_Id: 1657977076805632
    m_Localized: 'Zutaten:'
    m_Metadata:
      m_Items: []
  - m_Id: 133036188431392768
    m_Localized: "Machen Sie ein Getr\xE4nk, das es in sich hat."
    m_Metadata:
      m_Items: []
  - m_Id: 133036853224382464
    m_Localized: "Machen Sie Milch, bis das Caf\xE9 \xFCberschwemmt ist."
    m_Metadata:
      m_Items: []
  - m_Id: 133036805832941568
    m_Localized: Wellen machen
    m_Metadata:
      m_Items: []
  - m_Id: 1660808559161344
    m_Localized: Mitarbeiter verwalten
    m_Metadata:
      m_Items: []
  - m_Id: 1660182504763392
    m_Localized: Management
    m_Metadata:
      m_Items: []
  - m_Id: 1662860714668032
    m_Localized: "Maximale Gr\xF6\xDFe+"
    m_Metadata:
      m_Items: []
  - m_Id: 1677111105777664
    m_Localized: "Erh\xF6hen Sie die Kapazit\xE4t der Barista-Milch."
    m_Metadata:
      m_Items: []
  - m_Id: 1662565540524032
    m_Localized: Milchkaffee
    m_Metadata:
      m_Items: []
  - m_Id: 1677736099016704
    m_Localized: "Bef\xFCllen Sie den Barista sofort."
    m_Metadata:
      m_Items: []
  - m_Id: 133031481403088896
    m_Localized: Milchliebhaber
    m_Metadata:
      m_Items: []
  - m_Id: 1661098758860800
    m_Localized: Milchtyp
    m_Metadata:
      m_Items: []
  - m_Id: 132867783132815360
    m_Localized: Milchig
    m_Metadata:
      m_Items: []
  - m_Id: 132865505260838912
    m_Localized: 'Verdientes Geld:'
    m_Metadata:
      m_Items: []
  - m_Id: 133035228871106560
    m_Localized: Moonopoly
    m_Metadata:
      m_Items: []
  - m_Id: 1663875916591104
    m_Localized: Jetzt mehr Milch!
    m_Metadata:
      m_Items: []
  - m_Id: 133998653654802432
    m_Localized: Verwalten sie ihre Barista
    m_Metadata:
      m_Items: []
  - m_Id: 133998700043804672
    m_Localized: "Ihr oberstes Ziel ist es, das volle Potenzial Ihrer Barista auszusch\xF6pfen,
      aber Sie d\xFCrfen ihr Gl\xFCck bei der Arbeit nicht vernachl\xE4ssigen.  Sie
      nahm diesen Job in der Hoffnung an, in eine Molkerei bef\xF6rdert zu werden,
      aber selbst wenn dies ihr Traumjob ist, wird sie nicht bleiben, wenn sie zu
      ungl\xFCcklich wird.\n\nBringen Sie ihre Stimmung ins Gleichgewicht, w\xE4hrend
      Sie Fortschritte bei ihrer Gr\xF6\xDFe und Milchproduktion machen. Wenn Sie
      die Kunden gl\xFCcklich machen und sicherstellen, dass sie regelm\xE4\xDFig
      geleert wird, bleibt ihre Stimmung gut."
    m_Metadata:
      m_Items: []
  - m_Id: 133998785406279680
    m_Localized: "Hier k\xF6nnen Sie die Zufriedenheit und F\xFClle Ihres Baristas
      verfolgen.  Sinkt ihr Gl\xFCck auf 0, gibt sie auf.\n\nSo sehr sie auch wachsen
      m\xF6chte, Sie k\xF6nnen sie nicht die ganze Zeit \xFCber satt halten, sonst
      wird sie sich \xFCber den Muskelkater aufregen, aber Sie sollten sie auch nicht
      die ganze Zeit v\xF6llig leer halten, sonst k\xF6nnte das sie ebenfalls aufregen
      Versuchen Sie also, ein Gleichgewicht zu finden."
    m_Metadata:
      m_Items: []
  - m_Id: 133055089148010496
    m_Localized: Keine Aufzeichnungen
    m_Metadata:
      m_Items: []
  - m_Id: 132870450861154304
    m_Localized: Normal
    m_Metadata:
      m_Items: []
  - m_Id: 133036121565798400
    m_Localized: Eines von allem
    m_Metadata:
      m_Items: []
  - m_Id: 1661378443440128
    m_Localized: Outfitfarbe
    m_Metadata:
      m_Items: []
  - m_Id: 1661525407657984
    m_Localized: Hosenstil
    m_Metadata:
      m_Items: []
  - m_Id: 133034562396200960
    m_Localized: Spielen Sie das Spiel lange.
    m_Metadata:
      m_Items: []
  - m_Id: 133031655290544128
    m_Localized: "Produzieren Sie \xFCber 100 l Milch."
    m_Metadata:
      m_Items: []
