    m_Localized: "Erh\xF6hen Sie die Produktionsrate der Barista-Milch."
    m_Metadata:
      m_Items: []
  - m_Id: 133036731409211392
    m_Localized: "Erreichen Sie ihre wahre gr\xF6\xDFte Gr\xF6\xDFe."
