  - m_Id: 175666128926822400
    m_Localized: "\u0412\u043E\u0442 \u043A\u0430\u043A \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442\u0441\u044F,
      \u044F \u0443\u0445\u043E\u0436\u0443; \u0425\u0443\u0434\u0448\u0438\u0439
      \u0431\u043E\u0441\u0441... \u042F \u0443\u0445\u043E\u0436\u0443 \u043E\u0442\u0441\u044E\u0434\u0430;
      \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C,
      \u043F\u043E\u043A\u0430...; \u042F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B
      \u0441 \u044D\u0442\u0438\u043C \u0445\u0430\u043E\u0441\u043E\u043C! \u042F
      \u0443\u0445\u043E\u0436\u0443; \u042F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u044D\u0442\u043E\u0433\u043E \u0442\u0435\u0440\u043F\u0435\u0442\u044C!
      \u042F \u0443\u0445\u043E\u0436\u0443; \u042F \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u044E
      \u043B\u0443\u0447\u0448\u0435\u0433\u043E, \u0447\u0435\u043C \u044D\u0442\u043E!
      \u042F \u0443\u0445\u043E\u0436\u0443; \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u044D\u0442\u043E\u0433\u043E
      \u0441\u0442\u0440\u0435\u0441\u0441\u0430. \u042F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B!;
      \u041D\u0438 \u043E\u0434\u043D\u0430 \u0447\u0430\u0448\u043A\u0430 \u043A\u043E\u0444\u0435
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u044D\u0442\u043E\u0439 \u043C\u043E\u0440\u043E\u043A\u0438.
      \u042F \u0443\u0445\u043E\u0436\u0443!; \u041C\u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E!
      \u041F\u043E\u0440\u0430 \u0438\u0441\u043A\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0443\u044E
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C.; \u042F
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.
      \u042F \u0443\u0445\u043E\u0436\u0443!; \u0416\u0438\u0437\u043D\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043A\u043E\u0440\u043E\u0442\u043A\u0430 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0438\u044F. \u042F \u0443\u0445\u043E\u0436\u0443.;
      \u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u043D\u043E \u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B
      \u0438\u0433\u0440\u0430\u0442\u044C \u0432 \u0431\u0430\u0440\u0438\u0441\u0442\u0443.
      \u042F \u0443\u0445\u043E\u0436\u0443 \u043E\u0442\u0441\u044E\u0434\u0430!;
      \u042F \u043D\u0435 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0441\u044F!
      \u042F \u0443\u0445\u043E\u0436\u0443!; \u0417\u0430\u0431\u0443\u0434\u044C
      \u044D\u0442\u043E, \u044F \u0438\u0434\u0443 \u0434\u043E\u043C\u043E\u0439."
