      \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u043E\u0447\u0430\u0440\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
      \u043A\u0430\u043A \u0442\u0432\u043E\u0438 \u0433\u043B\u0430\u0437\u0430?;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0430\u044F,
      \u0442\u0432\u043E\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u0437\u0434\u0435\u0441\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u0430.;
      \u042D\u0439, \u043A\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430, \u0442\u0432\u043E\u044F
      \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u044C \u043C\u043E\u0436\u0435\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0432\u043A\u0443\u0441\u043D\u0435\u0435.; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043F\u0440\u0435\u043B\u0435\u0441\u0442\u044C, \u0442\u0432\u043E\u044F
      \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u043E\u0441\u0432\u0435\u0436\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F.;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u0430\u043D\u0433\u0435\u043B, \u0441
      \u0442\u0430\u043A\u0438\u043C \u0442\u0435\u043B\u043E\u043C, \u043A\u0430\u043A
      \u0442\u0432\u043E\u0435, \u043A\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u043E
      \u0432\u044B\u043F\u0438\u0442\u044C?; \u042D\u0439, \u043A\u0443\u043A\u043E\u043B\u043A\u0430,
      \u0442\u0432\u043E\u0438 \u0438\u0437\u0433\u0438\u0431\u044B \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435
      \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043A\u0440\u0430\u0441\u043E\u0442\u044B;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u043E\u0440\u043E\u0433\u0430\u044F,
      \u0442\u0432\u043E\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u2014 \u043B\u0443\u0447\u0448\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0433\u043E \u0431\u0430\u0440\u0430.;
      \u042D\u0439, \u0434\u0435\u0442\u043A\u0430, \u043E\u0442 \u0442\u0432\u043E\u0435\u0439
      \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0435\u0439 \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u0438
      \u0443 \u043C\u0435\u043D\u044F \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430.; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430, \u0442\u0432\u043E\u0435
      \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0441\u0435 \u0441\u043B\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 181789109562396672
    m_Localized: "\u042D\u0439, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430,
      \u0435\u0441\u0442\u044C \u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0448\u0430\u043D\u0441
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043E\u043B\u0448\u0435\u0431\u0441\u0442\u0432\u0430
      \u0432 \u043C\u043E\u0439 \u043A\u043E\u0444\u0435?; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430, \u0442\u044B \u043F\u043E\u0434\u0430\u0435\u0448\u044C
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043A\u0440\u043E\u043C\u0435
      \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432 \u0441 \u0442\u0430\u043A\u0438\u043C\u0438
      \u0444\u043E\u0440\u043C\u0430\u043C\u0438?; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430, \u0442\u0432\u043E\u0439
      \u0431\u044E\u0441\u0442 \u043C\u043E\u0433 \u0431\u044B \u0431\u044B\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u044C\u044E \u043C\u043E\u0435\u0433\u043E
      \u043A\u043E\u0444\u0435.; \u042D\u0439, \u043C\u0438\u043B\u0430\u044F \u043B\u0435\u0434\u0438,
      \u0432\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u043D\u0435
      \u043C\u0435\u043D\u044E, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0438\u043B\u0438 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435?;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043F\u0440\u0435\u043B\u0435\u0441\u0442\u044C,
      \u0441 \u0442\u0430\u043A\u0438\u043C \u0442\u0435\u043B\u043E\u043C, \u043A\u0430\u043A
      \u0443 \u0442\u0435\u0431\u044F, \u044F \u0431\u044B \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0430
      \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E.; \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u0430\u043D\u0433\u0435\u043B, \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u0430
      \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442
      \u0434\u043B\u044F \u043B\u044E\u0431\u043E\u0433\u043E \u043D\u0430\u043F\u0438\u0442\u043A\u0430.;
      \u042D\u0439, \u043A\u0443\u043A\u043E\u043B\u043A\u0430, \u043C\u043E\u0436\u043D\u043E
      \u043C\u043D\u0435 \u043A\u043E\u0444\u0435 \u0441 \u043E\u0442\u0442\u0435\u043D\u043A\u043E\u043C
      \u0442\u0432\u043E\u0435\u0433\u043E \u043E\u0431\u0430\u044F\u043D\u0438\u044F?;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u043E\u0440\u043E\u0433\u0430\u044F,
      \u0442\u0432\u043E\u0439 \u0431\u044E\u0441\u0442 - \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u0430\u044F
      \u0432\u0435\u0449\u044C \u0434\u043D\u044F.; \u042D\u0439, \u0434\u0435\u0442\u043A\u0430,
      \u0442\u0432\u043E\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u043B\u0443\u0447\u0448\u0435.;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430,
      \u0442\u044B \u0443\u043B\u044B\u0431\u0430\u0435\u0448\u044C\u0441\u044F \u0441\u0432\u043E\u0435\u0439
      \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 182195982329466880
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u043C\u043E\u043B\u043E\u043A\u0430 \u0434\u043B\u044F \u0431\u0430\u0440\u0438\u0441\u0442\u0430."
