    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1648740309233664
    m_Localized: "\u0412\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0441\u0432\u043E\u044E
      \u0431\u0430\u0440\u0438\u0441\u0442\u0443 \u0442\u0430\u043A\u043E\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439,
      \u043A\u0430\u043A\u043E\u0439 \u043E\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C! \u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432 \u0441\u0432\u043E\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B,
      \u043E\u043D\u0430 \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E
      \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0441\u044F
      \u043A \u0432\u0430\u0448\u0435\u0439 \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0439
      \u0444\u0435\u0440\u043C\u0435 \u043D\u0430 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0441\u0442\u0430\u0432\u043A\u0443, \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0432
      \u0441\u0432\u043E\u0439 \u0448\u0442\u0430\u0442 \u0435\u0449\u0435 \u043E\u0434\u043D\u043E\u0439
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u043E\u0439-\u043A\u043E\u0440\u043E\u0432\u043E\u0439!"
    m_Metadata:
