  - m_Id: 182196916119949312
    m_Localized: "\u0422\u043E\u043B\u0435\u0440\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u044C
      \u043A \u043F\u043E\u043B\u043D\u043E\u0442\u0435+"
    m_Metadata:
      m_Items: []
  - m_Id: 182196947719835648
    m_Localized: "\u0411\u0430\u0440\u0438\u0441\u0442\u0430 \u0442\u0435\u0440\u044F\u0435\u0442
      \u0441\u0447\u0430\u0441\u0442\u044C\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 219427788485054464
    m_Localized: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E...@Spoken_Ah;
      \u041C\u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0435\u0449\u0435 \u0440\u0430\u0437!@Spoken_Ah; \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0431\u0443\u0434\u0435\u0442 \u043B\u0443\u0447\u0448\u0435!@Spoken_Ah;
      \u041E\u0439! \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u043D\u043E\u0432\u0430...@Spoken_Ah; \u042D\u0442\u043E \u043D\u0435
      \u0441\u043E\u0432\u0441\u0435\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E...@Spoken_Ah;
      \u042D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0447\u0442\u0435\u043D\u043E
      \u0438\u0437 \u043C\u043E\u0435\u0439 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B?@Spoken_Ah;
      \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437.@Spoken_Ah; \u041F\u043E\u0445\u043E\u0436\u0435,
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438.@Spoken_Ah; \u041E\u0439!
      \u042D\u0442\u043E \u043D\u0435 \u043F\u043E\u0448\u043B\u043E \u043F\u043E
      \u043F\u043B\u0430\u043D\u0443.@Spoken_Ah; \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430
      \u0434\u0435\u043B\u0430\u0435\u0442 \u043C\u0430\u0441\u0442\u0435\u0440\u0430,
      \u043D\u0435 \u0442\u0430\u043A \u043B\u0438?@Spoken_Ah; \u041D\u0430 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u044D\u0442\u043E
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0441\u043C\u043E\u0442\u0440\u0438!@Spoken_Ah;
      \u041D\u0435 \u0431\u0443\u0434\u0435\u043C \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0442\u044C
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u043C \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443!@Spoken_Ah;
      \u042F \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u044E \u044D\u0442\u043E
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0447\u0430\u0448\u043A\u0438!@Spoken_Ah; \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0448\u0430\u0433 \u043D\u0430\u0437\u0430\u0434, \u043D\u043E \u044F \u0432\u0435\u0440\u043D\u0443\u0441\u044C!@Spoken_Ah;
      \u041D\u0443, \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u043F\u0430\u043B\u043E
      \u0432 \u0446\u0435\u043B\u044C.@Spoken_Ah; \u0412\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043A \u0447\u0435\u0440\u0442\u0435\u0436\u043D\u043E\u0439 \u0434\u043E\u0441\u043A\u0435,
      \u044F \u0434\u0443\u043C\u0430\u044E.@Spoken_Ah; \u0425\u043C, \u043F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435
      \u043C\u043D\u0435 \u043F\u0435\u0440\u0435\u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u044D\u0442\u043E.@Spoken_Ah; \u042D\u0442\u043E \u0432\u0441\u0435\u0433\u043E
      \u043B\u0438\u0448\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u0437\u0430\u043C\u0438\u043D\u043A\u0430 \u0432 \u043C\u043E\u0435\u043C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
      \u0448\u0435\u0434\u0435\u0432\u0440\u0430.@Spoken_Ah; \u042D\u0442\u043E \u043D\u0435
      \u0441\u043E\u0432\u0441\u0435\u043C \u0442\u043E, \u0447\u0442\u043E \u044F
      \u0438\u043C\u0435\u043B \u0432 \u0432\u0438\u0434\u0443, \u043D\u043E \u044F
      \u0434\u043E\u0431\u0435\u0440\u0443\u0441\u044C \u0434\u043E \u044D\u0442\u043E\u0433\u043E.@Spoken_Ah;
      \u041E\u0439, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437, \u0445\u043E\u0440\u043E\u0448\u043E?@Spoken_Ah;
      \u041D\u0443, \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E.
