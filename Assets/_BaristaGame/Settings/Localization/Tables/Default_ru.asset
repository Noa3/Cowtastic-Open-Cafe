  - m_Id: 175640229514858496
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435 2000
      \u043C\u043B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 175641060461006848
    m_Localized: "\u0427\u0430\u0448\u043A\u0430 \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 175650030386958336
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u043D\u043E\u0432\u0430\u044F \u0436\u0438\u0437\u043D\u044C.@Intro_NewJobNewLife;
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u043B\u044E\u0434\u0438
      \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u0435.@Intro_IHopePeopleAreNice;
      \u041D\u0435 \u043C\u043E\u0433\u0443 \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C!@Intro_ICantWaitToStart;
      \u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430
      \u0440\u0430\u0431\u043E\u0442\u0435.@Intro_FirstDayOnTheJob"
    m_Metadata:
      m_Items: []
  - m_Id: 175651777658507264
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442!; \u041F\u0440\u0438\u0432\u0435\u0442\u0438\u043A!;
      \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!;
      \u0427\u0442\u043E \u0432\u0430\u043C \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?;
      \u041E\u0431\u044B\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E?; \u0427\u0435\u043C
      \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C?; \u0427\u0442\u043E
      \u0432\u0430\u043C \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?; \u0414\u043E\u0431\u0440\u043E
      \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C! \u0427\u0442\u043E
      \u044F \u043C\u043E\u0433\u0443 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
      \u0432\u0430\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F?; \u0412\u044B
      \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442\u0435
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F! \u0427\u0442\u043E \u0432\u0430\u043C
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?; \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435: \u0421\u0432\u0435\u0436\u0435\u0435
      \u043C\u043E\u043B\u043E\u043A\u043E!; \u0412\u044B \u0443\u0436\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0438
      \u043C\u043E\u043B\u043E\u043A\u043E \u0431\u043E\u0431\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 175662100285247488
    m_Localized: "\u042F \u0445\u043E\u0447\u0443 \u044D\u0442\u043E\u0442 \u043F\u0435\u0447\u0435\u043D\u044C\u0435!;
      \u042D\u0442\u043E \u043F\u0435\u0447\u0435\u043D\u044C\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0432\u043A\u0443\u0441\u043D\u044B\u043C.; \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
      \u043A\u0430\u043A \u044D\u0442\u043E \u043F\u0435\u0447\u0435\u043D\u044C\u0435
      \u0432\u043A\u0443\u0441\u0438\u0442...?; \u0412\u043B\u0435\u0437\u0435\u0442
      \u043B\u0438 \u0446\u0435\u043B\u043E\u0435 \u043F\u0435\u0447\u0435\u043D\u044C\u0435
      \u0432 \u043C\u043E\u0438\u0306 \u0440\u043E\u0442?; \u041A\u043E\u0433\u0434\u0430
      \u044F \u043F\u043E\u043B\u0443\u0447\u0443 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u043E\u0435
      \u043F\u0435\u0447\u0435\u043D\u044C\u0435?; \u042D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
      \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u0432\u0435\u0440\u043D\u043E?;
      \u042F \u0445\u043E\u0447\u0443 \u0440\u0430\u0441\u0442\u0438...; \u0412\u043E\u0442
      \u043E\u043D\u043E, \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u043F\u0435\u0447\u0435\u043D\u044C\u044F!;
      \u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u043F\u0435\u0447\u0435\u043D\u044C\u0435!
      \u041F\u043E\u0432\u0442\u043E\u0440\u044F\u044E, \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
      \u043F\u0435\u0447\u0435\u043D\u044C\u0435!; \u0412\u0441\u0435\u0308 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D\u043E \u043A \u044D\u0442\u043E\u043C\u0443
      \u043F\u0435\u0447\u0435\u043D\u044C\u044E!; \u0412\u0440\u0435\u043C\u044F
      \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438\u0306 \u0432\u043A\u0443\u0441 \u043A \u043F\u0435\u0447\u0435\u043D\u044C\u044E!;
      \u041C\u0438\u0441\u0441\u0438\u044F \"\u041F\u0435\u0447\u0435\u043D\u044C\u0435\"
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u0430!;
      \u0420\u0430\u0434\u0430\u0440 \"\u041F\u0435\u0447\u0435\u043D\u044C\u0435\"
      \u0432\u043A\u043B\u044E\u0447\u0435\u0308\u043D!; \u042F \u043E\u0431\u043C\u0435\u043D\u044F\u044E
