    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C
      \u0431\u043E\u043B\u0435\u0435 100 \u043B \u043C\u043E\u043B\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 133036731409211392
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0447\u044C \u0441\u0432\u043E\u0435\u0433\u043E
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E
      \u0440\u0430\u0437\u043C\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 132752649106333696
    m_Localized: "\u041F\u0435\u0441\u043E\u0447\u043D\u0438\u0446\u0430"
    m_Metadata:
