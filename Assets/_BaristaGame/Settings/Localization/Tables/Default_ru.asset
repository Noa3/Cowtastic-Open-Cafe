      \u043C\u044B \u043F\u043B\u0430\u0432\u0430\u0435\u043C \u0432 \u043C\u043E\u0440\u0435
      \u0434\u0435\u043D\u0435\u0433! @Spoken_Hm; \u041F\u043E\u0445\u043E\u0436\u0435,
      \u043C\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438
      \u0434\u0436\u0435\u043A\u043F\u043E\u0442! @Spoken_Hm; \u041A\u0442\u043E
      \u0431\u044B \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u043A\u043E\u0444\u0435
      \u0442\u0430\u043A \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u043E?
      @Spoken_Hm; \u0423 \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0434\u0435\u043D\u0435\u0433, \u0447\u0435\u043C \u043C\u044B \u0437\u043D\u0430\u0435\u043C,
      \u0447\u0442\u043E \u0441 \u043D\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u0442\u044C!
      @Spoken_Hm; \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0443 \u043D\u0430\u0441
      \u0431\u0443\u0434\u0435\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043D\u0435\u0433
      \u0432 \u043D\u0430\u0448\u0435\u043C \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435!
      @Spoken_Hm; \u042F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0434\u0443\u043C\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043C\u044B \u0432 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u0431\u0438\u0437\u043D\u0435\u0441\u0435 \u0441 \u0442\u0430\u043A\u0438\u043C\u0438
      \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438! @Spoken_Hm; \u041D\u0430\u0448\u0430
      \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435! @Spoken_Hm; \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043C\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C
      \u043F\u0435\u0447\u0430\u0442\u043D\u044B\u043C \u0441\u0442\u0430\u043D\u043A\u043E\u043C
      \u0432\u043C\u0435\u0441\u0442\u043E \u043A\u0430\u0444\u0435! @Spoken_Hm;
      \u0423 \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u043D\u0435\u0433,
      \u0447\u0435\u043C \u043C\u044B \u0437\u043D\u0430\u0435\u043C, \u0447\u0442\u043E
      \u0441 \u043D\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u0442\u044C! @Spoken_Hm;
      \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B
      \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043D\u0435\u0433 \u0432
      \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435! @Spoken_Hm;
      \u041C\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0442\u043E\u043D\u0435\u043C \u0432 \u0434\u0435\u043D\u044C\u0433\u0430\u0445!
      @Spoken_Hm; \u0421 \u044D\u0442\u0438\u043C\u0438 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
      \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C
      \u0446\u0435\u043B\u044B\u0439 \u0433\u043E\u0440\u043E\u0434! @Spoken_Hm;
      \u042D\u0439, \u0431\u043E\u0441\u0441, \u0442\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0434\u0435\u043D\u044C\u0433\u0438, \u0434\u0430? @Spoken_Hm"
    m_Metadata:
      m_Items: []
