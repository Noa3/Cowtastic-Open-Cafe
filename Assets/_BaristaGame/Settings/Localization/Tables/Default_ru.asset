  - m_Id: 135009503337357312
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 135009184603807744
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 134180290938118144
    m_Localized: "\u042D\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
      \u0432\u0441\u044F \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442\u044C.\r\n\u0418\u0433\u0440\u043E\u0432\u043E\u0439
      \u0446\u0438\u043A\u043B \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C
      \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u043C: \u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      \u043D\u0430\u043F\u0438\u0442\u043A\u0438, \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0439\u0442\u0435
      \u0434\u0435\u043D\u044C\u0433\u0438, \u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432,
      \u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0439\u0442\u0435
      \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u043D\u0435\u0433,
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435 \u0434\u043E \u0442\u0435\u0445
      \u043F\u043E\u0440, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442
      \xAB\u043C\u0443\xBB.\r\n\r\n\u0415\u0441\u043B\u0438 \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435
      \u0447\u0435\u043B\u043B\u0435\u043D\u0434\u0436\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u043D\u0430\u0439\u0442\u0438 \u0443\u043C\u043D\u044B\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
      \u0438\u043B\u0438 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F. \u0415\u0441\u043B\u0438
      \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0441\u0438\u043B\u0438\u0442\u044C
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043D\u0430\u0440\u044F\u0434\u043E\u0432!
      \u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
      \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441\u0432\u043E\u0438\u043C \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u043C
      \u043A\u043E\u0444\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 134180089527640064
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u0438\u043A \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 134179468267331584
    m_Localized: "\u0412 \u0430\u0440\u043A\u0430\u0434\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
      \u043A\u043D\u043E\u043F\u043A\u0430 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u2014 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432\u0441\u0435 \u0432\u0430\u0448\u0438
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E \u0431\u0430\u0440\u0438\u0441\u0442\u0430.
      \u0422\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0435\u0435 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438
      \u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044F\u043C\u0438
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F.\r\n\r\n\u0422\u0430\u043A\u0436\u0435
      \u0432 \u043D\u0435\u0433\u043E \u0432\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u043D\u044E
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438
      \u043D\u0430\u0440\u044F\u0434\u043E\u0432 \u0438 \u0446\u0432\u0435\u0442\u043E\u0432.\r\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 134179994149167104
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 134011680659709952
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0438\u0433\u0440\u044B \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u043F\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F.\r\n\r\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0438\u0437 \u044D\u0442\u0438\u0445 \u0441\u043E\u0431\u044B\u0442\u0438\u0439
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438,
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0430\u044E\u0442
      \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E
      \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0443, \u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0433\u043B\u0443\u043F\u044B.\r\n\u0421\u043B\u0435\u0434\u0438\u0442\u0435
      \u0437\u0430 \u0442\u0435\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044C
      \u043D\u0435 \u0431\u044B\u0442\u044C \u0437\u0430\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044B\u043C\u0438
      \u0438\u043C\u0438 \u0432\u0440\u0430\u0441\u043F\u043B\u043E\u0445!"
    m_Metadata:
