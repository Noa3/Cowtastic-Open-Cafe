  - m_Id: 181789087093510144
    m_Localized: "\u042D\u0439, \u043A\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430,
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043C\u043E\u0439 \u0434\u0435\u043D\u044C \u043B\u0443\u0447\u0448\u0435
      \u0443\u043B\u044B\u0431\u043A\u043E\u0439?; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430, \u0432 \u0447\u0435\u043C
      \u0441\u0435\u043A\u0440\u0435\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u0442\u044B \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C?;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430,
      \u0435\u0441\u0442\u044C \u043B\u0438 \u0448\u0430\u043D\u0441, \u0447\u0442\u043E
      \u0442\u044B \u0435\u0441\u0442\u044C \u0432 \u043C\u0435\u043D\u044E?; \u042D\u0439,
      \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430, \u0443 \u0442\u0435\u0431\u044F
      \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442
      \u043A \u0442\u0432\u043E\u0435\u0439 \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u0438?;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043F\u0440\u0435\u043B\u0435\u0441\u0442\u044C,
      \u0442\u0432\u043E\u044F \u0443\u043B\u044B\u0431\u043A\u0430 - \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u0441\u043E\u0431\u044B\u0442\u0438\u0435 \u043C\u043E\u0435\u0433\u043E \u0434\u043D\u044F.;
      \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0430\u043D\u0433\u0435\u043B,
      \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u043C\u043E\u0433\u043B\u0430
      \u0431\u044B \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u0441\u0430\u043C\u0443\u044E
      \u0442\u0435\u043C\u043D\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443.;
      \u042D\u0439, \u043A\u0443\u043A\u043E\u043B\u043A\u0430, \u0443 \u0442\u0435\u0431\u044F
      \u0435\u0441\u0442\u044C \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0435
      \u0437\u0435\u043B\u044C\u044F \u0434\u043B\u044F \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0433\u043E
      \u0441\u0435\u0440\u0434\u0446\u0430?; \u041F\u0440\u0438\u0432\u0435\u0442,
      \u0434\u043E\u0440\u043E\u0433\u0430\u044F, \u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C
      \u0432\u0441\u0435 \u043D\u0430\u043F\u0438\u0442\u043A\u0438 \u0442\u0430\u043A\u0438\u043C\u0438
      \u0436\u0435 \u0441\u043B\u0430\u0434\u043A\u0438\u043C\u0438, \u043A\u0430\u043A
      \u0442\u044B?; \u042D\u0439, \u0434\u0435\u0442\u043A\u0430, \u0442\u0432\u043E\u044F
      \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u043E\u043F\u044C\u044F\u043D\u044F\u0435\u0442.;
      \u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0430,
      \u0442\u0432\u043E\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0437\u0434\u0435\u0441\u044C \u0441\u0430\u043C\u043E\u0435 \u043B\u0443\u0447\u0448\u0435\u0435."
