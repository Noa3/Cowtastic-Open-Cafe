  - m_Id: 132865505260838912
    m_Localized: "\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
      \u0434\u0435\u043D\u044C\u0433\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 133035228871106560
    m_Localized: "\u041C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 133998653654802432
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0430\u0448\u0438\u043C
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133998700043804672
    m_Localized: "\u0412\u0430\u0448\u0430 \u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F
      \u0446\u0435\u043B\u044C \u2014 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C
      \u0432\u0435\u0441\u044C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430, \u043D\u043E \u0432\u044B \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0435\u0435 \u0441\u0447\u0430\u0441\u0442\u044C\u0435, \u043F\u043E\u043A\u0430
      \u043E\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u041E\u043D\u0430
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u044D\u0442\u0443
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
      \u0434\u043E \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u043D\u0430
      \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0439 \u0444\u0435\u0440\u043C\u0435,
      \u043D\u043E \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044D\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0435\u0435 \u043C\u0435\u0447\u0442\u044B,
      \u043E\u043D\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u043E\u0439.\r\n\r\n\u0421\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u0443\u0439\u0442\u0435
      \u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435,
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0434\u043E\u0431\u0438\u0432\u0430\u044F\u0441\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430 \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u0445
      \u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435
      \u043C\u043E\u043B\u043E\u043A\u0430, \u0434\u0435\u043B\u0430\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C\u0438 \u0438 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
      \u043E\u043F\u043E\u0440\u043E\u0436\u043D\u044F\u044F \u0435\u0435, \u044D\u0442\u043E
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0435\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 133998785406279680
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0441\u0447\u0430\u0441\u0442\u044C\u044F \u0438 \u0441\u044B\u0442\u043E\u0441\u0442\u0438
      \u0432\u0430\u0448\u0435\u0433\u043E \u0431\u0430\u0440\u0438\u0441\u0442\u0430.
      \u0415\u0441\u043B\u0438 \u0435\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0441\u0447\u0430\u0441\u0442\u044C\u044F \u043F\u0430\u0434\u0430\u0435\u0442
      \u0434\u043E 0, \u043E\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442.\r\n\r\n\u041A\u0430\u043A
      \u0431\u044B \u043E\u043D\u0430 \u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u0430
      \u0440\u0430\u0441\u0442\u0438, \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0435\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u043E\u043B\u043D\u043E\u0439 \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F,
      \u0438\u043D\u0430\u0447\u0435 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u0442 \u0435\u0435, \u043D\u043E
      \u0432\u044B \u0442\u0430\u043A\u0436\u0435 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0435\u0435 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F,
      \u0438\u043D\u0430\u0447\u0435 \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442
      \u0435\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u0442\u044C,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044C
      \u043D\u0430\u0439\u0442\u0438 \u0431\u0430\u043B\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
