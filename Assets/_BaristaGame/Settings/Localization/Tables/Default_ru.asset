  - m_Id: 134011413927141376
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 134010918655336448
    m_Localized: "\u0422\u0430\u043A\u0436\u0435 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430, \u043B\u044E\u0434\u044F\u043C
      \u0437\u0434\u0435\u0441\u044C, \u043F\u043E\u0445\u043E\u0436\u0435, \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u0432\u0443\u0448\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0438 \u043F\u043E\u043B\u043D\u043E\u0439,
      \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439,
      \u0447\u0442\u043E \u0431\u0430\u043B\u0430\u043D\u0441 \u0434\u043B\u044F
      \u0435\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0441 \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\r\n\r\n\u041D\u043E \u043A\u0430\u043A\u043E\u0439
      \u0441\u043C\u044B\u0441\u043B \u0432 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0445
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u0445? \u041D\u0443, \u043E\u043D\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u0445\u043E\u0442\u0435\u0442\u044C
      \u0447\u0435\u0433\u043E-\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0433\u043E
      \u0432 \u0441\u0432\u043E\u0435\u043C \u043D\u0430\u043F\u0438\u0442\u043A\u0435,
      \u0435\u0441\u043B\u0438 \u0438\u0445 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u044D\u0442\u043E!
      \u041E\u0441\u043E\u0431\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u043E\u0438\u0442 \u043A\u0443\u0447\u0443
      \u0434\u0435\u043D\u0435\u0433...!"
    m_Metadata:
      m_Items: []
