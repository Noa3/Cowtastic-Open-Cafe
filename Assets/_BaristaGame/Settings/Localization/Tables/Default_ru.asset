      \u0431\u0430\u0440\u0438\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1677111105777664
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u044C\u0442\u0435 \u043E\u0431\u044A\u0435\u043C
      \u043C\u043E\u043B\u043E\u043A\u0430 \u0431\u0430\u0440\u0438\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1677334284693504
    m_Localized: "\u0423\u043B\u0443\u0447\u0448\u0438\u0442\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0431\u0430\u0440\u0438\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1677541911130112
    m_Localized: "\u0411\u043E\u043B\u0435\u0435 \u043D\u0438\u0437\u043A\u0430\u044F
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043C\u043E\u043B\u043E\u043A\u0430 \u0431\u0430\u0440\u0438\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1677736099016704
    m_Localized: "\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435
      \u0431\u0430\u0440\u0438\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1677955096211456
    m_Localized: "\u0411\u0430\u0440\u0438\u0441\u0442\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435
      \u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u0447\u0430\u0441\u0442\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1683396865912832
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 Cowtastic cafe!"
    m_Metadata:
      m_Items: []
  - m_Id: 1683534711713792
    m_Localized: "\xAB\u0412\u0430\u0448\u0430 \u043C\u043E\u043B\u043E\u0447\u043D\u0430\u044F
      \u0444\u0435\u0440\u043C\u0430 \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0440\u0435\u0448\u0438\u043B\u0430
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \xAB\u043A\u043E\u0440\u043E\u0432\u044C\u0435 \u043A\u0430\u0444\u0435\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u0441
      \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u043C, \u043D\u0430\u0440\u044F\u0434\u0443
      \u0441 \u044D\u0442\u0438\u043C, \u044D\u0442\u043E \u0442\u0430\u043A\u0436\u0435
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u043C
      \u043A\u043E\u0440\u043E\u0432\u0430\u043C \u0440\u0430\u0431\u043E\u0447\u0438\u0438
      \u043C\u0435\u0441\u0442\u0430, \u043F\u043E\u043A\u0430 \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0435
      \u0438\u0445 \u043A \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0430 \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0439
      \u0444\u0435\u0440\u043C\u0435.\n\n\u0412\u0430\u0448\u0430 \u043F\u0435\u0440\u0432\u0430\u044F
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u0440\u0430\u0434\u0430 \u043D\u0430\u0447\u0430\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043B\u043D\u0430 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430,
      \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u0435\u0439 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C
      \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435
      \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u043F\u043E\u043B\u043D\u043E\u0439
      \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0439 \u0441\u0438\u043B\u044B!\n\n\u041A\u0430\u0444\u0435
      \u043D\u043E\u0432\u043E\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u0430\u043C \u0442\u0430\u043A\u0436\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B
      \u043F\u043E \u0445\u043E\u0434\u0443 \u0434\u0435\u043B\u0430.\n\u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E,
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043B\u0438\u0435\u043D\u0442\u044B
      \u0437\u0434\u0435\u0441\u044C \u043E\u0447\u0435\u043D\u044C \u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432\u044B
      \u043A \u0438\u0434\u0435\u0435 \u0434\u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0437\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0436\u0435\u0433\u043E
      \u043C\u043E\u043B\u043E\u043A\u0430 \u0435\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438.\n\n\u0415\u0441\u043B\u0438
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u043E\u043C\u043E\u0449\u044C \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0438\u0433\u0440\u044B, \u0435\u0441\u0442\u044C \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0449\u0438\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1684438634557440
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u041A\u0430\u0444\u0435 \u0425\u0410\u041E\u0421!"
    m_Metadata:
      m_Items: []
  - m_Id: 1684540275126272
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u0435 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E\u043C\u0430, \u0432\u043E \u0432\u0441\u0435\u043C \u043A\u0430\u0444\u0435
      \u0446\u0430\u0440\u0438\u0442 \u0445\u0430\u043E\u0441, \u0437\u0434\u0435\u0441\u044C
      \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F \u0432\u0441\u044F\u043A\u043E\u0435
      \u0431\u0435\u0437\u0443\u043C\u0438\u0435!  \u042D\u0442\u043E \u0447\u0442\u043E
      \u0437\u0430 \u0446\u0435\u043D\u044B?  \u041F\u043E\u0447\u0435\u043C\u0443
      \u0432\u0441\xEB \u044D\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u043A\u043B\u0438\u0435\u043D\u0442?\n\n \u041F\u0440\u0438\u0432\u0435\u0442,
      \u043F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0430\u0448\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435
      \u043F\u0430\u0441\u0445\u0430\u043B\u044C\u043D\u043E\u0435 \u044F\u0439\u0446\u043E.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432\u044B \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C
      \u0432 \u0434\u0440\u0443\u0433\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435,
      \u0435\u0441\u043B\u0438 \u0432\u044B \u043A\u0430\u043A\u0438\u043C-\u0442\u043E
      \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u043A\u0438.\n\n\u0412\u0430\u043C
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u043C\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u043D\u0438\u0439 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0438\u0433\u0440\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C
      \u044D\u0442\u043E\u0442 \u0445\u0430\u043E\u0441, \u0438\u043B\u0438 \u043D\u0435\u0442...
      \u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u044D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C?  \u0415\u0441\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0441\u043F\u043E\u0441\u043E\u0431
      \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C.\n\n \u0418 \u0441\u043F\u0430\u0441\u0438\u0431\u043E
      \u0437\u0430 \u0438\u0433\u0440\u0443!"
