  - m_Id: 231828173975552
    m_Localized: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0420\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 233523209662464
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0410\u0440\u043A\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 234141684953088
    m_Localized: "\u0421\u043E\u0432\u0435\u0442\u044B \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043C\u043E\u0433\u0443\u0442
      \u0432\u0430\u043C \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u043C\u0435\u0442\u043E\u0434 \u043F\u0440\u043E\u0431
      \u0438 \u043E\u0448\u0438\u0431\u043E\u043A \u044D\u0442\u043E \u043D\u0435
      \u0432\u0430\u0448 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 234396560224256
    m_Localized: "\u0421\u0442\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 266450740015104
    m_Localized: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 266676540370944
    m_Localized: "\u0418\u0433\u0440\u0430\u0439\u0442\u0435 \u0434\u043E \u0442\u0435\u0445
      \u043F\u043E\u0440, \u043F\u043E\u043A\u0430 \u0432\u0430\u0448\u0430 \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u044D\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u043B\u0438
      \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043D\u0435 \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u0442\u0441\u044F
      \u0438 \u043D\u0435 \u0443\u0439\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 269021949030400
    m_Localized: "\u0422\u044F\u0436\u043E\u043B\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 269212714364928
    m_Localized: "\xAB\u041A\u043B\u0438\u0435\u043D\u0442\u044B \u0431\u043E\u043B\u0435\u0435
      \u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u044B, \u0430 \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u0431\u043E\u043B\u0435\u0435 \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u0430\u044F,
      \u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043E\u043D\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044C \u0435\u0449\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435!\n\u041D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430,
      \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 269706832736256
    m_Localized: "\u041B\u0451\u0433\u043A\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 269928791109632
    m_Localized: "\xAB\u0418\u043D\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u2014 \u0445\u043E\u0442\u0435\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F.\n\u0411\u043E\u043B\u0435\u0435
      \u0434\u0435\u0448\u0435\u0432\u044B\u0435 \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435
      \u0446\u0435\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043B\u0435\u0433\u043A\u043E \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 271100448960512
    m_Localized: "\u0425\u0430\u043E\u0442\u0438\u0447\u043D\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 273385908432896
    m_Localized: "\"\u041E, \u043D\u0435\u0442.\n\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u0440\u0430\u0434\u0438 \u0432\u0441\u0435\u0433\u043E \u0441\u0432\u044F\u0442\u043E\u0433\u043E,
      \u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435, \u0447\u0442\u043E \u0442\u044B
      \u0445\u043E\u0442\u044F \u0431\u044B \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u044B\u0433\u0440\u0430\u043B \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C, \u0432\u0435\u0440\u043D\u043E? \u0414\u043B\u044F
      \u0442\u0432\u043E\u0435\u0433\u043E \u0436\u0435 \u0431\u043B\u0430\u0433\u0430...
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430!\""
    m_Metadata:
      m_Items: []
  - m_Id: 274592542584832
    m_Localized: "\u0423\u043B\u044C\u0442\u0440\u0430 \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u0430\u044F
      \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 274821425754112
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u043D\u0430 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u0442\u044B \u0421\u0415\u0420\u042C\u0415\u0417\u041D\u041E
      \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u043D\u0430\u0439\u0442\u0438
      \u044D\u0442\u043E. \u0415\u0441\u043B\u0438 \u0432 \u0432\u0430\u0448\u0435\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435 \u0435\u0449\u0451 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u043A \u0441\u0435\u0431\u0435,
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
