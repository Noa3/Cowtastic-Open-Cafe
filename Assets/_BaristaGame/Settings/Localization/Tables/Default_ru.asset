  - m_Id: 133036482359828480
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u043F\u0435\u0441\u043E\u0447\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 133036011389820928
    m_Localized: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432\u0441\u0435\u0445 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432-\u043A\u0440\u043E\u0441\u0441\u043E\u0432\u0435\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 133034908078153728
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C 1000 \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 133036677680177152
    m_Localized: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 132865470217428992
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B:"
    m_Metadata:
      m_Items: []
  - m_Id: 133992199195566080
    m_Localized: "\u041D\u0435\u0434\u0430\u0432\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0432
      \u043D\u043E\u0432\u043E\u0435 \u043A\u0430\u0444\u0435 \u0438 \u043D\u0430\u043D\u044F\u0432
      \u044D\u0442\u0443 \u0441\u0432\u0435\u0436\u0443\u044E \u0434\u0435\u0432\u0443\u0448\u043A\u0443-\u043A\u043E\u0432\u0431\u043E\u044F
      \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0431\u0430\u0440\u0438\u0441\u0442\u0430,
      \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043C\u043E\u0447\u044C
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432,
      \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0441\u043B\u0435\u0434\u044F
      \u0437\u0430 \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430
      \u0431\u044B\u043B\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430.
      \u0412\u0430\u0436\u043D\u043E \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043D\u0435 \u0443\u0439\u0434\u0435\u0442,
      \u0442\u0430\u043A \u043A\u0430\u043A \u043E\u043D\u0430, \u043F\u043E\u0445\u043E\u0436\u0435,
      \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u0430
      \u0432 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0434\u043E
      \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u0434\u043E\u044F\u0440\u043A\u0438
      \u043D\u0430 \u0432\u0430\u0448\u0435\u0439 \u0444\u0435\u0440\u043C\u0435,
      \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u0435\u0442
      \u043A \u044D\u0442\u043E\u043C\u0443 \u0433\u043E\u0442\u043E\u0432\u0430.\r\n\r\n\u0415\u0441\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0432 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0432\u0430\u043C \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u043C,
      \u0432\u044B, \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u043C\u043E\u0449\u044C \u0432
      \u044D\u0442\u043E\u043C \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0435.
      \u0412 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
      \u0432\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      \u0436\u0435 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043A
      \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044E \u0438\u0433\u0440\u044B \u043C\u0435\u0442\u043E\u0434\u043E\u043C
      \u043F\u0440\u043E\u0431 \u0438 \u043E\u0448\u0438\u0431\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 133993158466445312
    m_Localized: "\u041C\u044B\u0448\u044C \u2014 \u044D\u0442\u043E \u0432\u0441\u0435,
      \u0447\u0442\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F
      \u0438\u0433\u0440\u044B, \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
      \u043A\u043D\u043E\u043F\u043E\u043A \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F.\r\n\r\n\u0415\u0441\u043B\u0438
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F, \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C
      \u0440\u0435\u0436\u0438\u043C\u0435 \u0435\u0441\u0442\u044C \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0449\u0438\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0430\u044E\u0442 \u043C\u0430\u0441\u0441\u0443 \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438.\r\n\r\n\u0412\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E\u043C
      \u043C\u0435\u0445\u0430\u043D\u0438\u043A, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438.\r\n\r\n(\u0421\u0435\u043D\u0441\u043E\u0440\u043D\u043E\u0435
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u0435\u0441\u043B\u0438 \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435
      \u044D\u0442\u043E \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435,
      \u043E\u043D\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0445\u043E\u0442\u044F \u0431\u044B \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E,
      \u044F \u043F\u043E\u043B\u0430\u0433\u0430\u044E?)"
    m_Metadata:
      m_Items: []
  - m_Id: 133995531494596608
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B \u2014
      \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432.\r\n\r\n\u0423
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430
      \u0435\u0441\u0442\u044C \u043F\u043E\u0440\u0442\u0440\u0435\u0442, \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0439
      \u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435,
      \u0438 \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0437\u0430\u043A\u0430\u0437, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u044D\u0442\u043E\u0439 \u0433\u0440\u0430\u0444\u0438\u043A\u043E\u0439.\r\n\r\n\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435
      \u043E\u0441\u043E\u0431\u043E\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u0430 \u0438 \u043D\u0430
      \u0442\u043E, \u043A\u0430\u043A\u0438\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u043E\u043D \u0445\u043E\u0447\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 133996458540638208
    m_Localized: "\u0412\u043E\u0442 \u0432\u0430\u0448\u0438 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B.
      \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0442\u044C
      \u0447\u0430\u0448\u043A\u0443, \u0438\u043B\u0438 \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0445
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0438\u0445 \u0432 \u043D\u0430\u043F\u0438\u0442\u043E\u043A.\r\n\r\n\u0412\u0430\u0448\u0435
      \u043A\u0430\u0444\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u043E\u0442\u043A\u0440\u044B\u043B\u043E\u0441\u044C \u0438 \u0432\u0441\u0435
      \u0435\u0449\u0435 \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432
      \u0437\u0430\u043F\u0430\u0441\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432. \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044C
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438\u0445 \u0432\u0441\u0435.\r\n\r\n\u041F\u043E\u043A\u0443\u043F\u043A\u0430
      \u043D\u043E\u0432\u044B\u0445 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432
      \u0432\u0430\u0436\u043D\u0430 \u0434\u043B\u044F \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u0434\u0435\u043D\u0435\u0433, \u0447\u0435\u043C \u0441\u043B\u043E\u0436\u043D\u0435\u0435
      \u043D\u0430\u043F\u0438\u0442\u043E\u043A, \u0442\u0435\u043C \u0432\u044B\u0448\u0435
      \u0435\u0433\u043E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 133997655410450432
    m_Localized: "\u042D\u0442\u043E \u0447\u0430\u0448\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0432\u044B \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0435 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430,
      \u043F\u0440\u0438 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438
      \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043B\u0438\u043D\u0438\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
      \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u043E\u0447\u043D\u043E \u0432\u0430\u0448 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u0437\u0430\u043F\u0440\u043E\u0441\u0443 \u043A\u043B\u0438\u0435\u043D\u0442\u0430.\r\n\r\n\u0422\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u043F\u0438\u0442\u043A\u0430 \u0432\u043B\u0438\u044F\u0435\u0442
      \u043D\u0430 \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u0438 \u043D\u0430
      \u0442\u043E, \u0437\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u0433\u043E
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
