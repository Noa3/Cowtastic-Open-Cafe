      m_Items: []
  - m_Id: 1648740309233664
    m_Localized: "Uczyni\u0142e\u015B swojego barist\u0119 tak du\u017Cym, jak tylko
      mo\u017Ce!  Osi\u0105gn\u0105wszy sw\xF3j pe\u0142ny potencja\u0142, z rado\u015Bci\u0105
      do\u0142\u0105czy do Twojej mleczarni na pe\u0142ny etat, dodaj\u0105c do Twojego
      personelu kolejn\u0105 warto\u015Bciow\u0105 krow\u0119!"
    m_Metadata:
      m_Items: []
