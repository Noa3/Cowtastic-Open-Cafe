  - m_Id: 1650345817501696
    m_Localized: "\u041E\u0439!  \u0421\u0445\u043E\u0436\u0435, \u0442\u0438 \u0437\u0430\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0432
      \u0457\u0457 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0434\u0430\u043B\u0435\u043A\u043E. 
      \u0412\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438 \u0457\u0457
      \u0441\u0438\u0442\u043E\u044E \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E? 
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F\u043A\u0435\u0441\u044C
      \u0441\u043A\u043B\u0430\u0434\u043D\u0435 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432?\n\n\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
      \u0432\u043E\u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u044C\u0441\u044F,
      \u0449\u043E\u0431 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0449\u0435 \u0440\u0430\u0437, \u043A\u043E\u043B\u0438
      \u043E\u0445\u043E\u043B\u043E\u043D\u0435."
