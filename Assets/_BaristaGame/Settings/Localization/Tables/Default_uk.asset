  - m_Id: 175674851527249920
    m_Localized: "\u0417\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430 \u043C\u043E\u043B\u043E\u043A\u0430
      Barista."
    m_Metadata:
      m_Items: []
  - m_Id: 181788866099826688
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u0435.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u0435.;
      \u041F\u0440\u0438\u0432\u0456\u0442 \u0441\u043E\u043D\u044F\u0447\u043D\u0435
      \u0441\u0432\u0456\u0442\u043B\u043E.; \u0413\u0435\u0439, \u0442\u0438 \u0447\u0443\u0434\u043E\u0432\u043E
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0448.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u043C\u0438\u043B\u0430.; \u041F\u0440\u0438\u0432\u0456\u0442, \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u043E.;
      \u0413\u0435\u0439, \u043A\u0440\u0430\u0441\u0443\u043D\u044F.; \u041F\u0440\u0438\u0432\u0456\u0442
      \u043C\u0438\u043B\u0430\u0448\u043A\u0430.; \u0413\u0435\u0439, \u0434\u043E\u0431\u0440\u0435
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0448.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0447\u0430\u0440\u0456\u0432\u043D\u0456\u0441\u0442\u044C.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0430\u043D\u0433\u0435\u043B.; \u0413\u0435\u0439, \u043B\u044F\u043B\u044C\u043A\u043E.;
      \u041F\u0440\u0438\u0432\u0456\u0442 \u0434\u043E\u0440\u043E\u0433\u0430.;
      \u0413\u0435\u0439, \u0442\u0438 \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0448
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456.; \u041F\u0440\u0438\u0432\u0456\u0442
      \u0433\u0430\u0440\u043D\u0435\u043D\u044C\u043A\u0430.; \u0413\u0435\u0439,
      \u0434\u0438\u0442\u0438\u043D\u043A\u043E.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u043A\u0440\u0430\u0441\u0443\u043D\u044F.; \u0413\u0435\u0439, \u0433\u0430\u0440\u043D\u0430
      \u043F\u043E\u0441\u043C\u0456\u0448\u043A\u0430.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0447\u0430\u0440\u0456\u0432\u043D\u043E.; \u0413\u0435\u0439, \u0442\u0438
      \u0441\u043A\u0440\u0430\u0441\u0438\u0432 \u0431\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 181789087093510144
    m_Localized: "\u0413\u0435\u0439, \u043A\u0440\u0430\u0441\u0443\u043D\u0435,
      \u043C\u043E\u0436\u0435\u0448 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043C\u0456\u0439
      \u0434\u0435\u043D\u044C \u043A\u0440\u0430\u0449\u0438\u043C \u0443\u0441\u043C\u0456\u0448\u043A\u043E\u044E?;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u0435,
      \u0443 \u0447\u043E\u043C\u0443 \u0442\u0432\u0456\u0439 \u0441\u0435\u043A\u0440\u0435\u0442
      \u0442\u0430\u043A \u0434\u043E\u0431\u0440\u0435 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0442\u0438?;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u043E,
      \u0454 \u0448\u0430\u043D\u0441, \u0449\u043E \u0442\u0438 \u0432 \u043C\u0435\u043D\u044E?;
      \u0413\u0435\u0439, \u0433\u0430\u0440\u043D\u0435\u043D\u044C\u043A\u0430,
      \u043C\u0430\u0454\u0448 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439, \u044F\u043A\u0438\u0439 \u043F\u0430\u0441\u0443\u0432\u0430\u0442\u0438\u043C\u0435
      \u0434\u043E \u0442\u0432\u043E\u0454\u0457 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u043E\u0441\u0442\u0456?;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u0447\u0430\u0440\u0456\u0432\u043D\u0456\u0441\u0442\u044C,
      \u0442\u0432\u043E\u044F \u0443\u0441\u043C\u0456\u0448\u043A\u0430 - \u0446\u0435
      \u043D\u0430\u0439\u044F\u0441\u043A\u0440\u0430\u0432\u0456\u0448\u0430 \u043F\u043E\u0434\u0456\u044F
      \u043C\u043E\u0433\u043E \u0434\u043D\u044F.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0430\u043D\u0433\u0435\u043B\u0435, \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u0430
      \u043C\u043E\u0433\u043B\u0430 \u0431 \u043E\u0441\u0432\u0456\u0442\u0438\u0442\u0438
      \u043D\u0430\u0439\u0442\u0435\u043C\u043D\u0456\u0448\u0443 \u043A\u0456\u043C\u043D\u0430\u0442\u0443.;
      \u0413\u0435\u0439, \u043B\u044F\u043B\u044C\u043A\u043E, \u0443 \u0442\u0435\u0431\u0435
      \u0454 \u0447\u0430\u0440\u0456\u0432\u043D\u0435 \u0437\u0456\u043B\u043B\u044F
      \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0442\u043D\u044C\u043E\u0433\u043E
      \u0441\u0435\u0440\u0446\u044F?; \u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u0438\u043B\u0430,
      \u0442\u0438 \u0433\u043E\u0442\u0443\u0454\u0448 \u0443\u0441\u0456 \u043D\u0430\u043F\u043E\u0457
      \u0442\u0430\u043A\u0438\u043C\u0438 \u0436 \u0441\u043E\u043B\u043E\u0434\u043A\u0438\u043C\u0438,
      \u044F\u043A \u0442\u0438?; \u0413\u0435\u0439, \u0434\u0438\u0442\u0438\u043D\u043A\u043E,
      \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u0430 \u043F'\u044F\u043D\u0438\u0442\u044C.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u044F,
      \u0442\u0432\u043E\u044F \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
      \u0442\u0443\u0442 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 181789098002894848
    m_Localized: "\u0413\u0435\u0439, \u043A\u0440\u0430\u0441\u0443\u043D\u0435,
      \u0432\u0456\u0434 \u0442\u0432\u043E\u0454\u0457 \u043F\u043E\u0441\u043C\u0456\u0448\u043A\u0438
      \u0442\u0430 \u0446\u0438\u0445 \u0432\u0438\u0433\u0438\u043D\u0456\u0432
      \u043C\u043E\u0454 \u0441\u0435\u0440\u0446\u0435 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u044E\u0454\u0442\u044C\u0441\u044F.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u0435,
      \u0442\u0438 \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454\u0448 \u0449\u043E\u0441\u044C
      \u0442\u0430\u043A\u0435 \u0447\u0430\u0440\u0456\u0432\u043D\u0435, \u044F\u043A
      \u0442\u0432\u043E\u0457 \u043E\u0447\u0456?; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u0430,
      \u0442\u0432\u043E\u044F \u0444\u0456\u0433\u0443\u0440\u0430 \u0442\u0443\u0442
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F \u0441\u043F\u0440\u0430\u0432\u0430.;
      \u0413\u0435\u0439, \u0433\u0430\u0440\u043D\u0430 \u043B\u0435\u0434\u0456,
      \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0432\u0430\u0448\u0456\u0439 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u043E\u0441\u0442\u0456
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u043D\u0430\u043F\u0456\u0439
      \u043C\u043E\u0436\u0435 \u0431\u0443\u0442\u0438 \u0441\u043C\u0430\u0447\u043D\u0456\u0448\u0438\u043C.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u0447\u0430\u0440\u0456\u0432\u043D\u0456\u0441\u0442\u044C,
      \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u0430 \u043E\u0441\u0432\u0456\u0436\u0430\u0454
      \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439
      \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0430\u043D\u0433\u0435\u043B\u0435, \u0437 \u0442\u0430\u043A\u0438\u043C
      \u0442\u0456\u043B\u043E\u043C, \u044F\u043A \u0442\u0432\u043E\u0454, \u043A\u043E\u043C\u0443
      \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u043D\u0430\u043F\u0456\u0439?;
      \u0413\u0435\u0439, \u043B\u044F\u043B\u044C\u043A\u043E, \u0442\u0432\u043E\u0457
      \u0432\u0438\u0433\u0438\u043D\u0438 - \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u0435
      \u043F\u043E\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u043A\u0440\u0430\u0441\u0438.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u0438\u043B\u0430, \u0442\u0432\u043E\u044F
      \u0444\u0456\u0433\u0443\u0440\u0430 - \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0430
      \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u0446\u044C\u043E\u0433\u043E \u0431\u0430\u0440\u0443.;
      \u0413\u0435\u0439, \u043A\u0440\u0438\u0445\u0456\u0442\u043A\u043E, \u0432\u0456\u0434
      \u0442\u0432\u043E\u0433\u043E \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u043E\u0433\u043E
      \u0432\u0438\u0433\u043B\u044F\u0434\u0443 \u0432 \u043C\u0435\u043D\u0435
      \u043F\u0430\u043C\u043E\u0440\u043E\u0447\u0438\u0442\u044C\u0441\u044F \u0433\u043E\u043B\u043E\u0432\u0430.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043A\u0440\u0430\u0441\u0443\u043D\u044F,
      \u0442\u0432\u043E\u044F \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
      \u0440\u043E\u0431\u0438\u0442\u044C \u0432\u0441\u0435 \u0441\u043E\u043B\u043E\u0434\u0448\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 181789109562396672
    m_Localized: "\u0413\u0435\u0439, \u043A\u0440\u0430\u0441\u0443\u043D\u0435,
      \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \u0434\u043E\u0434\u0430\u0442\u0438
      \u0442\u0440\u043E\u0445\u0438 \u0441\u0432\u043E\u0454\u0457 \u043C\u0430\u0433\u0456\u0457
      \u0432 \u043C\u043E\u044E \u043A\u0430\u0432\u0443?; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u043A\u0440\u0430\u0441\u0443\u043D\u0435, \u0442\u0438 \u043F\u043E\u0434\u0430\u0454\u0448
      \u0449\u043E\u0441\u044C, \u043A\u0440\u0456\u043C \u043D\u0430\u043F\u043E\u0457\u0432
      \u0456\u0437 \u0442\u0430\u043A\u0438\u043C\u0438 \u0432\u0438\u0433\u0438\u043D\u0430\u043C\u0438?;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u043F\u0440\u0438\u0433\u043E\u043B\u043E\u043C\u0448\u043B\u0438\u0432\u043E,
      \u0442\u0432\u0456\u0439 \u0431\u044E\u0441\u0442 \u043C\u0456\u0433 \u0431\u0438
      \u0431\u0443\u0442\u0438 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u043E\u044E
      \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E \u043C\u043E\u0454\u0457 \u043A\u0430\u0432\u0438.;
      \u0413\u0435\u0439, \u043A\u0440\u0430\u0441\u0443\u043D\u044F, \u0442\u0438
      \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454\u0448 \u0449\u043E\u0441\u044C
      \u043F\u043E\u0437\u0430 \u043C\u0435\u043D\u044E, \u044F\u043A \u043F\u043E\u0441\u043C\u0456\u0448\u043A\u0443
      \u0447\u0438 \u043F\u043E\u0431\u0430\u0447\u0435\u043D\u043D\u044F?; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u0447\u0430\u0440\u0456\u0432\u043D\u0456\u0441\u0442\u044C, \u0437 \u0442\u0430\u043A\u0438\u043C
      \u0442\u0456\u043B\u043E\u043C, \u044F\u043A \u0443 \u0442\u0435\u0431\u0435,
      \u044F \u0431 \u0437\u0430\u043C\u043E\u0432\u0438\u0432 \u0449\u043E \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E.;
      \u041F\u0440\u0438\u0432\u0456\u0442, \u0430\u043D\u0433\u0435\u043B\u0435,
      \u0442\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u0430 - \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u0438\u0439
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442 \u0434\u043B\u044F
      \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E \u043D\u0430\u043F\u043E\u044E.;
      \u0413\u0435\u0439, \u043B\u044F\u043B\u044C\u043A\u043E, \u043C\u043E\u0436\u043D\u0430
      \u043C\u0435\u043D\u0456 \u0432\u0438\u043F\u0438\u0442\u0438 \u043A\u0430\u0432\u0438
      \u0437 \u0432\u0456\u0434\u0442\u0456\u043D\u043A\u043E\u043C \u0442\u0432\u043E\u0433\u043E
      \u0448\u0430\u0440\u043C\u0443?; \u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u0438\u043B\u0430,
      \u0442\u0432\u0456\u0439 \u0431\u044E\u0441\u0442 - \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u0434\u043D\u044F.;
      \u0413\u0435\u0439, \u043A\u0440\u0438\u0445\u0456\u0442\u043A\u043E, \u0442\u0432\u043E\u044F
      \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C \u0442\u0443\u0442
      \u0440\u043E\u0431\u0438\u0442\u044C \u043A\u043E\u0436\u0435\u043D \u043D\u0430\u043F\u0456\u0439
      \u043A\u0440\u0430\u0449\u0438\u043C.; \u041F\u0440\u0438\u0432\u0456\u0442,
      \u043A\u0440\u0430\u0441\u0443\u043D\u0435, \u0442\u0438 \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0454\u0448
      \u0443\u0441\u043C\u0456\u0448\u043A\u0443 \u0437 \u0442\u0430\u043A\u043E\u044E
      \u0447\u0443\u0434\u043E\u0432\u043E\u044E \u0444\u0456\u0433\u0443\u0440\u043E\u044E?"
    m_Metadata:
      m_Items: []
