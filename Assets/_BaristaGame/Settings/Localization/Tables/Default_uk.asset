  - m_Id: 134010572390375424
    m_Localized: "\u041E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 134010918655336448
    m_Localized: "\u0422\u0430\u043A\u043E\u0436 \u043D\u0430\u043C\u0430\u0433\u0430\u0439\u0442\u0435\u0441\u044F
      \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0454\u043C
      \u043A\u043B\u0456\u0454\u043D\u0442\u0430, \u043B\u044E\u0434\u044F\u043C
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F, \u043A\u043E\u043B\u0438
      \u0434\u0456\u0432\u0447\u0438\u043D\u0430 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0432\u0435\u043B\u0438\u043A\u043E\u044E \u0442\u0430 \u043F\u043E\u0432\u043D\u043E\u044E,
      \u0442\u043E\u043C\u0443 \u0432\u0440\u0430\u0436\u0430\u044E\u0447\u0438\u0439
      \u0431\u0430\u043B\u0430\u043D\u0441 \u0434\u043B\u044F \u0457\u0457 \u0440\u043E\u0437\u043C\u0456\u0440\u0443
      \u043C\u0430\u0454 \u043F\u0440\u0438\u0432\u0435\u0440\u043D\u0443\u0442\u0438
      \u0443\u0432\u0430\u0433\u0443 \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432
      \u0437 \u0447\u0430\u0441\u043E\u043C.\n\n\u0410\u043B\u0435 \u044F\u043A\u0438\u0439
      \u0441\u0435\u043D\u0441 \u0443 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u0438\u0445
      \u043A\u043B\u0456\u0454\u043D\u0442\u0430\u0445?  \u0429\u043E \u0436, \u0432\u043E\u043D\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u0445\u043E\u0442\u0456\u0442\u0438
      \u0449\u043E\u0441\u044C \u0431\u0456\u043B\u044C\u0448\u0435 \u0432 \u0441\u0432\u043E\u0454\u043C\u0443
      \u043D\u0430\u043F\u043E\u0457, \u044F\u043A\u0449\u043E \u0457\u0445\u043D\u0456\u0439
      \u043D\u0430\u0441\u0442\u0440\u0456\u0439 \u0446\u0435 \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454! 
      \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0439 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442,
      \u044F\u043A\u0438\u0439 \u043A\u043E\u0448\u0442\u0443\u0454 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0438\u0445
      \u0433\u0440\u043E\u0448\u0435\u0439...!"
    m_Metadata:
      m_Items: []
  - m_Id: 134011413927141376
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u043D\u043E\u0432\u0430\u043D\u0456
      \u043F\u043E\u0434\u0456\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 134011680659709952
    m_Localized: "\u0406\u043D\u043E\u0434\u0456 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0433\u0440\u0438 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u2019\u044F\u0432\u043B\u044F\u0442\u0438\u0441\u044F
      \u043F\u043E\u0434\u0456\u0457, \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456
      \u043D\u0430 \u0447\u0430\u0441.\n\n\u0414\u0435\u044F\u043A\u0456 \u0437 \u0446\u0438\u0445
      \u043F\u043E\u0434\u0456\u0439 \u0434\u043E\u0434\u0430\u044E\u0442\u044C \u0432\u0438\u043A\u043B\u0438\u043A\u0456\u0432,
      \u0434\u0435\u044F\u043A\u0456 \u0434\u0430\u044E\u0442\u044C \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0443
      \u043F\u0435\u0440\u0435\u0440\u0432\u0443, \u0430 \u0434\u0435\u044F\u043A\u0456
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0440\u043E\u0445\u0438 \u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u0456.\n\u0421\u043B\u0456\u0434\u043A\u0443\u0439\u0442\u0435
      \u0437\u0430 \u043F\u043E\u0434\u0456\u044F\u043C\u0438, \u044F\u043A\u0456
      \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u044E\u0442\u044C\u0441\u044F, \u0456
      \u043D\u0430\u043C\u0430\u0433\u0430\u0439\u0442\u0435\u0441\u044F \u043D\u0435
      \u0437\u0430\u0441\u0442\u0430\u0442\u0438 \u0457\u0445 \u0437\u043D\u0435\u043D\u0430\u0446\u044C\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 134179468267331584
    m_Localized: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0433\u0440\u0438 \u0432
      \u0430\u0440\u043A\u0430\u0434\u043D\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456
      \u043A\u043D\u043E\u043F\u043A\u0430 \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F
      \u2013 \u0446\u0435 \u043C\u0456\u0441\u0446\u0435, \u0434\u0435 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0456
      \u0432\u0441\u0456 \u0432\u0430\u0448\u0456 \u043E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0442\u0430 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0434\u043B\u044F \u0432\u0430\u0448\u043E\u0433\u043E \u0431\u0430\u0440\u0438\u0441\u0442\u0430. 
      \u0417\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F \u0457\u0457 \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0441\u0442\u0456
      \u0442\u0430 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456
      \u043C\u043E\u0436\u043D\u0430 \u0437\u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u043C. 
      \u0420\u0430\u0437\u043E\u043C \u0456\u0437 \u0437\u0430\u0441\u043E\u0431\u0430\u043C\u0438
      \u0434\u043B\u044F \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F
      \u043D\u0430\u0441\u0442\u0440\u043E\u044E.\n\n\u0412\u0456\u043D \u0442\u0430\u043A\u043E\u0436
      \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u043C\u0435\u043D\u044E \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0437 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u043C\u0438 \u043E\u0434\u044F\u0433\u0443
      \u0442\u0430 \u043A\u043E\u043B\u044C\u043E\u0440\u0456\u0432.\n\u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0442\u0438
      \u0434\u0435\u044F\u043A\u0456 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438
      \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
