  - m_Id: 175650030386958336
    m_Localized: "\u041D\u043E\u0432\u0430 \u0440\u043E\u0431\u043E\u0442\u0430,
      \u043D\u043E\u0432\u0435 \u0436\u0438\u0442\u0442\u044F.@Intro_NewJobNewLife;
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0449\u043E
      \u043B\u044E\u0434\u0438 \u0442\u0443\u0442 \u0434\u043E\u0431\u0440\u0456.@Intro_IHopePeopleAreNice;
      \u041D\u0435 \u043C\u043E\u0436\u0443 \u0434\u043E\u0447\u0435\u043A\u0430\u0442\u0438\u0441\u044F,
      \u0449\u043E\u0431 \u043F\u043E\u0447\u0430\u0442\u0438!@Intro_ICantWaitToStart;
      \u041F\u0435\u0440\u0448\u0438\u0439 \u0434\u0435\u043D\u044C \u043D\u0430
      \u0440\u043E\u0431\u043E\u0442\u0456.@Intro_FirstDayOnTheJob"
    m_Metadata:
      m_Items: []
  - m_Id: 175651777658507264
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442!; \u041F\u0440\u0438\u0432\u0456\u0442!;
      \u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E!;
      \u0427\u0438 \u043C\u043E\u0436\u0443 \u044F \u0432\u0430\u043C \u0449\u043E\u0441\u044C
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?; \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u0438\u0439?;
      \u0427\u0438\u043C \u044F \u043C\u043E\u0436\u0443 \u0412\u0430\u043C \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438?;
      \u0429\u043E \u044F \u043C\u043E\u0436\u0443 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438?;
      \u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E!
      \u0429\u043E \u044F \u043C\u043E\u0436\u0443 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
      \u0432\u0430\u043C \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456?; \u0412\u0438
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0434\u043E\u0431\u0440\u0435
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435! \u0429\u043E
      \u044F \u043C\u043E\u0436\u0443 \u0432\u0430\u043C \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?;
      \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456\u0448\u043D\u044F \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0430
      \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044F: \u0441\u0432\u0456\u0436\u0435
      \u043C\u043E\u043B\u043E\u043A\u043E!; \u0412\u0438 \u0432\u0436\u0435 \u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0438
      \u043C\u043E\u043B\u043E\u043A\u043E \u0411\u043E\u0431\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 175662100285247488
    m_Localized: "\u042F \u0445\u043E\u0447\u0443 \u0446\u0435 \u043F\u0435\u0447\u0438\u0432\u043E!;
      \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454
      \u0441\u043C\u0430\u0447\u043D\u0438\u043C.; \u0426\u0456\u043A\u0430\u0432\u043E,
      \u044F\u043A\u0435 \u0446\u0435 \u043F\u0435\u0447\u0438\u0432\u043E \u043D\u0430
      \u0441\u043C\u0430\u043A...?; \u0426\u0456\u043A\u0430\u0432\u043E, \u0447\u0438
      \u0432\u0441\u0435 \u043F\u0435\u0447\u0438\u0432\u043E \u043F\u043E\u043C\u0456\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0440\u043E\u0442?; \u041A\u043E\u043B\u0438 \u044F \u043E\u0442\u0440\u0438\u043C\u0430\u044E
      \u0447\u0430\u0440\u0456\u0432\u043D\u0435 \u043F\u0435\u0447\u0438\u0432\u043E?;
      \u0426\u044F \u0440\u043E\u0431\u043E\u0442\u0430 \u043E\u0431\u0456\u0446\u044F\u043B\u0430
      \u043F\u0435\u0432\u043D\u0456 \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0438,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?; \u042F \u0445\u043E\u0447\u0443
      \u0440\u043E\u0441\u0442\u0438...; Cookie craving incoming!; \u0421\u043F\u043E\u0432\u0456\u0449\u0435\u043D\u043D\u044F
      \u043F\u0440\u043E \u0444\u0430\u0439\u043B\u0438 cookie! \u041F\u043E\u0432\u0442\u043E\u0440\u044E\u044E,
      \u0441\u043F\u043E\u0432\u0456\u0449\u0435\u043D\u043D\u044F \u043F\u0440\u043E
      \u0444\u0430\u0439\u043B\u0438 cookie!; \u042F \u043C\u0430\u044E \u043E\u0447\u0456
      \u043D\u0430 \u0442\u043E\u043C\u0443 \u043F\u0435\u0447\u0438\u0432\u0456!;
      \u0427\u0430\u0441 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0438\u0442\u0438
      \u043C\u043E\u044E \u0442\u044F\u0433\u0443 \u0434\u043E \u043F\u0435\u0447\u0438\u0432\u0430!;
      Cookie \u043C\u0456\u0441\u0456\u044F: \u0410\u043A\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438!;
      \u0420\u0430\u0434\u0430\u0440 cookie \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E!;
      \u041F\u0440\u043E\u043C\u0456\u043D\u044F\u044E \u043A\u0430\u0432\u0443 \u043D\u0430
      \u043F\u0435\u0447\u0438\u0432\u043E!; \u041F\u0435\u0447\u0438\u0432\u043E
      \u0447\u0438 \u043D\u0456? \u041E\u0441\u044C \u0443 \u0447\u043E\u043C\u0443
      \u043F\u0438\u0442\u0430\u043D\u043D\u044F.; \u041E\u043F\u0456\u0440 \u043C\u0430\u0440\u043D\u0438\u0439...
      \u043A\u043E\u043B\u0438 \u0439\u0434\u0435\u0442\u044C\u0441\u044F \u043F\u0440\u043E
      \u043F\u0435\u0447\u0438\u0432\u043E!; \u0422\u044F\u0433\u0430 \u0434\u043E
      \u043F\u0435\u0447\u0438\u0432\u0430: 100% \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F
      \u0433\u0430\u0440\u0430\u043D\u0442\u043E\u0432\u0430\u043D\u043E!; \u0427\u0430\u0441
      \u043F\u0435\u0447\u0438\u0432\u0430 - \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
      \u0447\u0430\u0441!; \u0417 \u0446\u044C\u043E\u0433\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0456
      \u043F\u0435\u0447\u0438\u0432\u043E \u043C\u0440\u0456\u0457!; \u0420\u0456\u0432\u0435\u043D\u044C
      \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F \u0444\u0430\u0439\u043B\u0456\u0432
      cookie: \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0438\u0439!;
      \u041C\u0456\u0439 \u043B\u0430\u0441\u0443\u043D \u0445\u043E\u0447\u0435
      \u0446\u0435 \u043F\u0435\u0447\u0438\u0432\u043E!; \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E
      \u043A\u043B\u0438\u0447\u0435 \u043C\u043E\u0454 \u0456\u043C'\u044F!; \u0423
      \u043C\u0435\u043D\u0435 \u0454\u0434\u0438\u043D\u0438\u0439 \u0440\u043E\u0437\u0443\u043C...
      \u0456 \u0446\u0435 \u043D\u0430 \u0442\u043E\u043C\u0443 \u043F\u0435\u0447\u0438\u0432\u0456!;
      \u041E\u0434\u0435\u0440\u0436\u0438\u043C\u0456\u0441\u0442\u044C \u043F\u0435\u0447\u0438\u0432\u043E\u043C:
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E!; \u0412\u0441\u0435,
      \u0449\u043E \u044F \u0437\u0430\u0440\u0430\u0437 \u0445\u043E\u0447\u0443,
      \u0446\u0435 \u043F\u0435\u0447\u0438\u0432\u043E!; \u041E\u0434\u0438\u043D
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043A\u0440\u043E\u043A
      \u0434\u043B\u044F \u0431\u0430\u0440\u0438\u0441\u0442\u0430, \u043E\u0434\u0438\u043D
      \u0433\u0456\u0433\u0430\u043D\u0442\u0441\u044C\u043A\u0438\u0439 \u0441\u0442\u0440\u0438\u0431\u043E\u043A
      \u0434\u043B\u044F \u043F\u0435\u0447\u0438\u0432\u0430!; \u0422\u044F\u0433\u0430
      \u0434\u043E \u043F\u0435\u0447\u0438\u0432\u0430: \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u043D\u043D\u044F
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F!; \u042F \u0437\u043D\u0430\u044E, \u0449\u043E
      \u0442\u0438 \u043C\u0430\u0454\u0448 \u0434\u043B\u044F \u043C\u0435\u043D\u0435
      \u043C\u0430\u0433\u0456\u044E~"
    m_Metadata:
      m_Items: []
  - m_Id: 175662781700263936
    m_Localized: "\u041C\u043C\u043C! \u0421\u043C\u0430\u0447\u043D\u043E!~; \u0429\u043E\u0441\u044C
      \u0456\u043D\u0448\u0435...?; \u042F \u0445\u043E\u0447\u0443 \u0431\u0456\u043B\u044C\u0448\u0435!;
      \u041D\u0430 \u0441\u043C\u0430\u043A \u043C\u043E\u043B\u043E\u043A\u043E!;
      \u0422\u0435\u043F\u0435\u0440 \u043C\u0438 \u0447\u043E\u0433\u043E\u0441\u044C
      \u0434\u043E\u0441\u044F\u0433\u0430\u0454\u043C\u043E!; \u0412\u0430\u0443,
      \u0446\u0435 \u0447\u0443\u0434\u043E\u0432\u043E!; \u042F \u0431 \u0445\u043E\u0442\u0456\u0432,
      \u0449\u043E\u0431 \u0443 \u043D\u0430\u0441 \u0431\u0443\u043B\u043E \u0431\u0456\u043B\u044C\u0448\u0435
      \u0442\u0430\u043A\u0438\u0445.; \u041A\u0432\u0435\u0441\u0442 \u043F\u0435\u0447\u0438\u0432\u0430
      \u0431\u0443\u0432 \u0442\u043E\u0433\u043E \u0432\u0430\u0440\u0442\u0438\u0439!
      \u0421\u043C\u0430\u0447\u043D\u043E\u0433\u043E!; \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E
      \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u043E \u0432 \u0442\u043E\u0447\u043A\u0443!
      \u0411\u0456\u043B\u044C\u0448\u0435 \u0431\u0443\u0434\u044C\u043B\u0430\u0441\u043A\u0430!;
      \u041F\u0435\u0447\u0438\u0432\u043E \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043E!;
      \u042F \u0437\u0430\u0440\u0430\u0437 \u0443 \u0440\u0430\u044E \u043F\u0435\u0447\u0438\u0432\u0430!;
      \u041C\u043C\u043C! \u041D\u0430\u0439\u043A\u0440\u0430\u0449\u0435 \u0440\u0456\u0448\u0435\u043D\u043D\u044F!;
      \u041F\u0435\u0447\u0438\u0432\u043E \u0431\u043B\u0430\u0436\u0435\u043D\u0441\u0442\u0432\u043E!
      \u041D\u0435 \u043C\u043E\u0436\u0443 \u043D\u0430\u0441\u0438\u0442\u0438\u0442\u0438\u0441\u044F!;
      \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E \u0437\u043C\u0456\u043D\u044E\u0454
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0433\u0440\u0438!; \u041C\u0430\u0433\u0456\u044F
      \u043F\u0435\u0447\u0438\u0432\u0430 \u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0456!
      \u042F \u043B\u044E\u0431\u043B\u044E \u0439\u043E\u0433\u043E!; \u0425\u0442\u043E
      \u0437\u043D\u0430\u0432, \u0449\u043E \u043E\u0434\u043D\u0435 \u043F\u0435\u0447\u0438\u0432\u043E
      \u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0440\u0430\u0434\u043E\u0441\u0442\u0456?; \u0422\u0435\u043F\u0435\u0440
      \u0446\u0435 \u0442\u0435, \u0449\u043E \u044F \u043D\u0430\u0437\u0438\u0432\u0430\u044E
      \u0448\u0435\u0434\u0435\u0432\u0440\u043E\u043C \u043F\u0435\u0447\u0438\u0432\u0430!;
      \u041F\u0435\u0447\u0438\u0432\u043D\u0438\u0439 \u0440\u0430\u0439 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E!;
      \u0421\u043C\u0430\u043A \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0438...
      \u0456 \u043F\u0435\u0447\u0438\u0432\u043E!; \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E
      \u0437\u0430\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0454 \u043D\u0430 \u0437\u043E\u043B\u043E\u0442\u0443
      \u043C\u0435\u0434\u0430\u043B\u044C!; \u042F \u043D\u0430 \u0445\u0432\u0438\u043B\u0456
      \u0434\u0435\u0432'\u044F\u0442\u043E\u0457 \u0437 \u0446\u0438\u043C \u043F\u0435\u0447\u0438\u0432\u043E\u043C!;
      \u041C\u043E\u043B\u043E\u043A\u043E \u0442\u0430 \u043F\u0435\u0447\u0438\u0432\u043E,
      \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u0435 \u043F\u043E\u0454\u0434\u043D\u0430\u043D\u043D\u044F!;
      \u041E\u0434\u0438\u043D \u0443\u043A\u0443\u0441, \u0456 \u044F \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0432\u0441\u044F!
      \u0411\u0456\u043B\u044C\u0448\u0435 \u0431\u0443\u0434\u044C\u043B\u0430\u0441\u043A\u0430!;
      \u0414\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0456\u0441\u0442\u044C \u043F\u0435\u0447\u0438\u0432\u0430
      \u0434\u043E\u0441\u044F\u0433\u043D\u0443\u0442\u0430!; \u0427\u0430\u0440\u0456\u0432\u043D\u0435
      \u043F\u0435\u0447\u0438\u0432\u043E \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u043E!
      \u041D\u0435 \u043C\u043E\u0436\u0443 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u0438
      \u0457\u0441\u0442\u0438!; \u0426\u0435 \u043F\u0435\u0447\u0438\u0432\u043E
      - \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F \u0441\u043C\u0430\u043A\u0443!;
      \u041C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D \u0434\u043E\u0432\u0456\u0447\u043D\u0438\u0439
      \u0437\u0430\u043F\u0430\u0441 \u0446\u044C\u043E\u0433\u043E \u043F\u0435\u0447\u0438\u0432\u0430!;
      \u041C\u043E\u043D\u043A \u041C\u0443\u043D\u043A"
