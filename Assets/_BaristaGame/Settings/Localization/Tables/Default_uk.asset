  - m_Id: 549769167859712
    m_Localized: "\u041A\u0443\u043F\u0443\u0439\u0442\u0435 \u043A\u0430\u0440\u0430\u043C\u0435\u043B\u044C\u043D\u0438\u0439
      \u0441\u043E\u0443\u0441 \u0437\u0430 25 \u0434\u043E\u043B\u0430\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 549811962343424
    m_Localized: "\u043A\u0430\u0440\u0430\u043C\u0435\u043B\u044C\u043D\u0438\u0439
      \u0441\u043E\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1683534711713792
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u043E\u043B\u043E\u0447\u043D\u0430
      \u0444\u0435\u0440\u043C\u0430 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
      \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \xAB\u043A\u043E\u0440\u043E\u0432\u2019\u044F\u0447\u0435
      \u043A\u0430\u0444\u0435\xBB, \u0449\u043E\u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0437 \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u043C,
      \u0430 \u043A\u0440\u0456\u043C \u0442\u043E\u0433\u043E, \u0446\u0435 \u0442\u0430\u043A\u043E\u0436
      \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0447\u0443\u0434\u043E\u0432\u0438\u043C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u0434\u0430\u0442\u0438 \u043D\u043E\u0432\u0438\u043C
      \u0434\u0456\u0432\u0447\u0430\u0442\u0430\u043C-\u043A\u043E\u0440\u043E\u0432\u0430\u043C
      \u0447\u0438\u043C \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F,
      \u043F\u043E\u043A\u0438 \u0432\u0438 \u0433\u043E\u0442\u0443\u0454\u0442\u0435
      \u0457\u0445 \u0434\u043E \u043C\u043E\u043B\u043E\u0447\u043D\u0438\u0445
      \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u0456\u0432.\n\n\u0412\u0430\u0448
      \u043F\u0435\u0440\u0448\u0438\u0439 \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u0437 \u0440\u0430\u0434\u0456\u0441\u0442\u044E \u0440\u043E\u0437\u043F\u043E\u0447\u0438\u043D\u0430\u0454
      \u0440\u043E\u0431\u043E\u0442\u0443 \u0442\u0430, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0441\u043F\u043E\u0432\u043D\u0435\u043D\u0438\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B\u0443.
      \u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C \u0457\u0439 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432, \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
      \u0440\u043E\u0437\u0432\u0438\u0432\u0430\u044E\u0447\u0438 \u0457\u0457 \u043F\u043E\u0432\u043D\u0443
      \u043C\u043E\u043B\u043E\u0447\u043D\u0443 \u0441\u0438\u043B\u0443!\n\n\u041A\u0430\u0444\u0435
      \u043D\u043E\u0432\u0435, \u0442\u043E\u043C\u0443 \u0432\u0430\u043C \u0442\u0430\u043A\u043E\u0436
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435 \u043A\u0443\u043F\u0443\u0432\u0430\u0442\u0438
      \u043D\u043E\u0432\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438
      \u043F\u043E \u0434\u043E\u0440\u043E\u0437\u0456.\n\u041D\u0430 \u0449\u0430\u0441\u0442\u044F,
      \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0449\u043E \u0442\u0443\u0442\u0435\u0448\u043D\u0456
      \u043A\u043B\u0456\u0454\u043D\u0442\u0438 \u0434\u0443\u0436\u0435 \u0441\u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043B\u0438\u0432\u0456
      \u0434\u043E \u0456\u0434\u0435\u0457 \u0434\u043E\u043F\u043B\u0430\u0447\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430 \u0441\u0432\u0456\u0436\u0435 \u043C\u043E\u043B\u043E\u043A\u043E
      \u043D\u0430 \u0432\u0438\u043C\u043E\u0433\u0443, \u044F\u043A\u0449\u043E
      \u0432\u043E\u043D\u0438 \u0432 \u043D\u0430\u043B\u0435\u0436\u043D\u043E\u043C\u0443
      \u043D\u0430\u0441\u0442\u0440\u043E\u0457.\n\n\u042F\u043A\u0449\u043E \u0432\u0430\u043C
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0433\u0440\u0438, \u0454 \u0441\u043F\u043B\u0438\u0432\u0430\u044E\u0447\u0456
      \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0438 \u043F\u0440\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u043D\u0456
      \u043A\u0443\u0440\u0441\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1683396865912832
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
      \u0434\u043E Cowtastic Cafe!"
    m_Metadata:
      m_Items: []
  - m_Id: 1684540275126272
    m_Localized: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u043E\u0431\u0456
      \u0432\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F
      \u0432\u0434\u043E\u043C\u0430 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456,
      \u0432\u0441\u0435 \u043A\u0430\u0444\u0435 \u0432 \u0445\u0430\u043E\u0441\u0456,
      \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0442\u0443\u0442 \u043A\u043E\u0457\u0442\u044C\u0441\u044F
      \u0432\u0441\u044F\u043A\u0435 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0435! 
      \u0429\u043E \u0446\u0435 \u0437\u0430 \u0446\u0456\u043D\u0438?  \u0427\u043E\u043C\u0443
      \u0432\u0441\u0456 \u0446\u0456 \u0440\u0435\u0447\u0456 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u044E\u0442\u044C\u0441\u044F
      \u0449\u043E\u0440\u0430\u0437\u0443, \u043A\u043E\u043B\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C
      \u043A\u043B\u0456\u0454\u043D\u0442?\n\n\u041F\u0440\u0438\u0432\u0456\u0442,
      \u0441\u0445\u043E\u0436\u0435, \u0442\u0438 \u0437\u043D\u0430\u0439\u0448\u043E\u0432
      \u043D\u0430\u0448\u0443 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443 \u043F\u0430\u0441\u0445\u0430\u043B\u044C\u043A\u0443.
      \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448
      \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u043F\u043E\u0433\u0440\u0430\u0442\u0438
      \u0432 \u0456\u043D\u0448\u0438\u0439 \u0440\u0435\u0436\u0438\u043C, \u044F\u043A\u0449\u043E
      \u044F\u043A\u043E\u0441\u044C \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0446\u0435
      \u0437 \u043F\u0435\u0440\u0448\u043E\u0457 \u0441\u043F\u0440\u043E\u0431\u0438.\n\n\u0412\u0430\u043C
      \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0431\u0430\u0433\u0430\u0442\u043E
      \u0437\u043D\u0430\u043D\u044C \u043F\u0440\u043E \u0442\u0435, \u044F\u043A
      \u043F\u0440\u0430\u0446\u044E\u0454 \u0433\u0440\u0430, \u0449\u043E\u0431
      \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438 \u0446\u0435\u0439 \u0445\u0430\u043E\u0441,
      \u0447\u0438 \u043D\u0456... \u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
      \u0446\u0435 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043C\u043E\u0436\u043D\u0430
      \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0442\u0438?  \u0422\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u0438\u043D \u0441\u043F\u043E\u0441\u0456\u0431 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F.\n\n\u0422\u0430\u043A\u043E\u0436
      \u0434\u044F\u043A\u0443\u044E \u0437\u0430 \u0433\u0440\u0443!"
    m_Metadata:
      m_Items: []
