  - m_Id: 134180089527640064
    m_Localized: "\u041F\u0456\u0434\u0440\u0443\u0447\u043D\u0438\u043A \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 134180290938118144
    m_Localized: "\u0426\u0435 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0432\u0441\u044F
      \u0432\u0430\u0436\u043B\u0438\u0432\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u044F\u043A\u0443 \u0432\u0430\u0440\u0442\u043E \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u0438.\n\u0406\u0433\u0440\u043E\u0432\u0438\u0439
      \u0446\u0438\u043A\u043B \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438\u043C:
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0439\u0442\u0435 \u043D\u0430\u043F\u043E\u0457,
      \u0437\u0430\u0440\u043E\u0431\u0456\u0442\u044C \u0433\u0440\u043E\u0448\u0456,
      \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0439\u0442\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043D\u0430\u043F\u043E\u0457\u0432, \u0437\u0440\u043E\u0431\u0456\u0442\u044C
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u0431\u0456\u043B\u044C\u0448\u0438\u043C,
      \u0437\u0430\u0440\u043E\u0431\u0456\u0442\u044C \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0433\u0440\u043E\u0448\u0435\u0439, \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u0439\u0442\u0435
      \u0434\u043E \u043C\u0438\u0447\u0430\u043D\u043D\u044F.\n\n\u042F\u043A\u0449\u043E
      \u0432\u0438 \u0445\u043E\u0447\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0432\u0438\u043A\u043B\u0438\u043A, \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0437\u043D\u0430\u0439\u0442\u0438 \u0440\u043E\u0437\u0443\u043C\u043D\u0456
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0430\u0431\u043E \u043E\u043D\u043E\u0432\u0438\u0442\u0438
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439 \u0447\u0430\u0441. 
      \u042F\u043A\u0449\u043E \u0432\u0438 \u0445\u043E\u0447\u0435\u0442\u0435
      \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F, \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0442\u0438 \u0434\u0435\u044F\u043A\u0456
      \u0456\u043D\u0448\u0456 \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438 \u043E\u0434\u044F\u0433\u0443! 
      \u0423 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443
      \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044F
      \u043A\u0430\u0432\u043E\u044E \u0437 \u043C\u043E\u043B\u043E\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
