  - m_Id: 132865470217428992
    m_Localized: "\u0427\u0430\u0441 \u0433\u0440\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 1677955096211456
    m_Localized: "\u0411\u0430\u0440\u0438\u0441\u0442\u0430 \u0432\u0442\u0440\u0430\u0447\u0430\u0454
      \u0449\u0430\u0441\u0442\u044F \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 231146272419840
    m_Localized: "\u041F\u0456\u0434\u0440\u0443\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 133992199195566080
    m_Localized: "\u041D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0448\u0438
      \u043D\u043E\u0432\u0435 \u043A\u0430\u0444\u0435 \u0442\u0430 \u043D\u0430\u0439\u043D\u044F\u0432\u0448\u0438
      \u0446\u044E \u0441\u0432\u0456\u0436\u0443 \u0434\u0456\u0432\u0447\u0438\u043D\u0443-\u043A\u043E\u0440\u043E\u0432\u0443
      \u0441\u0432\u043E\u0457\u043C \u043F\u0435\u0440\u0448\u0438\u043C \u0431\u0430\u0440\u0438\u0441\u0442\u0430
      \u0442\u0443\u0442, \u0432\u0430\u0448\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F
      \u043F\u043E\u043B\u044F\u0433\u0430\u0454 \u0432 \u0442\u043E\u043C\u0443,
      \u0449\u043E\u0431 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0432\u0430\u0448\u043E\u043C\u0443
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432, \u043F\u0456\u043A\u043B\u0443\u044E\u0447\u0438\u0441\u044C,
      \u0449\u043E\u0431 \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u0430. 
      \u0412\u0430\u0436\u043B\u0438\u0432\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0442\u0438\u0441\u044F,
      \u0449\u043E \u0432\u043E\u043D\u0430 \u043D\u0435 \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u044C\u0441\u044F,
      \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432\u043E\u043D\u0430,
      \u0441\u0445\u043E\u0436\u0435, \u0437\u0430\u0446\u0456\u043A\u0430\u0432\u043B\u0435\u043D\u0430
      \u200B\u200B\u0432 \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u0456
      \u043D\u0430 \u0431\u0456\u043B\u044C\u0448 \u043C\u043E\u043B\u043E\u0447\u043D\u0443
      \u043F\u043E\u0441\u0430\u0434\u0443 \u043D\u0430 \u0432\u0430\u0448\u0456\u0439
      \u0444\u0435\u0440\u043C\u0456, \u043A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435
      \u0433\u043E\u0442\u043E\u0432\u0430 \u0434\u043E \u0446\u044C\u043E\u0433\u043E.\n\n\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u043C\u043E\u0441\u044C,
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u043F\u0456\u0434\u0440\u0443\u0447\u043D\u0438\u043A\u0443, \u044F\u043A\u0449\u043E
      \u0449\u043E\u0441\u044C \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u043D\u0435\u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438\u043C
      \u0449\u043E\u0434\u043E \u0456\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0443. 
      \u0412 \u0456\u043D\u0448\u043E\u043C\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443
      \u0432\u0438 \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u0440\u0430\u0437\u0443
      \u0436 \u043F\u043E\u0447\u0430\u0442\u0438 \u0432\u0438\u0432\u0447\u0430\u0442\u0438
      \u0433\u0440\u0443 \u043C\u0435\u0442\u043E\u0434\u043E\u043C \u043F\u0440\u043E\u0431
      \u0456 \u043F\u043E\u043C\u0438\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 133993158466445312
    m_Localized: "\u041C\u0438\u0448\u0430 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
      \u0432\u0441\u0456\u043C, \u0449\u043E \u0432\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0434\u043B\u044F \u0433\u0440\u0438, \u0436\u043E\u0434\u043D\u0438\u0445
      \u0456\u043D\u0448\u0438\u0445 \u043A\u043D\u043E\u043F\u043E\u043A \u043D\u0435
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E.\n\n\u042F\u043A\u0449\u043E
      \u0434\u043B\u044F \u0447\u043E\u0433\u043E\u0441\u044C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F,
      \u0443 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456
      \u0454 \u0441\u043F\u043B\u0438\u0432\u0430\u044E\u0447\u0456 \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0438,
      \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0456 \u043A\u0443\u0440\u0441\u043E\u0440\u043E\u043C,
      \u044F\u043A\u0456 \u043D\u0430\u0434\u0430\u044E\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u043E\u0440\u0438\u0441\u043D\u043E\u0457 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457.\n\u041C\u043E\u0436\u043B\u0438\u0432\u043E,
      \u0432\u0438 \u0437\u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F
      \u0437 \u0431\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044E \u043C\u0435\u0445\u0430\u043D\u0456\u0437\u043C\u0456\u0432
      \u043B\u0438\u0448\u0435 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0438.\n\n(\u0421\u0435\u043D\u0441\u043E\u0440\u043D\u0435
      \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u043B\u043E\u0441\u044F,
      \u0430\u043B\u0435 \u044F\u043A\u0449\u043E \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435
      \u0446\u0435 \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456,
      \u044F \u0434\u0443\u043C\u0430\u044E, \u0449\u043E \u0432\u043E\u043D\u043E
      \u043C\u0430\u0454 \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E
      \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438?)"
    m_Metadata:
      m_Items: []
  - m_Id: 133995531494596608
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0438\u043C \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F\u043C
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0433\u0440\u0438 \u0454 \u0437\u043C\u0456\u0448\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0430\u043F\u043E\u0457\u0432.\n\n\u041A\u043E\u0436\u0435\u043D \u043A\u043B\u0456\u0454\u043D\u0442
      \u043C\u0430\u0454 \u043F\u043E\u0440\u0442\u0440\u0435\u0442, \u044F\u043A\u0438\u0439
      \u043F\u043E\u043A\u0430\u0437\u0443\u0454 \u0439\u043E\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u0456\u0439,
      \u0456 \u0437\u0430\u043F\u0438\u0442\u0443\u0454 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F,
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0435 \u0446\u0456\u0454\u044E
      \u0433\u0440\u0430\u0444\u0456\u043A\u043E\u044E.\n\n\u0417\u0432\u0435\u0440\u043D\u0456\u0442\u044C
      \u043F\u0438\u043B\u044C\u043D\u0443 \u0443\u0432\u0430\u0433\u0443 \u043D\u0430
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0430 \u0442\u0430
      \u043D\u0430 \u0442\u0435, \u044F\u043A\u0456 \u0434\u043E\u0431\u0430\u0432\u043A\u0438
      \u0432\u043E\u043D\u0438 \u0445\u043E\u0447\u0443\u0442\u044C \u0434\u043E\u0434\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 133996458540638208
    m_Localized: "\u041E\u0441\u044C \u0432\u0430\u0448\u0456 \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438. 
      \u041F\u0456\u0434 \u0447\u0430\u0441 \u0433\u0440\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0456 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435,
      \u0449\u043E\u0431 \u043F\u043E\u0447\u0430\u0442\u0438 \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0432\u0430\u0442\u0438
      \u0447\u0430\u0448\u043A\u0443, \u0430\u0431\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0434\u043B\u044F \u043F\u0435\u0432\u043D\u0438\u0445
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432, \u0449\u043E\u0431
      \u0434\u043E\u0434\u0430\u0442\u0438 \u0457\u0445 \u0434\u043E \u043D\u0430\u043F\u043E\u044E.\n\n\u0412\u0430\u0448\u0435
      \u043A\u0430\u0444\u0435 \u0449\u043E\u0439\u043D\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u043B\u043E\u0441\u044F,
      \u0456 \u0439\u043E\u043C\u0443 \u0432\u0441\u0435 \u0449\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u0430\u043F\u0430\u0441\u0442\u0438\u0441\u044F \u043A\u0456\u043B\u044C\u043A\u043E\u043C\u0430
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0430\u043C\u0438. 
      \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0437\u0430\u0440\u043E\u0431\u0438\u0442\u0438
      \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E, \u0449\u043E\u0431
      \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0442\u0438 \u0457\u0445
      \u0443\u0441\u0456\u0445.\n\n\u041A\u0443\u043F\u0456\u0432\u043B\u044F \u043D\u043E\u0432\u0438\u0445
      \u0456\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0456\u0432 \u0432\u0430\u0436\u043B\u0438\u0432\u0430
      \u0434\u043B\u044F \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0431\u0456\u043B\u044C\u0448\u0438\u0445
      \u0433\u0440\u043E\u0448\u0435\u0439, \u0447\u0438\u043C \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0438\u0439
      \u043D\u0430\u043F\u0456\u0439, \u0442\u0438\u043C \u0432\u0438\u0449\u0430
      \u0439\u043E\u0433\u043E \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 133997655410450432
    m_Localized: "\u0426\u0435 \u0447\u0430\u0448\u043A\u0430, \u044F\u043A\u0443
      \u0432\u0438 \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0454\u0442\u0435 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0433\u043E \u043A\u043B\u0456\u0454\u043D\u0442\u0430.
      \u041F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0430\u043F\u043E\u0457\u0432 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u043B\u0456\u043D\u0456\u0457 \u043D\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F,
      \u0449\u043E\u0431 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u0442\u0438,
      \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432\u0430\u0448 \u043D\u0430\u043F\u0456\u0439
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u0437\u0430\u043F\u0438\u0442\u0443
      \u043A\u043B\u0456\u0454\u043D\u0442\u0430.\n\n\u0422\u043E\u0447\u043D\u0456\u0441\u0442\u044C
      \u043D\u0430\u043F\u043E\u044E \u0432\u043F\u043B\u0438\u0432\u0430\u0454 \u043D\u0430
      \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u0456 \u043D\u0430 \u0442\u0435,
      \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0433\u0440\u043E\u0448\u0435\u0439
      \u0432\u0456\u043D \u043F\u0440\u043E\u0434\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 132870790192930816
