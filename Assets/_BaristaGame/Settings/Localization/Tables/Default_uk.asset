  - m_Id: 182201446488363008
    m_Localized: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 500"
    m_Metadata:
      m_Items: []
  - m_Id: 182205256204046336
    m_Localized: "\u0411\u0443\u0434\u044C\u0442\u0435 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456,
      \u0449\u0435 \u0442\u0440\u043E\u0445\u0438 \u0433\u0430\u0440\u044F\u0447\u0435!;
      \u0442\u0443\u0442! \u0426\u0435 \u0442\u0440\u043E\u0445\u0438 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E,
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0432\u0430\u0441!;
      \u0426\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E?; \u0417\u0430\u043C\u043E\u0432\u043B\u044F\u0439\u0442\u0435!~;
      \u041F\u0440\u0438\u0454\u043C\u043D\u043E\u0433\u043E \u043D\u0430\u043F\u043E\u044E!;
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F \u0449\u043E \u0432\u0430\u043C
      \u0446\u0435 \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.;
      \u041E\u0441\u044C \u0432\u0430\u043C, \u0447\u0443\u0434\u043E\u0432\u043E\u0433\u043E
      \u0434\u043D\u044F!; \u041E\u0441\u044C, \u0448\u0432\u0438\u0434\u0448\u0435
      \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F!~; \u0412\u0443\u0430\u043B\u044F!
      \u0412\u0430\u0448\u0435 \u0456\u043D\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043B\u044C\u043D\u0435
      \u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F, \u0441\u0430\u043C\u0435
      \u0434\u043B\u044F \u0432\u0430\u0441!; \u042F \u0432\u043A\u043B\u0430\u0432
      \u0443 \u0446\u0435 \u0442\u0440\u043E\u0445\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E\u0457
      \u043B\u044E\u0431\u043E\u0432\u0456, \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044C!;
      \u041E\u0441\u044C \u0432\u0430\u0448 \u043D\u0430\u043F\u0456\u0439, \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
      \u0437 \u0442\u0443\u0440\u0431\u043E\u0442\u043E\u044E!; \u0412\u0430\u0448\u0435
      \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F, \u043F\u043E\u0434\u0430\u043D\u043E
      \u0437 \u0443\u0441\u043C\u0456\u0448\u043A\u043E\u044E!; \u041D\u0435\u0445\u0430\u0439
      \u0446\u0435\u0439 \u043D\u0430\u043F\u0456\u0439 \u043F\u0440\u0438\u043D\u0435\u0441\u0435
      \u0442\u0440\u043E\u0445\u0438 \u0440\u0430\u0434\u043E\u0441\u0442\u0456 \u0443
      \u0432\u0430\u0448 \u0434\u0435\u043D\u044C!; \u0414\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0456\u0441\u0442\u044C
      \u0443 \u0447\u0430\u0448\u0446\u0456, \u0441\u0430\u043C\u0435 \u0434\u043B\u044F
      \u0412\u0430\u0441!; \u041D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044C
      \u043A\u043E\u0432\u0442\u043A\u043E\u043C \u0449\u0430\u0441\u0442\u044F!;
      \u0412\u0430\u0448 \u043D\u0430\u043F\u0456\u0439 \u0447\u0435\u043A\u0430\u0454!
      \u0421\u044C\u043E\u0440\u0431\u0430\u0439\u0442\u0435 \u0456 \u0441\u043C\u0430\u043A\u0443\u0439\u0442\u0435!;
      \u0421\u0442\u0432\u043E\u0440\u0435\u043D\u043E \u0437 \u0442\u0443\u0440\u0431\u043E\u0442\u043E\u044E,
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0434\u043B\u044F \u0432\u0430\u0441!;
      \u0412\u0430\u0448\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u0433\u043E\u0442\u043E\u0432\u0435, \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044F
      \u0441\u043C\u0430\u043A\u043E\u043C!; \u041E\u0441\u044C \u0432\u0430\u0448
      \u043D\u0430\u043F\u0456\u0439, \u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u0438\u0439!;
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0446\u0435\u0439
      \u043D\u0430\u043F\u0456\u0439 \u0437\u0440\u043E\u0431\u0438\u0442\u044C \u0432\u0430\u0448
      \u0434\u0435\u043D\u044C \u0442\u0440\u0456\u0448\u043A\u0438 \u044F\u0441\u043A\u0440\u0430\u0432\u0456\u0448\u0438\u043C!;
      \u041F\u043E\u0431\u0430\u043B\u0443\u0439\u0442\u0435 \u0441\u0435\u0431\u0435
      \u0446\u0438\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F\u043C,
      \u0432\u043E\u043D\u043E \u0432\u0441\u0435 \u0432\u0430\u0448\u0435!; \u041D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044F
      \u0441\u043C\u0430\u043A\u043E\u043C! \u0417\u0432\u0430\u0440\u0435\u043D\u043E
      \u0441\u0430\u043C\u0435 \u0434\u043B\u044F \u0412\u0430\u0441!; \u041E\u0441\u044C
      \u0432\u0430\u043C! \u041F\u0438\u0439\u0442\u0435 \u0456 \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044C!;
      \u0412\u0430\u0448\u0430 \u0456\u0434\u0435\u0430\u043B\u044C\u043D\u0430 \u0447\u0430\u0448\u043A\u0430,
      \u043F\u043E\u0434\u0430\u043D\u0430 \u0437 \u0443\u0441\u043C\u0456\u0448\u043A\u043E\u044E!;
      \u0417\u0440\u043E\u0431\u0456\u0442\u044C \u043A\u043E\u0432\u0442\u043E\u043A
      \u0456 \u043D\u0435\u0445\u0430\u0439 \u0441\u0432\u0456\u0442 \u0442\u0430\u043D\u0435!;
      \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0446\u0435\u0439
      \u043D\u0430\u043F\u0456\u0439 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0432\u0430\u0448\u0456 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F!;
      \u041D\u0435\u0445\u0430\u0439 \u0432\u0430\u0448 \u0434\u0435\u043D\u044C
      \u0431\u0443\u0434\u0435 \u0442\u0430\u043A\u0438\u043C \u0436\u0435 \u0447\u0443\u0434\u043E\u0432\u0438\u043C,
      \u044F\u043A \u0446\u0435\u0439 \u043D\u0430\u043F\u0456\u0439!; \u041D\u0435\u0445\u0430\u0439
      \u0432\u0430\u0448 \u0434\u0435\u043D\u044C \u0431\u0443\u0434\u0435 \u0442\u0430\u043A\u0438\u043C
      \u0436\u0435 \u0447\u0443\u0434\u043E\u0432\u0438\u043C, \u044F\u043A \u0446\u0435\u0439
      \u043D\u0430\u043F\u0456\u0439!; \u041F\u043E\u0442\u044F\u0433\u0443\u0439\u0442\u0435,
      \u0441\u043C\u0430\u043A\u0443\u0439\u0442\u0435 \u0442\u0430 \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0439\u0442\u0435\u0441\u044C!
      \u0426\u0435 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E \u0441\u0430\u043C\u0435
      \u0434\u043B\u044F \u0432\u0430\u0441!; \u041E\u0441\u044C \u0432\u043E\u043D\u043E,
      \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u0441\u0430\u043C\u0435 \u0442\u0430\u043A,
      \u044F\u043A \u0432\u0430\u043C \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.;"
