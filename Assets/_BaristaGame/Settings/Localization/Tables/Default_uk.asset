      \u043C\u043E\u043B\u043E\u0447\u043D\u0438\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C.@Spoken_Giggles;
      \u041C\u043E\u043B\u043E\u043A\u043E \u043D\u0435 \u043F\u043E\u043B\u044E\u0431\u0438\u043B\u043E
      \u043C\u043E\u044E \u043E\u0441\u0442\u0430\u043D\u043D\u044E \u0436\u0430\u0440\u0442\u0443.
      \u0412\u043E\u043D\u043E \u043D\u0435 \u0431\u0443\u043B\u043E a-meu-sed.@Spoken_Giggles;
