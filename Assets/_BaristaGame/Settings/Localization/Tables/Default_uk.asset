  - m_Id: 132867783132815360
    m_Localized: "\u041C\u043E\u043B\u043E\u0447\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 229470362759168
    m_Localized: "\u041C\u043E\u043B\u043E\u0447\u043D\u0438\u0439 \u0440\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 230078679445504
    m_Localized: "\u041C\u043E\u043B\u043E\u0447\u043D\u0438\u0439 \u0440\u0435\u0436\u0438\u043C
      \u0443\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E:\n\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
      \u0441\u0432\u043E\u044E \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C,
      \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438 Barista \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0454\u0442\u044C\u0441\u044F
      \u0432\u0441\u0435 \u0448\u0432\u0438\u0434\u0448\u0435 \u0456 \u0448\u0432\u0438\u0434\u0448\u0435. 
      \u0427\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438 \u0432\u0441\u0442\u0438\u0433\u0430\u0442\u0438
      \u0437\u0430 \u043D\u0435\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 132865505260838912
    m_Localized: "\u0417\u0430\u0440\u043E\u0431\u043B\u0435\u043D\u0456 \u0433\u0440\u043E\u0448\u0456:"
    m_Metadata:
      m_Items: []
  - m_Id: 133035228871106560
    m_Localized: "\u041C\u0443\u043D\u043E\u043F\u043E\u043B\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1663875916591104
    m_Localized: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043C\u043E\u043B\u043E\u043A\u0430,
      \u0437\u0430\u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 1655167128006656
    m_Localized: "\u043C\u0443\u0437\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133998653654802432
    m_Localized: "\u041A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F \u0432\u0430\u0448\u0438\u043C
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 133998700043804672
    m_Localized: "\u0412\u0430\u0448\u0430 \u043A\u0456\u043D\u0446\u0435\u0432\u0430
      \u043C\u0435\u0442\u0430 \u2014 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0440\u043E\u0437\u043A\u0440\u0438\u0442\u0438 \u043F\u043E\u0442\u0435\u043D\u0446\u0456\u0430\u043B
      \u0431\u0430\u0440\u0438\u0441\u0442\u0430, \u0430\u043B\u0435 \u0432\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0435\u0445\u0442\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u0449\u0430\u0441\u0442\u044F\u043C, \u043F\u043E\u043A\u0438
      \u0432\u043E\u043D\u0430 \u043F\u0440\u0430\u0446\u044E\u0454.  \u0412\u043E\u043D\u0430
      \u043F\u0440\u0438\u0439\u043D\u044F\u043B\u0430 \u0446\u044E \u0440\u043E\u0431\u043E\u0442\u0443,
      \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F \u0434\u043E \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0457
      \u043F\u043E\u0441\u0430\u0434\u0438, \u0430\u043B\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0446\u0435 \u0440\u043E\u0431\u043E\u0442\u0430
      \u0457\u0457 \u043C\u0440\u0456\u0457, \u0432\u043E\u043D\u0430 \u043D\u0435
      \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F, \u044F\u043A\u0449\u043E
      \u0441\u0442\u0430\u043D\u0435 \u043D\u0430\u0434\u0442\u043E \u043D\u0435\u0449\u0430\u0441\u043D\u043E\u044E.\n\n\u0417\u0431\u0430\u043B\u0430\u043D\u0441\u0443\u0439\u0442\u0435
      \u0457\u0457 \u043D\u0430\u0441\u0442\u0440\u0456\u0439, \u0434\u043E\u0441\u044F\u0433\u0430\u044E\u0447\u0438
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0443 \u0432 \u0457\u0457 \u0440\u043E\u0437\u043C\u0456\u0440\u0456
      \u0442\u0430 \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0456
      \u043C\u043E\u043B\u043E\u043A\u0430, \u0440\u0430\u0434\u0443\u044E\u0447\u0438
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432 \u0456 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
      \u0441\u043F\u043E\u0440\u043E\u0436\u043D\u044F\u044E\u0447\u0438 \u0457\u0457,
      \u0446\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
      \u0457\u0457 \u043D\u0430\u0441\u0442\u0440\u0456\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 133998785406279680
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0435\u0436\u0438\u0442\u0438
      \u0437\u0430 \u0449\u0430\u0441\u0442\u044F\u043C \u0456 \u0441\u0438\u0442\u0456\u0441\u0442\u044E
      \u0441\u0432\u043E\u0433\u043E \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u0442\u0443\u0442. 
      \u042F\u043A\u0449\u043E \u0457\u0457 \u0449\u0430\u0441\u0442\u044F \u043F\u0430\u0434\u0430\u0454
      \u0434\u043E 0, \u0432\u043E\u043D\u0430 \u043A\u0438\u0434\u0430\u0454.\n\n\u041D\u0435\u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
      \u043D\u0430 \u0442\u0435, \u0449\u043E \u0432\u043E\u043D\u0430 \u0445\u043E\u0442\u0456\u043B\u0430
      \u0431 \u0440\u043E\u0441\u0442\u0438, \u0432\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0457\u0457 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0441\u0438\u0442\u043E\u044E \u0432\u0435\u0441\u044C \u0447\u0430\u0441,
      \u0456\u043D\u0430\u043A\u0448\u0435 \u0431\u0456\u043B\u044C \u0457\u0457
      \u0437\u0430\u0441\u043C\u0443\u0442\u0438\u0442\u044C, \u0430\u043B\u0435
      \u0432\u0438 \u0442\u0430\u043A\u043E\u0436 \u043D\u0435 \u043F\u043E\u0432\u0438\u043D\u043D\u0456
      \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0457\u0457 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u044E \u0432\u0435\u0441\u044C
      \u0447\u0430\u0441, \u0456\u043D\u0430\u043A\u0448\u0435 \u0446\u0435 \u043C\u043E\u0436\u0435
      \u0457\u0457 \u0437\u0430\u0441\u043C\u0443\u0442\u0438\u0442\u0438. , \u0442\u043E\u0436
      \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0437\u043D\u0430\u0439\u0442\u0438
      \u0431\u0430\u043B\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 133847557804236800
    m_Localized: "\u0414\u0430\u043B\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 133055089148010496
    m_Localized: "\u041D\u0435\u043C\u0430\u0454 \u0437\u0430\u043F\u0438\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 132870450861154304
    m_Localized: "\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 266676540370944
    m_Localized: "\u0413\u0440\u0430\u0439\u0442\u0435, \u0434\u043E\u043A\u0438
      \u0432\u0430\u0448 \u0431\u0430\u0440\u0438\u0441\u0442\u0430 \u043D\u0435
      \u0441\u0442\u0430\u043D\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0432\u0435\u043B\u0438\u043A\u0438\u043C, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0437\u043C\u043E\u0436\u0435, \u0430\u0431\u043E \u043F\u043E\u043A\u0438
      \u0432\u0456\u043D \u043D\u0435 \u0440\u043E\u0437\u0441\u0435\u0440\u0434\u0438\u0442\u044C\u0441\u044F
      \u0456 \u043D\u0435 \u043A\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 266450740015104
    m_Localized: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C"
