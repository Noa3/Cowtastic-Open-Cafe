      \u044F \u043C\u043E\u0436\u0443 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
      \u0437 \u0447\u0430\u0448\u043A\u0430\u043C\u0438.@Spoken_Giggles; \u0422\u0438
      \u0431\u0443\u0432 \u0447\u0443\u0434\u043E\u0432\u0438\u043C \u0448\u0435\u0444\u043E\u043C.@Spoken_Sigh_Happy;
      \u0417\u043C\u0456\u043D\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u044E?
      \u041D\u0456, \u044F\u043A\u0449\u043E \u0442\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0448
      \u0434\u043E\u0431\u0440\u0435 \u0441\u0442\u0430\u0432\u0438\u0442\u0438\u0441\u044F
      \u0434\u043E \u043C\u0435\u043D\u0435!@Spoken_Sigh_Happy; \u041A\u043E\u0440\u043E\u0432\u0438
      \u043C\u043E\u0436\u0443\u0442\u044C \u0441\u0442\u0430\u0442\u0438 \u0442\u0440\u043E\u0445\u0438
      MOOdy, \u044F\u043A\u0449\u043E \u0457\u0445 \u043D\u0435 \u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0434\u043E\u0431\u0440\u0435, \u044F\u043A \u0442\u0438 \u0441\u0442\u0430\u0432\u0438\u0448\u0441\u044F
      \u0434\u043E \u043C\u0435\u043D\u0435.@Spoken_Sigh_Happy; \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E
      \u0441\u0435\u0431\u0435, \u044F\u043A \u043D\u0456\u0431\u0438 \u044F \u043D\u0430
      \u0432\u0435\u0440\u0448\u0438\u043D\u0456 \u0441\u0432\u0456\u0442\u0443 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456!@Spoken_Sigh_Happy;
      \u0427\u0438 \u043D\u0435 \u0434\u043E\u0431\u0440\u0435 \u043C\u0430\u0442\u0438
      \u0440\u043E\u0431\u043E\u0442\u0443, \u044F\u043A\u0430 \u0440\u043E\u0431\u0438\u0442\u044C
      \u0442\u0435\u0431\u0435 \u0441\u043C\u0456\u044F\u0442\u0438\u0441\u044F?@Spoken_Sigh_Happy;
      \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435
      \u0434\u0443\u0436\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043E\u044E
      \u0456 \u0449\u0430\u0441\u043B\u0438\u0432\u043E\u044E \u0437\u0430\u0440\u0430\u0437!@Spoken_Sigh_Happy;
      \u041A\u043E\u0436\u0435\u043D \u0434\u0435\u043D\u044C \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E\u0431\u0440\u0438\u043C \u0434\u043D\u0435\u043C, \u043A\u043E\u043B\u0438
      \u044F \u0432 \u0434\u043E\u0431\u0440\u043E\u043C\u0443 \u043D\u0430\u0441\u0442\u0440\u043E\u0457!@Spoken_Sigh_Happy;
      \u042F \u043C\u043E\u0433\u043B\u0430 \u0431 \u0442\u0430\u043D\u0446\u044E\u0432\u0430\u0442\u0438
      \u0432\u0456\u0434 \u0440\u0430\u0434\u043E\u0441\u0442\u0456 \u0437\u0430\u0440\u0430\u0437!@Spoken_Sigh_Happy;
      \u041C\u043E\u0454 \u0441\u0435\u0440\u0446\u0435 \u043B\u0435\u0433\u043A\u0435
      \u0456 \u0449\u0430\u0441\u043B\u0438\u0432\u0435 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456!@Spoken_Sigh_Happy;
      \u0423 \u043C\u0435\u043D\u0435 \u043B\u0435\u0433\u043A\u0438\u0439 \u043A\u0440\u043E\u043A
      \u0456 \u043F\u043E\u0441\u043C\u0456\u0448\u043A\u0430 \u043D\u0430 \u043E\u0431\u043B\u0438\u0447\u0447\u0456!@Spoken_Sigh_Happy;
      \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0437\u0456\u0440\u043A\u0438
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0438\u0440\u0456\u0432\u043D\u044F\u043D\u0456!@Spoken_Sigh_Happy;
      \u0416\u0438\u0442\u0442\u044F \u043D\u0435 \u0447\u0443\u0434\u043E\u0432\u0435,
      \u043A\u043E\u043B\u0438 \u0442\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0448
      \u0441\u0435\u0431\u0435 \u0434\u043E\u0431\u0440\u0435?@Spoken_Sigh_Happy;
      \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435,
      \u044F\u043A \u043D\u0456\u0431\u0438 \u044F \u043C\u043E\u0433\u043B\u0430
      \u0437\u0430\u0432\u043E\u044E\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0442
      \u0437\u0430\u0440\u0430\u0437!@Spoken_Sigh_Happy; \u0423 \u043C\u0435\u043D\u0435
      \u0449\u0430\u0441\u043B\u0438\u0432\u0435 \u0441\u0435\u0440\u0446\u0435 \u0456
      \u043A\u0430\u0432\u0430!@Spoken_Sigh_Happy; \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0447\u0443\u0434\u043E\u0432\u0438\u0439 \u0434\u0435\u043D\u044C!@Spoken_Sigh_Happy;
      \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435
      \u0434\u0443\u0436\u0435 \u0432\u0434\u044F\u0447\u043D\u043E\u044E \u0437\u0430
      \u0432\u0441\u0435 \u0437\u0430\u0440\u0430\u0437!@Spoken_Sigh_Happy; \u0412\u0441\u0435
      \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0434\u0443\u0436\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0438\u043C
      \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456!@Spoken_Sigh_Happy; \u042F
      \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435,
      \u044F\u043A \u043D\u0456\u0431\u0438 \u044F \u0441\u0432\u0456\u0442\u043B\u044E\u0441\u044F
      \u0449\u0430\u0441\u0442\u044F\u043C!@Spoken_Sigh_Happy; \u042F \u0434\u0443\u0436\u0435
      \u0449\u0430\u0441\u043B\u0438\u0432\u0430, \u043C\u0430\u0439\u0436\u0435
      \u0432\u0438\u0431\u0443\u0445\u043D\u0443\u043B\u0430!@Spoken_Sigh_Happy;
      \u0429\u0430\u0441\u0442\u044F \u0454 \u0437\u0430\u0440\u0430\u0437\u043D\u0435,
      \u0447\u0438 \u043D\u0435 \u0442\u0430\u043A?@Spoken_Sigh_Happy; \u0416\u0438\u0442\u0442\u044F
      \u043D\u0435 \u0447\u0443\u0434\u043E\u0432\u0435, \u043A\u043E\u043B\u0438
      \u0442\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0448 \u0441\u0435\u0431\u0435
      \u0434\u043E\u0431\u0440\u0435?@Spoken_Sigh_Happy; \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E
      \u0441\u0435\u0431\u0435, \u044F\u043A \u043D\u0456\u0431\u0438 \u044F \u0445\u043E\u0434\u0436\u0443
      \u043F\u043E \u043F\u043E\u0432\u0456\u0442\u0440\u044E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456!@Spoken_Sigh_Happy;
      \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435
      \u0434\u0443\u0436\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u043D\u043E\u044E
      \u0456 \u0449\u0430\u0441\u043B\u0438\u0432\u043E\u044E \u0437\u0430\u0440\u0430\u0437!@Spoken_Sigh_Happy;
      \u041C\u0443\u0443!@Moo_Happy; \u042F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E
      \u0441\u0435\u0431\u0435 \u0434\u0443\u0436\u0435 \u0440\u043E\u0437\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043E\u044E.@Spoken_Sigh_Happy
      ### \u0412\u044C\u0435\u0442\u043D\u0430\u043C\u0441\u043A\u0438\u0439 (Ti\u1EBFng
      Vi\u1EC7t): T\xF4i hy v\u1ECDng Lacti c\xF3 th\u1EC3 tr\u1ED1n tho\xE1t kh\u1ECFi
      c\xF4ng vi\u1EC7c \u0111\u1EC3 g\u1EB7p t\xF4i h\xF4m nay.@Spoken_Sigh_Happy;
      B\u1EA1n t\xF4i lu\xF4n c\u1ED1 g\u1EAFng s\u1EE3 h\xE3i b\u1EA1n kh\xE1c c\u1EE7a
      m\xECnh. C\xF4 \u1EA5y l\xE0 m\u1ED9t ng\u01B0\u1EDDi h\xE2m m\u1ED9 c\u1EE7a
      milkshake.@Jokes_FriendScaringOtherFriends; B\u1EA1n t\xF4i ngh\u0129 r\u1EB1ng
      c\xF4 \u1EA5y s\u1EA3n xu\u1EA5t s\u1EEFa \u0111\u1EADu \u0103n. C\xF4 \u1EA5y
      ph\u1EA3i l\xE0 m\u1ED9t ng\u01B0\u1EDDi \u0111i\xEAn.@Jokes_AlmondMilk; B\u1EA1n
      c\u1EA3m th\u1EA5y th\u1EBF n\xE0o, \xF4ng ch\u1EE7?@Spoken_Sigh_Happy; B\u1EA1n
      c\xF3 mu\u1ED1n \u0111i \u0111\xE2u sau c\xF4ng vi\u1EC7c h\xF4m nay?@Spoken_Sigh_Happy;
      C\xF4ng vi\u1EC7c n\xE0y th\u1EADt s\u1EF1 vui v\u1EBB!@Spoken_Sigh_Happy;
      C\xF3 g\xEC t\xF4i c\xF3 th\u1EC3 l\xE0m cho b\u1EA1n kh\xF4ng?@Spoken_Sigh_Happy;
      Kh\xE1ch h\xE0ng c\xF3 v\u1EBB th\xEDch t\xF4i.@Spoken_Sigh_Happy; Hmm hm hmm
      hhm hmmm!@Spoken_Humming; Ng\xE0y h\xF4m nay th\u1EADt tuy\u1EC7t v\u1EDDi!@Spoken_Sigh_Happy;
      H\xE3y xem chi\u1EBFc kh\u0103n trang tr\xED t\xF4i c\xF3 th\u1EC3 l\xE0m v\u1EDBi
      c\xE1c c\u1ED1c.@Spoken_Giggles; B\u1EA1n l\xE0 m\u1ED9t \xF4ng ch\u1EE7 tuy\u1EC7t
      v\u1EDDi.@Spoken_Sigh_Happy; Thay \u0111\u1ED5i t\xE2m tr\u1EA1ng? Kh\xF4ng,
      n\u1EBFu b\u1EA1n ti\u1EBFp t\u1EE5c \u0111\u1ED1i x\u1EED t\u1ED1t v\u1EDBi
      t\xF4i!@Spoken_Sigh_Happy; Con b\xF2 c\xF3 th\u1EC3 tr\u1EDF n\xEAn m\u1ED9t
      ch\xFAt MOOdy n\u1EBFu kh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1ED1i x\u1EED t\u1ED1t
      nh\u01B0 b\u1EA1n \u0111\u1ED1i x\u1EED v\u1EDBi t\xF4i.@Spoken_Sigh_Happy;
      T\xF4i c\u1EA3m th\u1EA5y nh\u01B0 t\xF4i \u0111ang \u1EDF \u0111\u1EC9nh cao
      c\u1EE7a th\u1EBF gi\u1EDBi h\xF4m nay!@Spoken_Sigh_Happy; Kh\xF4ng ph\u1EA3i
      l\xE0 t\u1ED1t khi c\xF3 m\u1ED9t c\xF4ng vi\u1EC7c khi\u1EBFn b\u1EA1n c\u01B0\u1EDDi?@Spoken_Sigh_Happy;
      T\xF4i c\u1EA3m th\u1EA5y r\u1EA5t h\xE0i l\xF2ng v\xE0 h\u1EA1nh ph\xFAc b\xE2y
      gi\u1EDD!@Spoken_Sigh_Happy; M\u1ED7i ng\xE0y c\xF3 v\u1EBB nh\u01B0 l\xE0
      m\u1ED9t ng\xE0y t\u1ED1t khi t\xF4i \u1EDF trong t\xE2m tr\u1EA1ng t\u1ED1t!@Spoken_Sigh_Happy;
      T\xF4i c\xF3 th\u1EC3 vui v\u1EBB nh\u1EA3y m\xFAa b\xE2y gi\u1EDD!@Spoken_Sigh_Happy;
      Tr\xE1i tim t\xF4i nh\u1EB9 v\xE0 h\u1EA1nh ph\xFAc h\xF4m nay!@Spoken_Sigh_Happy;
      T\xF4i c\xF3 m\u1ED9t b\u01B0\u1EDBc ch\xE2n nh\u1EB9 v\xE0 m\u1ED9t n\u1EE5
      c\u01B0\u1EDDi tr\xEAn m\u1EB7t!@Spoken_Sigh_Happy; C\xF3 v\u1EBB nh\u01B0
      c\xE1c sao \u0111\xE3 \u0111\u01B0\u1EE3c c\u0103n ch\u1EC9nh h\xF4m nay!@Spoken_Sigh_Happy;
      Cu\u1ED9c s\u1ED1ng kh\xF4ng ph\u1EA3i l\xE0 \u0111\u1EB9p khi b\u1EA1n c\u1EA3m
      th\u1EA5y t\u1ED1t kh\xF4ng?@Spoken_Sigh_Happy; T\xF4i c\u1EA3m th\u1EA5y nh\u01B0
      t\xF4i c\xF3 th\u1EC3 chi\u1EBFm l \u1EA1i th\u1EBF gi\u1EDBi b\xE2y gi\u1EDD!@Spoken_Sigh_Happy;
      T\xF4i c\xF3 m\u1ED9t tr\xE1i tim h\u1EA1nh ph\xFAc v\xE0 c\xE0 ph\xEA!@Spoken_Sigh_Happy;
      H\xF4m nay l\xE0 m\u1ED9t ng\xE0y tuy\u1EC7t v\u1EDDi!@Spoken_Sigh_Happy; T\xF4i
      c\u1EA3m th\u1EA5y r\u1EA5t bi\u1EBFt \u01A1n cho t\u1EA5t c\u1EA3 m\u1ECDi
      th\u1EE9 b\xE2y gi\u1EDD!@Spoken_Sigh_Happy; M\u1ECDi th\u1EE9 c\xF3 v\u1EBB
      nh\u01B0 l\xE0 \u0111\xFAng h\xF4m nay!@Spoken_Sigh_Happy; T\xF4i c\u1EA3m
      th\u1EA5y nh\u01B0 t\xF4i \u0111ang t\u1ECFa s\xE1ng h\u1EA1nh ph\xFAc!@Spoken_Sigh_Happy;
      T\xF4i r\u1EA5t h\u1EA1nh ph\xFAc, g\u1EA7n nh\u01B0 b\xF9ng n\u1ED5!@Spoken_Sigh_Happy;
      H\u1EA1nh ph\xFAc l\xE0 l\xE2y lan, ph\u1EA3i kh\xF4ng?@Spoken_Sigh_Happy;
      Cu\u1ED9c s\u1ED1ng kh\xF4ng ph\u1EA3i l\xE0 \u0111\u1EB9p khi b\u1EA1n c\u1EA3m
      th\u1EA5y t\u1ED1t kh\xF4ng?@Spoken_Sigh_Happy; T\xF4i c\u1EA3m th\u1EA5y nh\u01B0
      t\xF4i \u0111ang \u0111i tr\xEAn kh\xF4ng trung h\xF4m nay!@Spoken_Sigh_Happy;
      T\xF4i c\u1EA3m th\u1EA5y r\u1EA5t h\u1EA1nh ph\xFAc v\xE0 may m\u1EAFn b\xE2y
      gi\u1EDD!@Spoken_Sigh_Happy; Muu!@Moo_Happy; T\xF4i c\u1EA3m th\u1EA5y r\u1EA5t
      th\u01B0 gi\xE3n.@Spoken_Sigh_Happy"
