  - m_Id: 1677736099016704
    m_Localized: "\u041D\u0435\u0433\u0430\u0439\u043D\u043E \u043D\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C
      Barista."
    m_Metadata:
