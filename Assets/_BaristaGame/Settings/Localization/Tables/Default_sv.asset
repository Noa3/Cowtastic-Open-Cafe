  - m_Id: 175274055513952256
    m_Localized: "Tack!; Jag nj\xF6t av servicen och drinken.; Det var bra!; Jag
      \xE4lskade det!; Utm\xE4rkt betj\xE4ning!; L\xE4cker drink!; Rekommenderas
      starkt!; Underbar upplevelse!; Fantastisk!; Fantastisk service!; \xC4lskade
      varje klunk!; Toppklass!; Kunde inte bli b\xE4ttre!; Perfekt drink!; Fantastisk
      service!; Precis vad jag beh\xF6vde!; Bra jobbat!; Forts\xE4tt s\xE5!; Kommer
      definitivt tillbaka!; Imponerad!"
    m_Metadata:
      m_Items: []
  - m_Id: 175274128738111488
    m_Localized: "Detta var inte vad jag best\xE4llde.; Jag bad inte om detta.; Det
      h\xE4r var inte vad jag ville.; F\xF6rl\xE5t, men detta \xE4r felaktigt.; Urs\xE4kta
      mig, men det h\xE4r \xE4r inte r\xE4tt.; Jag \xE4r ledsen, men min best\xE4llning
      \xE4r fel.; Kan vi fixa detta?; Kan du kontrollera min best\xE4llning igen?;
      Jag tror att det har skett ett misstag.; Jag best\xE4llde n\xE5got annat.;
      Detta \xE4r inte vad jag f\xF6rv\xE4ntade mig.; Kan vi l\xF6sa det h\xE4r problemet?;
      Finns det en sammanblandning?; Kan du dubbelkolla?; Jag \xE4r lite besviken.;
      Kan du fixa detta \xE5t mig?; Jag \xE4r inte n\xF6jd med detta.; Det h\xE4r
      \xE4r inte vad jag f\xF6rv\xE4ntade mig."
    m_Metadata:
      m_Items: []
  - m_Id: 175601404604338176
    m_Localized: "Utan; Nej; Exklusive; , Utel\xE4mna; , H\xE5ll; Inkludera inte;
      Fri fr\xE5n"
    m_Metadata:
      m_Items: []
  - m_Id: 175608705562202112
    m_Localized: "Mj\xF6lkproduktionshastighet"
    m_Metadata:
      m_Items: []
