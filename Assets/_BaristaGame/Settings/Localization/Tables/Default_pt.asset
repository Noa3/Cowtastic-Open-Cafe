      m_Items: []
  - m_Id: 175274055513952256
    m_Localized: "Obrigado!; Gostei do servi\xE7o e da bebida.; Foi \xF3timo!; Eu
      amei!; Servi\xE7o excelente!; Bebida deliciosa!; Altamente recomendado!; Experi\xEAncia
      maravilhosa!; Fant\xE1stico!; Servi\xE7o incr\xEDvel!; Adorei cada gole!; Top
      de linha!; N\xE3o poderia estar melhor!; Bebida perfeita!; Servi\xE7o incr\xEDvel!;
      Exatamente o que eu precisava!; Bom trabalho!; Continue assim!; Definitivamente
      voltarei!; Impressionado!"
    m_Metadata:
      m_Items: []
  - m_Id: 175274128738111488
    m_Localized: "N\xE3o foi isso que eu pedi.; Eu n\xE3o pedi isso.; N\xE3o era
      isso que eu queria.; Desculpe, mas isso est\xE1 incorreto.; Desculpe, mas isso
      n\xE3o est\xE1 certo.; Sinto muito, mas meu pedido est\xE1 errado.; Podemos
      consertar isso?; Voc\xEA poderia verificar meu pedido novamente?; Acho que
      houve um erro.; Eu pedi outra coisa.; Isso n\xE3o \xE9 o que eu esperava.;
      Podemos resolver esse problema?; Existe alguma confus\xE3o?; Voc\xEA poderia
      verificar novamente?; Estou um pouco decepcionado.; Voc\xEA pode consertar
      isso para mim?; N\xE3o estou satisfeito com isso.; Isto n\xE3o \xE9 o que eu
      esperava."
    m_Metadata:
      m_Items: []
  - m_Id: 175601404604338176
    m_Localized: "Sem; N\xE3o coloque; Excluindo; , Tira o; , Segura o; N\xE3o inclua;
      Livre de"
    m_Metadata:
      m_Items: []
