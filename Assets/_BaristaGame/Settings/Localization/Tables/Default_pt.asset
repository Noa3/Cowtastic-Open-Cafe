      m_Items: []
  - m_Id: 167535336119881728
    m_Localized: "Ol\xE1!; Ol\xE1.; Ei! gracinha.; Ei.; Oi.; Ol\xE1!; Oi...; Hm...;
      Uuuh...; Uh...; Aha!; Ei.; Ol\xE1...; Sauda\xE7\xF5es.; Ol\xE1 jovem. ; Eai.;
      Co\xE9.; Uhuh...; Ol\xE1!; Ol\xE1!; Ei! E a\xED?; Bom dia!; Ol\xE1!; Ei! senhor(a).;
      Sauda\xE7\xF5es!; Bem! Ol\xE1!; Ol\xE1! como voc\xEA est\xE1?; Ei! Que bom
      ver voc\xEA!; Ei! Faz muito tempo que n\xE3o nos vemos!; Ei! O que est\xE1
      o que t\xE1 fazendo a\xED?; Ei! Como vai?; Ei! Prazer em conhec\xEA-lo!; Ei!
      O que h\xE1 de novo?; Ei! Como vai a vida?; Ei! Como vai?; Ei! tudo bem?; Ei!
      Como vai o seu dia?; Ei! Como v\xE3o as coisas?; Ei! Como voc\xEA tem estado?"
    m_Metadata:
      m_Items: []
  - m_Id: 167615756777836544
    m_Localized: "Eu quero um; posso conseguir um; voc\xEA tem; me v\xEA um; posso
      ter; estou interessado em um; seria poss\xEDvel conseguir um; por favor me
      d\xEA um"
