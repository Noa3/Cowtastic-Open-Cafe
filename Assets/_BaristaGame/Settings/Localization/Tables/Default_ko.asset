    m_Metadata:
      m_Items: []
  - m_Id: 273385908432896
    m_Localized: "\uC548 \uB3FC.\n\uC774 \uC138\uC0C1\uC758 \uBAA8\uB4E0 \uC88B\uC740
      \uAC83\uC744 \uC0AC\uB791\uD558\uAE30 \uC704\uD574 \uC801\uC5B4\uB3C4 \uC77C\uBC18
      \uBAA8\uB4DC\uB97C \uBA3C\uC800 \uD50C\uB808\uC774\uD574\uBCF8 \uC801\uC774
      \uC788\uB2E4\uACE0 \uB9D0\uD574\uC8FC\uC138\uC694.  \uB2F9\uC2E0\uC758 \uC774\uC775\uC744
      \uC704\uD574... \uC81C\uBC1C!"
    m_Metadata:
      m_Items: []
