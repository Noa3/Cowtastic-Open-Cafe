      \uC548\uB155\uD558\uC138\uC694! \uC624\uB79C\uB9CC\uC774\uC5D0\uC694!, \uD5E4\uC774!
      \uBB34\uC2A8 \uC694\uB9AC\uD574\uC694?, \uD5E4\uC774! \uC798 \uC9C0\uB0B4\uC694?,
      \uC548\uB155! \uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC\uC694!, \uC548\uB155\uD558\uC138\uC694!
      \uC0C8\uB85C\uC6B4 \uC18C\uC2DD\uC740 \uBB34\uC5C7\uC785\uB2C8\uAE4C?, \uC548\uB155\uD558\uC138\uC694!
