  - m_Id: 175650030386958336
    m_Localized: "\uC0C8\uB85C\uC6B4 \uC9C1\uC7A5, \uC0C8\uB85C\uC6B4 \uC0B6.@Intro_NewJobNewLife;
      \uC774\uACF3 \uC0AC\uB78C\uB4E4\uC774 \uCE5C\uC808\uD558\uAE38 \uBC14\uB78D\uB2C8\uB2E4.@Intro_IHopePeopleAreNice;
      \uBE68\uB9AC \uC2DC\uC791\uD558\uACE0 \uC2F6\uC5B4\uC694!@Intro_ICantWaitToStart;
      \uCCAB \uCD9C\uADFC \uB0A0.@Intro_FirstDayOnTheJob"
    m_Metadata:
      m_Items: []
  - m_Id: 175651777658507264
    m_Localized: "\uC548\uB155\uD558\uC138\uC694!; \uC548\uB155\uD558\uC138\uC694!;
      \uD658\uC601!; \uBB34\uC5C7\uC774\uB4E0 \uB4DC\uB9B4\uAE4C\uC694?; \uC815\uADDC?;
      \uC5B4\uB5BB\uAC8C \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?; \uBB34\uC5C7\uC744
      \uC5BB\uC744 \uC218 \uC788\uB098\uC694?; \uD658\uC601! \uC624\uB298\uC740 \uBB34\uC5C7\uC744
      \uB4DC\uB9B4\uAE4C\uC694?; \uC624\uB298\uC740 \uC88B\uC544 \uBCF4\uC5EC\uC694!
      \uBB34\uC5C7\uC744 \uAC00\uC838\uAC08 \uC218 \uC788\uB098\uC694?; \uC624\uB298\uC758
      \uD2B9\uC9D1: \uC2E0\uC120\uD55C \uC6B0\uC720!; \uBCF4\uBC14\uBC00\uD06C\uB97C
      \uB4DC\uC154\uBCF4\uC168\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 175662100285247488
    m_Localized: "\uB098\uB294 \uADF8 \uCFE0\uD0A4\uB97C \uC6D0\uD55C\uB2E4!; \uADF8
      \uCFE0\uD0A4 \uB9DB\uC788\uC5B4 \uBCF4\uC774\uB124\uC694.; \uC800 \uCFE0\uD0A4
      \uB9DB\uC774 \uC5B4\uB5A8\uC9C0 \uAD81\uAE08\uD558\uB124\uC694...?; \uCFE0\uD0A4\uAC00
      \uD1B5\uC9F8\uB85C \uC785\uC5D0 \uB4E4\uC5B4\uAC08\uC9C0 \uAD81\uAE08\uD558\uB124\uC694;
      \uB9E4\uC9C1 \uCFE0\uD0A4\uB294 \uC5B8\uC81C \uBC1B\uC744 \uC218 \uC788\uB098\uC694?;
      \uC774 \uC9C1\uC5C5\uC740 \uD2B9\uC815\uD55C \uC774\uC775\uC744 \uC57D\uC18D\uD588\uC2B5\uB2C8\uB2E4.
      \uADF8\uB807\uC8E0?; \uB098\uB294 \uC131\uC7A5\uD558\uACE0 \uC2F6\uB2E4...;
      \uCFE0\uD0A4 \uAC08\uB9DD\uC774 \uB4E4\uC5B4\uC635\uB2C8\uB2E4!; \uCFE0\uD0A4
      \uACBD\uACE0! \uBC18\uBCF5\uD569\uB2C8\uB2E4. \uCFE0\uD0A4 \uACBD\uACE0\uC785\uB2C8\uB2E4!;
      \uB098\uB294 \uADF8 \uCFE0\uD0A4\uC5D0 \uB208\uC744 \uB5B4\uB2E4!; \uCFE0\uD0A4\uC5D0
      \uB300\uD55C \uAC08\uB9DD\uC744 \uCDA9\uC871\uC2DC\uD0AC \uC2DC\uAC04\uC785\uB2C8\uB2E4!;
      \uCFE0\uD0A4 \uBBF8\uC158: \uD65C\uC131\uD654!; \uCFE0\uD0A4 \uB808\uC774\uB354
      \uC791\uB3D9!; \uCEE4\uD53C\uB97C \uCFE0\uD0A4\uB85C \uBC14\uAFB8\uACA0\uC2B5\uB2C8\uB2E4!;
      \uCFE0\uD0A4\uB97C \uC0AC\uC6A9\uD560 \uAC83\uC778\uAC00, \uCFE0\uD0A4\uB97C
      \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC744 \uAC83\uC778\uAC00? \uADF8\uAC83\uC774
      \uBB38\uC81C\uC785\uB2C8\uB2E4.; \uCFE0\uD0A4\uC5D0 \uAD00\uD574\uC11C\uB77C\uBA74
      \uC800\uD56D\uC740 \uC18C\uC6A9\uC5C6\uC2B5\uB2C8\uB2E4!; \uCFE0\uD0A4\uC5D0
      \uB300\uD55C \uAC08\uB9DD: 100% \uB9CC\uC871 \uBCF4\uC7A5!; \uCFE0\uD0A4 \uC2DC\uAC04\uC774
      \uAC00\uC7A5 \uC88B\uC740 \uC2DC\uAC04\uC785\uB2C8\uB2E4!; \uCFE0\uD0A4\uC758
      \uAFC8\uC740 \uC774\uAC83\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC9D1\uB2C8\uB2E4!;
      \uCFE0\uD0A4 \uAE30\uB300 \uC218\uC900: \uCD5C\uB300!; \uB098\uC758 \uB2EC\uCF64\uD55C
      \uCE58\uC544\uAC00 \uADF8 \uCFE0\uD0A4\uB97C \uC694\uAD6C\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4!;
      \uADF8 \uCFE0\uD0A4\uAC00 \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uACE0 \uC788\uC5B4\uC694!;
      \uB098\uB294 \uD55C \uBC29\uD5A5\uC73C\uB85C\uB9CC \uC0DD\uAC01\uD558\uB294
      \uB9C8\uC74C\uC744 \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4... \uADF8\uB9AC\uACE0
      \uADF8\uAC83\uC740 \uADF8 \uCFE0\uD0A4\uC5D0 \uC788\uC2B5\uB2C8\uB2E4!; \uCFE0\uD0A4\uC5D0
      \uB300\uD55C \uC9D1\uCC29: \uD65C\uC131\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4!;
      \uC9C0\uAE08 \uB0B4\uAC00 \uC6D0\uD558\uB294 \uAC83\uC740 \uADF8 \uCFE0\uD0A4\uBFD0\uC785\uB2C8\uB2E4!;
      \uBC14\uB9AC\uC2A4\uD0C0\uB97C \uC704\uD55C \uC791\uC740 \uD55C \uAC78\uC74C,
      \uCFE0\uD0A4\uC885\uC744 \uC704\uD55C \uAC70\uB300\uD55C \uB3C4\uC57D!; \uCFE0\uD0A4
      \uAC08\uB9DD: \uCD5C\uACE0 \uC218\uC900 \uB2EC\uC131!; \uB2F9\uC2E0\uC774 \uB098\uC5D0\uAC8C
      \uB9C8\uBC95\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC544\uC694~"
    m_Metadata:
      m_Items: []
  - m_Id: 175662781700263936
    m_Localized: "\uC74C! \uB9DB\uC788\uC5B4\uC694!~; \uBB54\uAC00 \uB290\uB08C\uC774
      \uB2E4\uB978\uB370...?; \uB0B4\uAC00 \uB354 \uC6D0\uD574!; \uC6B0\uC720\uB9DB\uC774
      \uB098\uB124\uC694!; \uC774\uC81C \uC6B0\uB9AC\uB294 \uC5B4\uB518\uAC00\uC5D0
      \uAC00\uACE0 \uC788\uC2B5\uB2C8\uB2E4!; \uC640, \uAE30\uBD84 \uC88B\uB2E4!;
      \uADF8\uB7F0 \uAC83\uC774 \uB354 \uB9CE\uC558\uC73C\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4.;
      \uCFE0\uD0A4 \uD018\uC2A4\uD2B8\uB294 \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4! \uB9DB\uC788\uB294!; \uADF8 \uCFE0\uD0A4\uAC00
      \uADF8 \uC790\uB9AC\uC5D0 \uB9DE\uC558\uC2B5\uB2C8\uB2E4! \uB354\uC8FC\uC138\uC694!;
      \uCFE0\uD0A4 \uB9CC\uC871\uB3C4 \uB2EC\uC131!; \uC800\uB294 \uC9C0\uAE08 \uCFE0\uD0A4
      \uCC9C\uAD6D\uC5D0 \uC788\uC5B4\uC694!; \uC74C! \uCD5C\uACE0\uC758 \uACB0\uC815!;
      \uCFE0\uD0A4\uB294 \uD589\uBCF5\uD569\uB2C8\uB2E4! \uCDA9\uBD84\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4!; \uC774 \uCFE0\uD0A4\uB294 \uD310\uB3C4\uB97C \uBC14\uAFB8\uB294
      \uAC83\uC785\uB2C8\uB2E4!; \uCFE0\uD0A4 \uB9C8\uBC95\uC774 \uC791\uB3D9 \uC911\uC774\uC5D0\uC694!
      \uB098\uB294 \uADF8\uAC83\uC744 \uC0AC\uB791 \uD574\uC694!; \uCFE0\uD0A4 \uD558\uB098\uAC00
      \uC774\uB807\uAC8C \uB9CE\uC740 \uAE30\uC068\uC744 \uAC00\uC838\uB2E4 \uC904
      \uC218 \uC788\uB2E4\uB294 \uAC83\uC744 \uB204\uAC00 \uC54C\uC558\uACA0\uC2B5\uB2C8\uAE4C?;
      \uC774\uC81C \uC774\uAC83\uC774 \uC81C\uAC00 \uCFE0\uD0A4 \uAC78\uC791\uC774\uB77C\uACE0
      \uBD80\uB974\uB294 \uAC83\uC785\uB2C8\uB2E4!; \uCFE0\uD0A4 \uCC9C\uAD6D \uBC1C\uACAC!;
      \uC2B9\uB9AC\uC758 \uB9DB... \uADF8\uB9AC\uACE0 \uCFE0\uD0A4!; \uADF8 \uCFE0\uD0A4\uB294
      \uAE08\uBA54\uB2EC\uC744 \uBC1B\uC744 \uC790\uACA9\uC774 \uC788\uC5B4\uC694!;
      \uB098\uB294 \uC774 \uCFE0\uD0A4\uB97C \uAC00\uC9C0\uACE0 \uD074\uB77C\uC6B0\uB4DC
      9\uC5D0 \uC788\uC2B5\uB2C8\uB2E4!; \uC6B0\uC720\uC640 \uCFE0\uD0A4, \uC644\uBCBD\uD55C
      \uC870\uD569!; \uD55C \uC785 \uBA39\uC73C\uBA74 \uD479 \uBE60\uC838\uC694!
      \uB354\uC8FC\uC138\uC694!; \uCFE0\uD0A4 \uC644\uC131\uB3C4 \uB2EC\uC131!; \uCFE0\uD0A4\uB9C8\uBC95
      \uBC1C\uB3D9! \uBA39\uB294 \uAC83\uC744 \uBA48\uCD9C \uC218 \uC5C6\uB2E4!;
      \uC774 \uCFE0\uD0A4\uB294 \uBBF8\uAC01\uC744 \uC790\uADF9\uD569\uB2C8\uB2E4!;
      \uB098\uB294 \uC774 \uCFE0\uD0A4\uB97C \uD3C9\uC0DD \uACF5\uAE09\uD574\uC57C
      \uD569\uB2C8\uB2E4!; \uBABD\uD06C \uBB49\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 175663362036748288
    m_Localized: "\uC55E\uCE58\uB9C8\uAC00 \uC880 \uC870\uC774\uB294 \uB290\uB08C\uC774
      \uB4E4\uAE30 \uC2DC\uC791\uD558\uB294\uB370...; \uB4A4\uCABD\uC5D0 \uB354 \uD070
      \uC55E\uCE58\uB9C8\uAC00 \uC788\uB098\uC694?; \uC774 \uC5BC\uB8E9\uC744 \uB2E4\uC2DC
      \uC9C0\uC6B8 \uC218 \uC788\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4...; \uC5B4\uC5B4,
      \uACE7 \uD130\uC9C8 \uAC83 \uAC19\uC544!; \uB0B4 \uC55E\uCE58\uB9C8\uB294 \uB354
      \uC774\uC0C1 \uACAC\uB51C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!; \uB4DC\uB514\uC5B4!~
      \uC774\uC81C \uCC30\uCE75~; \uB4A4\uCABD\uC5D0 \uB354 \uD070 \uC55E\uCE58\uB9C8\uAC00
      \uC788\uB294 \uAC83 \uAC19\uC9C0\uB9CC...; \uB54C\uAC00\uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175664029996437504
    m_Localized: "\uAE30\uBD84\uC774 \uB108\uBB34 \uAF49 \uCC3C\uC5B4\uC694!; \uB098\uC5D0\uAC8C
      \uD3ED\uBC1C\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.; \uADF8\uB4E4\uC740 \uCD9C\uB801\uAC70\uB9AC\uB098\uC694?;
      \uBC8C\uC368 \uB108\uBB34 \uCEE4\uC84C\uC5B4\uC694!; \uC73D, \uC774\uAC83\uC5D0
      \uB300\uD574 \uBB54\uAC00\uB97C \uD560 \uC218 \uC788\uB098\uC694?; \uC0DD\uAC01\uBCF4\uB2E4
      \uC6B0\uC720\uAC00 \uB9CE\uC544\uC694. \uADF8\uAC83\uC774 \uBC14\uB85C \uB0B4\uAC00
      \uCEF5\uC5D0 \uB2F4\uC744 \uC218 \uC788\uB294 \uAC83\uC785\uB2C8\uB2E4.; \uC5B4,
      \uBCF4\uC2A4... \uC774\uAC83 \uC880 \uB3C4\uC640\uC8FC\uC2E4 \uC218 \uC788\uB098\uC694?;
      \uC774\uAC83\uC744 \uC6D0\uD558\uB294 \uACE0\uAC1D\uC774 \uC5C6\uB098\uC694?
      \uBC30\uBD88\uB7EC\uC694...; \uC774\uBCF4\uB2E4 \uB354 \uD3EC\uB9CC\uAC10\uC744
      \uB290\uB084 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4...; \uB3D5\uB2E4? \uC81C\uBC1C?;
      \uD130\uC9C8 \uAC83 \uAC19\uC544...; \uB369\uCE58\uAC00 \uCEE4\uC9C0\uACE0
      \uC2F6\uC740\uB370 \uC774\uAC8C \uC880 \uBD88\uD3B8\uD558\uB124\uC694...; \uC774
      \uC6A9\uB7C9\uC744 \uC624\uB7AB\uB3D9\uC548 \uC720\uC9C0\uD558\uB824\uBA74
      \uB354 \uB192\uC740 \uC6A9\uB7C9\uC774 \uD544\uC694\uD569\uB2C8\uB2E4...; \uAC00!
      \uADF8\uB0E5 \uC816\uC744 \uC9DC\uC8FC\uC138\uC694!; \uC816\uC744 \uC9DC\uC8FC\uC138\uC694!
      \uC816\uC744 \uC9DC\uC8FC\uC138\uC694! \uC81C\uBC1C!; \uBCC4\uB85C \uBD88\uD3B8\uD558\uC9C0
      \uC54A\uC558\uB2E4\uBA74 \uC774\uAC78\uB85C \uD588\uC744\uD150\uB370...; \uC9C0\uCF1C\uBD10\uB3C4
      \uC0C1\uAD00\uC5C6\uC73C\uB2C8 \uADF8\uB0E5 \uBE44\uC6CC\uC8FC\uC138\uC694...;
      \uBAB8\uC774 \uB108\uBB34 \uBD80\uC5B4\uC788\uB294 \uAC83 \uAC19\uC544\uC694!;
      \uB118\uCE58\uC9C0 \uC54A\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4!; \uC6B0\uC720\uAC00
      \uAC00\uB4DD \uB2F4\uAE34 \uD48D\uC120 \uAC19\uC740 \uB290\uB08C!; \uB108\uBB34
      \uB9CE\uC774 \uC6C0\uC9C1\uC774\uB294 \uAC83\uC774 \uB450\uB835\uC2B5\uB2C8\uB2E4!;
      \uC624\uBC84\uD50C\uB85C\uAC00 \uC784\uBC15\uD588\uC2B5\uB2C8\uB2E4! \uC704\uAE09
      \uC2E0\uD638!; \uB9D0 \uADF8\uB300\uB85C \uCEF5\uC774 \uB118\uCE69\uB2C8\uB2E4...;
      \uB0B4\uAC00 \uC815\uBCF4\uB97C \uC720\uCD9C\uD558\uBA74 \uB204\uAC00 \uC54C\uC544\uCC28\uB9B4
      \uAC83 \uAC19\uB098\uC694?; \uBE68\uB9AC \uC2A4\uD2B8\uB808\uC2A4\uB97C \uD480\uC5B4\uC57C
      \uD574\uC694!; \uC624\uBC84\uB4DC\uB77C\uC774\uBE0C\uB97C \uD558\uBA74 \uC6B0\uC720
      \uACF5\uC7A5 \uAC19\uC740 \uB290\uB08C\uC774 \uB4ED\uB2C8\uB2E4!; \uC774\uB9AC\uC800\uB9AC
      \uC3DF\uC544\uC9C0\uB294 \uC6B0\uC720 \uB54C\uBB38\uC5D0 \uC9D1\uC911\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!; \uAC00\uC2B4\uC5D0\uC11C \uD130\uC838 \uB098\uC62C
      \uAC83 \uAC19\uC740 \uB290\uB08C!; \uB3C4\uC640\uC8FC\uC138\uC694. \uC784\uACC4\uB7C9\uC5D0
      \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4!; \uC774\uAC83\uC774 \uADF8\uB4E4\uC774
      '\uC644\uBCBD\uD558\uAC8C \uC6B0\uC720\uB97C \uC9DC\uB2E4'\uB77C\uB294 \uB73B\uC778\uAC00\uC694?;
      \uB9C8\uCE58 \uB099\uB18D\uC7A5\uC744 \uB4E4\uACE0 \uC788\uB294 \uB4EF\uD55C
      \uB290\uB08C!; \uC624\uBC84\uD50C\uB85C \uACBD\uACE0! \uC704\uD5D8, \uC704\uD5D8!;
      \uB098\uB294 \uBD84\uCD9C\uD560 \uC900\uBE44\uAC00 \uB41C \uC6B0\uC720 \uD654\uC0B0\uC785\uB2C8\uB2E4!;
      \uC774 \uC6B0\uC720\uBE5B \uC0B0\uB9CC\uD568\uC73C\uB85C \uC9D1\uC911\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!; \uC774 \uBAA8\uB4E0 \uC6B0\uC720\uB97C \uBC29\uCD9C\uD560
      \uBC29\uBC95\uC744 \uCC3E\uC73C\uBA74 \uB429\uB2C8\uB2E4!; \uC774 \uC6B0\uC720\uD1B5\uC740
      \uD3ED\uBC1C\uD560 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4!;
      \uB098\uB294 \uD3ED\uBC1C\uD560 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 175664836233940992
    m_Localized: "\uC544\uB9C8\uB3C4 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC2DC\uAC04\uC778\uAC00\uC694?;
      \uC5C5\uADF8\uB808\uC774\uB4DC\uC5D0 \uD22C\uC790\uD558\uB294 \uAC83\uC740
      \uACC4\uD68D\uCC98\uB7FC \uB4E4\uB9BD\uB2C8\uB2E4!; \uC5B4\uB5A4 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00
      \uAC00\uB2A5\uD55C\uC9C0 \uC0B4\uD3B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.; \uC774\uC81C
      \uC6B0\uB9AC\uC758 \uC6B4\uC601 \uC218\uC900\uC744 \uB192\uC77C \uB54C\uAC00
      \uB420 \uAC83\uC785\uB2C8\uB2E4.; \uC6B0\uB9AC \uC0AC\uC5C5\uC744 \uAC15\uD654\uD558\uB294
      \uAC83\uC740 \uC720\uC775\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.; \uAC00\uCE58
      \uC788\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uC788\uB294\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4.;
      \uC6B0\uB9AC \uCE74\uD398\uC758 \uC77C\uBD80 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uACE0\uB824 \uC911\uC785\uB2C8\uB2E4.; \uC5C5\uADF8\uB808\uC774\uB4DC \uC635\uC158\uC744
      \uC0B4\uD3B4\uBCF4\uB294 \uAC83\uC774 \uC88B\uC740 \uC0DD\uAC01\uC778 \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4.; \uBA87 \uAC00\uC9C0 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uD1B5\uD574 \uD6A8\uC728\uC131\uC744 \uB192\uC774\uC790!; \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uD1B5\uD574 \uC6B0\uB9AC\uB294 \uC2DC\uC7A5\uC5D0\uC11C \uC6B0\uC704\uB97C
      \uC810\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.; \uC6B0\uB9AC \uBB54\uAC00 \uC0AC\uC57C
      \uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 175666128926822400
    m_Localized: "\uADF8\uAC8C \uB2E4\uC57C, \uADF8\uB9CC\uB480\uC5B4!; \uCD5C\uC545\uC758
      \uC0C1\uC0AC... \uC800\uB294 \uC5EC\uAE30\uC11C \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.;
      \uB108\uBB34 \uC544\uD30C\uC11C \uC77C\uD558\uAE30 \uD798\uB4DC\uB124\uC694.
      \uC548\uB155...; \uC774 \uD63C\uB3C8\uC744 \uCC98\uB9AC\uD558\uB294 \uAC83\uC740
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4! \uADF8\uB9CC\uB480\uC5B4!; \uB354 \uC774\uC0C1
      \uCC38\uC744 \uC218 \uC5C6\uC5B4\uC694! \uB098\uB294 \uB5A0\uB09C\uB2E4!; \uB098\uB294
      \uC774\uAC83\uBCF4\uB2E4 \uB354 \uB098\uC740 \uC790\uACA9\uC774 \uC788\uC2B5\uB2C8\uB2E4!
      \uB098\uB294 \uB098\uAC14\uB2E4!; \uC774 \uC77C\uC740 \uC2A4\uD2B8\uB808\uC2A4\uB97C
      \uBC1B\uC744 \uAC00\uCE58\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. \uB09C \uB05D\uB0AC\uC5B4!;
      \uCEE4\uD53C\uC758 \uC591\uC740 \uC774 \uBC88\uAC70\uB85C\uC6C0\uB9CC\uD07C
      \uAC00\uCE58\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. \uB098\uB294 \uAC14\uB2E4!; \uB09C
      \uCDA9\uBD84\uD788 \uBA39\uC5C8\uC5B4! \uB354 \uB098\uC740 \uAE30\uD68C\uB97C
      \uCC3E\uC744 \uC2DC\uAC04\uC785\uB2C8\uB2E4.; \uB098\uB294 \uC774\uB7EC\uD55C
      \uC870\uAC74\uC5D0\uC11C \uC77C\uD558\uB294 \uAC83\uC744 \uAC70\uBD80\uD569\uB2C8\uB2E4.
      \uADF8\uB9CC\uB480\uC5B4!; \uC774\uB7F0 \uB9D0\uB3C4 \uC548\uB418\uB294 \uC77C\uC744
      \uD558\uAE30\uC5D0\uB294 \uC778\uC0DD\uC774 \uB108\uBB34 \uC9E7\uC2B5\uB2C8\uB2E4.
      \uB098\uB294 \uB5A0\uB09C\uB2E4.; \uBBF8\uC548\uD558\uC9C0\uB9CC \uBC14\uB9AC\uC2A4\uD0C0
      \uC77C\uC740 \uC774\uC81C \uB05D\uB0AC\uC5B4. \uB09C \uC5EC\uAE30\uC11C \uB098\uAC00\uACA0\uC5B4!;
      \uB098\uB294 \uC774\uAC83\uC5D0 \uB4F1\uB85D\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!
      \uADF8\uB9CC\uB480\uC5B4!; \uC78A\uC5B4\uBC84\uB9AC\uC138\uC694, \uB098 \uC9D1\uC5D0
      \uAC08 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 175674616369401856
    m_Localized: "\uC0DD\uC0B0+"
    m_Metadata:
      m_Items: []
  - m_Id: 175674851527249920
    m_Localized: "\uBC14\uB9AC\uC2A4\uD0C0 \uC6B0\uC720 \uC0DD\uC0B0\uC728\uC744
      \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 181788866099826688
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uBA4B\uC9C0\uB124\uC694.; \uC548\uB155,
      \uC544\uB984\uB2E4\uC6CC.; \uC548\uB155 \uD587\uC0B4.; \uC774\uBD10, \uB108
      \uC815\uB9D0 \uB300\uB2E8\uD574 \uBCF4\uC5EC.; \uC548\uB155 \uC774\uC05C \uC544.;
      \uC548\uB155\uD558\uC138\uC694, \uB180\uB78D\uC2B5\uB2C8\uB2E4.; \uC548\uB155,
      \uC608\uC05C \uC544\uAC00\uC528.; \uC548\uB155, \uADC0\uC5FC\uB465\uC774.;
      \uC774\uC57C, \uC798\uC0DD\uACBC\uC5B4.; \uC548\uB155, \uB9E4\uB825.; \uC548\uB155\uD558\uC138\uC694,
      \uCC9C\uC0AC\uB2D8.; \uC548\uB155, \uC778\uD615.; \uC548\uB155 \uC608\uC05C\uC774.;
      \uC57C, \uB108 \uC624\uB298 \uC815\uB9D0 \uC608\uBED0 \uBCF4\uC774\uB294\uAD6C\uB098.;
      \uC548\uB155, \uC608\uC058\uB2E4.; \uC548\uB155, \uC790\uAE30\uC57C.; \uC548\uB155,
      \uC560\uC778.; \uC548\uB155, \uBBF8\uC18C\uAC00 \uC88B\uB124\uC694.; \uC548\uB155\uD558\uC138\uC694,
      \uB9E4\uD639\uC801\uC785\uB2C8\uB2E4.; \uC774\uBD10\uC694, \uB2F9\uC2E0\uC740
      \uBC14\uB97C \uBC1D\uAC8C \uD574\uC8FC\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 181789087093510144
    m_Localized: "\uC548\uB155, \uC544\uB984\uB2E4\uC6CC, \uBBF8\uC18C\uB85C \uB0B4
      \uD558\uB8E8\uB97C \uB354 \uC88B\uAC8C \uB9CC\uB4E4\uC5B4 \uC904 \uC218 \uC788\uB2C8?;
      \uC548\uB155\uD558\uC138\uC694, \uBA4B\uC838\uC694. \uC774\uB807\uAC8C \uC798\uC0DD\uAE34
      \uBE44\uACB0\uC774 \uBB54\uAC00\uC694?; \uC548\uB155\uD558\uC138\uC694, \uBA4B\uC9C0\uB124\uC694.
      \uBA54\uB274\uC5D0 \uD639\uC2DC \uB2F9\uC2E0\uC774 \uD3EC\uD568\uB418\uC5B4
      \uC788\uB098\uC694?; \uC548\uB155\uD558\uC138\uC694, \uC608\uC05C \uC544\uAC00\uC528,
      \uB2F9\uC2E0\uC758 \uC678\uBAA8\uC5D0 \uC5B4\uC6B8\uB9AC\uB294 \uD2B9\uBCC4\uD55C
      \uC74C\uB8CC\uAC00 \uC788\uB098\uC694?; \uC548\uB155\uD558\uC138\uC694, \uB9E4\uB825\uB2D8,
      \uB2F9\uC2E0\uC758 \uBBF8\uC18C\uB294 \uC81C \uD558\uB8E8\uC758 \uD558\uC774\uB77C\uC774\uD2B8\uC785\uB2C8\uB2E4.;
      \uC548\uB155\uD558\uC138\uC694, \uCC9C\uC0AC\uB2D8, \uB2F9\uC2E0\uC758 \uC544\uB984\uB2E4\uC6C0\uC740
      \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uBC29\uC744 \uBC1D\uD600\uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4.;
      \uC548\uB155 \uC778\uD615\uC544, \uC678\uB85C\uC6B4 \uB9C8\uC74C\uC744 \uC704\uD55C
      \uB9C8\uBC95\uC758 \uBB3C\uC57D\uC740 \uC788\uC5B4? \uC548\uB155, \uC790\uAE30\uC57C,
      \uB2F9\uC2E0\uC740 \uBAA8\uB4E0 \uC74C\uB8CC\uB97C \uB2F9\uC2E0\uB9CC\uD07C
      \uB2EC\uCF64\uD558\uAC8C \uB9CC\uB4DC\uB098\uC694?; \uC774\uBD10 \uC790\uAE30\uC57C,
      \uB2F9\uC2E0\uC758 \uC544\uB984\uB2E4\uC6C0\uC740 \uC911\uB3C5\uC131\uC774
      \uC788\uC2B5\uB2C8\uB2E4.; \uC548\uB155, \uC598\uC57C, \uC5EC\uAE30\uC11C\uB294
      \uB2F9\uC2E0\uC758 \uC874\uC7AC\uAC00 \uAC00\uC7A5 \uC88B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 181789098002894848
    m_Localized: "\uC774\uBD10, \uC544\uB984\uB2E4\uC6CC. \uB108\uC758 \uBBF8\uC18C\uC640
      \uADF8 \uACE1\uC120\uC774 \uB0B4 \uC2EC\uC7A5\uC744 \uB6F0\uAC8C \uB9CC\uB4E4\uC5B4.;
      \uC548\uB155\uD558\uC138\uC694, \uB2F9\uC2E0\uC758 \uB208\uB9CC\uD07C \uB9E4\uD639\uC801\uC778
      \uAC83\uC744 \uC81C\uACF5\uD569\uB2C8\uAE4C?; \uC548\uB155\uD558\uC138\uC694,
      \uB180\uB78D\uC2B5\uB2C8\uB2E4. \uC5EC\uAE30\uC11C\uB294 \uB2F9\uC2E0\uC758
      \uBAB8\uB9E4\uAC00 \uC9C4\uC9DC\uC785\uB2C8\uB2E4.; \uC548\uB155, \uC608\uC05C
      \uC544\uAC00\uC528, \uB2F9\uC2E0\uC758 \uC678\uBAA8\uB294 \uC5B4\uB5A4 \uC74C\uB8CC\uB4E0
      \uB354 \uB9DB\uC788\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694.;
      \uC548\uB155\uD558\uC138\uC694 \uCC38\uB2D8, \uB2F9\uC2E0\uC758 \uC544\uB984\uB2E4\uC6C0\uC740
      \uADF8 \uC5B4\uB5A4 \uCE75\uD14C\uC77C\uBCF4\uB2E4 \uC0C1\uD07C\uD569\uB2C8\uB2E4.;
      \uC548\uB155\uD558\uC138\uC694, \uCC9C\uC0AC\uB2D8, \uB2F9\uC2E0\uACFC \uAC19\uC740
      \uBAB8\uB9E4\uB97C \uAC00\uC9C4 \uC0AC\uB78C, \uB204\uAC00 \uC220\uC744 \uB9C8\uC2DC\uACE0
      \uC2F6\uC2B5\uB2C8\uAE4C?; \uC548\uB155, \uC778\uD615\uB2D8, \uB2F9\uC2E0\uC758
      \uACE1\uC120\uC740 \uC544\uB984\uB2E4\uC6C0\uC758 \uC644\uBCBD\uD55C \uC870\uD654\uC785\uB2C8\uB2E4.;
      \uC548\uB155, \uC598\uC57C, \uB124 \uBAB8\uB9E4\uAC00 \uC774 \uBC14\uC758 \uAC00\uC7A5
      \uBA4B\uC9C4 \uBD80\uBD84\uC774\uC57C.; \uC57C \uC790\uAE30\uC57C, \uB108\uC758
      \uBA4B\uC9C4 \uC678\uBAA8\uAC00 \uB098\uB97C \uC5B4\uC9C0\uB7FD\uAC8C \uB9CC\uB4E0\uB2E4.;
      \uC548\uB155, \uC598\uC57C, \uB2F9\uC2E0\uC758 \uC874\uC7AC\uB294 \uBAA8\uB4E0
      \uAC83\uC744 \uB354 \uB2EC\uCF64\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 181789109562396672
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uC544\uB984\uB2F5\uC2B5\uB2C8\uB2E4.
      \uC81C \uCEE4\uD53C\uC5D0 \uB9C8\uBC95\uC744 \uC880 \uB354\uD574 \uC8FC\uC2E4
      \uC218 \uC788\uB098\uC694?; \uC548\uB155\uD558\uC138\uC694, \uBA4B\uC9C0\uB124\uC694.
      \uACE1\uC120\uC774 \uC788\uB294 \uC74C\uB8CC \uC678\uC5D0 \uB2E4\uB978 \uC11C\uBE44\uC2A4\uB3C4
      \uC81C\uACF5\uD558\uC2DC\uB098\uC694?; \uC548\uB155\uD558\uC138\uC694, \uB180\uB78D\uC2B5\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC758 \uAC00\uC2B4\uC774 \uB0B4 \uCEE4\uD53C\uC758 \uAC00\uC7A5
      \uC88B\uC740 \uBD80\uBD84\uC774 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.; \uC548\uB155\uD558\uC138\uC694,
      \uC608\uC05C \uC544\uAC00\uC528, \uBBF8\uC18C\uB098 \uB370\uC774\uD2B8 \uB4F1
      \uBA54\uB274 \uC678\uC758 \uAC83\uC744 \uC81C\uACF5\uD560 \uC218 \uC788\uB098\uC694?;
      \uC548\uB155\uD558\uC138\uC694 \uCC38\uB2D8, \uB2F9\uC2E0\uACFC \uAC19\uC740
      \uBAB8\uB9E4\uB77C\uBA74 \uBB34\uC5C7\uC774\uB4E0 \uC8FC\uBB38\uD558\uACA0\uC2B5\uB2C8\uB2E4.;
      \uC548\uB155\uD558\uC138\uC694, \uCC9C\uC0AC\uB2D8, \uB2F9\uC2E0\uC758 \uC544\uB984\uB2E4\uC6C0\uC740
      \uC5B4\uB5A4 \uC74C\uB8CC\uC5D0\uB3C4 \uC644\uBCBD\uD55C \uC7AC\uB8CC\uC785\uB2C8\uB2E4.;
      \uC548\uB155 \uC778\uD615\uC544, \uB124 \uB9E4\uB825\uC774 \uB2F4\uAE34 \uCEE4\uD53C
      \uD55C\uC794 \uD574\uB3C4 \uB420\uAE4C?; \uC548\uB155, \uC598\uC57C, \uB124
      \uAC00\uC2B4\uC774 \uC624\uB298\uC758 \uC9C4\uC9DC \uD2B9\uBCC4\uD568\uC774\uB2E4.;
      \uC774\uBD10, \uC790\uAE30\uC57C, \uB124\uAC00 \uC5EC\uAE30 \uC788\uC5B4\uC11C
      \uBAA8\uB4E0 \uC220\uC774 \uB354 \uB9DB\uC788\uC5B4\uC9C4\uB2E4.; \uC548\uB155
      \uC560\uC778, \uADF8 \uBA4B\uC9C4 \uBAA8\uC2B5\uC73C\uB85C \uBBF8\uC18C\uB97C
      \uC9D3\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 182195982329466880
    m_Localized: "\uBC14\uB9AC\uC2A4\uD0C0 \uC6B0\uC720 \uC6A9\uB7C9\uC744 \uB298\uB824\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 182196090546704384
    m_Localized: "\uCD5C\uB300 \uD06C\uAE30+"
    m_Metadata:
      m_Items: []
  - m_Id: 182196364988403712
    m_Localized: "\uBC14\uB9AC\uC2A4\uD0C0\uC758 \uAE30\uBD84\uC744 \uC88B\uAC8C
      \uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 182196409754210304
    m_Localized: "\uD589\uBCF5+"
    m_Metadata:
      m_Items: []
  - m_Id: 182196602868355072
    m_Localized: "\uC0DD\uC0B0-"
    m_Metadata:
      m_Items: []
  - m_Id: 182196626104799232
    m_Localized: "\uBC14\uB9AC\uC2A4\uD0C0 \uC6B0\uC720 \uC0DD\uC0B0\uC728\uC774
      \uB0AE\uC544\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 182196763497615360
    m_Localized: "\uC9C0\uAE08 \uC6B0\uC720\uB97C \uB354 \uB9CE\uC774 \uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 182196807076433920
    m_Localized: "\uBC14\uB85C \uBC14\uB9AC\uC2A4\uD0C0\uB97C \uCC44\uC6CC\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 182196916119949312
    m_Localized: "\uCDA9\uB9CC \uD5C8\uC6A9\uCE58+"
    m_Metadata:
      m_Items: []
  - m_Id: 182196947719835648
    m_Localized: "\uBC14\uB9AC\uC2A4\uD0C0\uB294 \uD589\uBCF5\uC744 \uB354 \uCC9C\uCC9C\uD788
      \uC783\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 182201446488363008
    m_Localized: "\uCD5C\uB300\uB294 500\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 182205256204046336
    m_Localized: "\uC544\uC9C1 \uC880 \uB354\uC6B0\uB2C8 \uC870\uC2EC\uD558\uC138\uC694!;
      \uC5EC\uAE30! \uADF8\uAC83\uC740 \uB2F9\uC2E0\uB9CC\uC744 \uC704\uD55C \uC870\uAE08
      \uD2B9\uBCC4\uD55C \uAC83\uC785\uB2C8\uB2E4!; \uC774 \uC62C\uBC14\uB978\uC9C0?;
      \uC8FC\uBB38\uD558\uC138\uC694!~; \uB9C8\uC74C\uAECF \uC990\uACA8\uBCF4\uC138\uC694!;
      \uB098\uB294 \uADF8\uAC83\uC744 \uC88B\uC544\uD558\uBA74 \uC88B\uACA0.; \uC5EC\uAE30
      \uC788\uC2B5\uB2C8\uB2E4. \uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694!;
      \uC790, \uBE68\uB9AC \uB3CC\uC544\uC624\uC138\uC694!~; \uC9DC\uC794! \uB2F9\uC2E0\uB9CC\uC744
      \uC704\uD55C \uB9DE\uCDA4\uD615 \uCC3D\uC791\uBB3C!; \uB098\uB294 \uC774\uAC83\uC5D0
      \uC57D\uAC04\uC758 \uC0AC\uB791\uC744 \uB354\uD588\uC2B5\uB2C8\uB2E4. \uC990\uAE30\uC2ED\uC2DC\uC624!;
      \uC5EC\uAE30 \uC815\uC131\uAECF \uB9CC\uB4E0 \uC74C\uB8CC\uAC00 \uC788\uC2B5\uB2C8\uB2E4!;
      \uB2F9\uC2E0\uC758 \uC8FC\uBB38\uC740 \uC6C3\uB294 \uC5BC\uAD74\uB85C \uC81C\uACF5\uB429\uB2C8\uB2E4!;
      \uC774 \uC74C\uB8CC\uAC00 \uB2F9\uC2E0\uC758 \uD558\uB8E8\uC5D0 \uC791\uC740
      \uAE30\uC068\uC744 \uAC00\uC838\uB2E4\uC8FC\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4!;
      \uB2F9\uC2E0\uB9CC\uC744 \uC704\uD55C \uCEF5 \uC548\uC5D0 \uB2F4\uAE34 \uC644\uBCBD\uD568!;
      \uD55C \uBAA8\uAE08\uC758 \uD589\uBCF5\uC744 \uC990\uACA8\uBCF4\uC138\uC694!;
      \uC74C\uB8CC\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4! \uD55C
      \uBAA8\uAE08 \uB9C8\uC2DC\uACE0 \uB9DB\uBCF4\uC138\uC694!; \uB2F9\uC2E0\uB9CC\uC744
      \uC704\uD574 \uC138\uC2EC\uD558\uAC8C \uC81C\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4!;
      \uC8FC\uBB38\uC774 \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB9DB\uC744
      \uC990\uACA8\uBCF4\uC138\uC694!; \uC5EC\uAE30 \uC644\uBCBD\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC9C4
      \uC74C\uB8CC\uAC00 \uC788\uC2B5\uB2C8\uB2E4!; \uC774 \uC74C\uB8CC\uAC00 \uB2F9\uC2E0\uC758
      \uD558\uB8E8\uB97C \uC870\uAE08 \uB354 \uBC1D\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4!; \uC774 \uC791\uC740 \uC990\uAC70\uC6C0\uC5D0 \uBE60\uC838\uBCF4\uC138\uC694.
      \uBAA8\uB450 \uB2F9\uC2E0\uC758 \uAC83\uC785\uB2C8\uB2E4!; \uB9DB\uC744 \uB290\uAEF4\uBCF4\uC138\uC694!
      \uADF8\uAC83\uC740 \uB2F9\uC2E0\uB9CC\uC744 \uC704\uD574 \uC591\uC870\uB418\uC5C8\uC2B5\uB2C8\uB2E4!;
      \uC5EC\uAE30\uC694! \uB9C8\uC2DC\uACE0 \uC990\uAE30\uC2ED\uC2DC\uC624!; \uB2F9\uC2E0\uC758
      \uC644\uBCBD\uD55C \uCEF5\uC740 \uBBF8\uC18C\uC640 \uD568\uAED8 \uC81C\uACF5\uB429\uB2C8\uB2E4!;
      \uD55C \uBAA8\uAE08 \uB9C8\uC2DC\uACE0 \uC138\uC0C1\uC744 \uB179\uC5EC\uBCF4\uC138\uC694!;
      \uC774 \uC74C\uB8CC\uAC00 \uC5EC\uB7EC\uBD84\uC758 \uAE30\uB300\uB97C \uB6F0\uC5B4\uB118\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4!; \uB2F9\uC2E0\uC758 \uD558\uB8E8\uAC00 \uC774 \uC74C\uB8CC\uB9CC\uD07C
      \uC990\uAC81\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4!; \uB2F9\uC2E0\uC758 \uD558\uB8E8\uAC00
      \uC774 \uC74C\uB8CC\uB9CC\uD07C \uC990\uAC81\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4!;
      \uD55C \uBAA8\uAE08 \uB9C8\uC2DC\uACE0, \uB9DB\uBCF4\uACE0, \uC990\uACA8\uBCF4\uC138\uC694!
      \uADF8\uAC83\uC740 \uB2F9\uC2E0\uC744 \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC84C\uC2B5\uB2C8\uB2E4!;
      \uC5EC\uAE30 \uC788\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC774 \uC88B\uC544\uD558\uB294
      \uBC29\uC2DD\uC774\uC5B4\uC57C \uD569\uB2C8\uB2E4.;"
    m_Metadata:
      m_Items: []
  - m_Id: 219427788485054464
    m_Localized: "\uADF8\uAC83\uC740 \uC633\uC9C0 \uC54A\uC558\uB2E4...@Spoken_Ah;
      \uB2E4\uC2DC \uB3C4\uC804\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4!@Spoken_Ah;
      \uB2E4\uC74C \uBC88\uC5D0\uB294 \uB354 \uC798\uD560 \uAC81\uB2C8\uB2E4!@Spoken_Ah;
      \uC544\uD558! \uB2E4\uC2DC \uB3C4\uC804\uD574 \uBCF4\uC138\uC694...@Spoken_Ah;
      \uADF8\uAC83\uC740 \uC644\uC804\uD788 \uC633\uC9C0 \uC54A\uC558\uB2E4...@Spoken_Ah;
