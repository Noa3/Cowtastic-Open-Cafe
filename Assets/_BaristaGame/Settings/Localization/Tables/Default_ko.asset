  - m_Id: 269212714364928
    m_Localized: "\uC190\uB2D8\uC740 \uAE4C\uB2E4\uB86D\uACE0 \uBC14\uB9AC\uC2A4\uD0C0\uB294
      \uBCC0\uB355\uC2A4\uB7FD\uAE34 \uD558\uC9C0\uB9CC \uC774\uBC88\uC5D0\uB294
