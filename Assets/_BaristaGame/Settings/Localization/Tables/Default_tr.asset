  - m_Id: 167535336119881728
    m_Localized: "Merhaba!; Merhaba.; Ey! g\xFCzellik.; Hey.; Merhaba.; Merhaba!;
      Merhaba...; Hm...; Uuuh...; Uh...; Aha!; Yo.; Merhaba...; Selamlar.; Merhaba
      gen\xE7 bayan. ; Eyo.; Sup.; Uhuh...; Merhaba!; Merhaba!; Hey! Naber?; \u0130yi
      g\xFCnler!; Hola!; Hey! Yabanc\u0131.; Selamlar!; Peki! Merhaba!; Merhaba!
      nas\u0131ls\u0131n?; Merhaba! Seni g\xF6rd\xFC\u011F\xFCme sevindim!; Hey!
      Uzun zamand\u0131r g\xF6r\xFC\u015Fmemi\u015Ftik!; Hey! Yemek ne?; Hey! Nas\u0131l
      gidiyor? Tan\u0131\u015Ft\u0131\u011F\u0131m\u0131za memnun oldum!; Hey! Yenilikler
      neler? Hayat nas\u0131l? Her \u015Fey nas\u0131l? G\xFCn\xFCn nas\u0131l ge\xE7iyor?
      G\xFCn\xFCn nas\u0131l ge\xE7iyor?; Hey! Her \u015Fey nas\u0131l gidiyor? G\xF6r\xFC\u015Fmeyeli
      nas\u0131ls\u0131n?"
    m_Metadata:
      m_Items: []
  - m_Id: 167615756777836544
    m_Localized: "Biraz istiyorum ; Biraz alabilir miyim ; Var m\u0131 ; Sipari\u015F
      verebilir miyim ; Alabilir miyim ; ilgileniyorum ; Almak m\xFCmk\xFCn m\xFC
      ; L\xFCtfen bana ver "
