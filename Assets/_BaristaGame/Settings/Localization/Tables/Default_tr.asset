  - m_Id: 132865428639293440
    m_Localized: "Sat\u0131lan Bardaklar:"
    m_Metadata:
      m_Items: []
  - m_Id: 1661003594297344
    m_Localized: "\xD6zelle\u015Ftirmek"
    m_Metadata:
      m_Items: []
  - m_Id: 1656215754338304
    m_Localized: "Anla\u015Fmazl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 133995165042450432
    m_Localized: "\u0130\xE7ecek Yap\u0131m\u0131"
    m_Metadata:
