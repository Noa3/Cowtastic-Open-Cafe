    m_Metadata:
      m_Items: []
  - m_Id: 1647484102602752
    m_Localized: "Cowtastic Cafe'ye ho\u015F geldiniz!"
    m_Metadata:
      m_Items: []
  - m_Id: 541488361861120
    m_Localized: "\u0130\xE7ecek ba\u015F\u0131na 1,5 dolar de\u011Ferinde"
    m_Metadata:
      m_Items: []
  - m_Id: 541379419009024
    m_Localized: "15 Dolara \u015Eeker Sat\u0131n Al"
