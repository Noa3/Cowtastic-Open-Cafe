    m_Metadata:
      m_Items: []
  - m_Id: 540631339724800
    m_Localized: "\u0130\xE7ecek ba\u015F\u0131na 3 dolar de\u011Ferinde"
    m_Metadata:
      m_Items: []
  - m_Id: 540541439012864
    m_Localized: "50$'a \xC7ay Al"
    m_Metadata:
      m_Items: []
