    m_Localized: "\u0E1F\u0E32\u0E23\u0E4C\u0E21\u0E42\u0E04\u0E19\u0E21\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E15\u0E31\u0E14\u0E2A\u0E34\u0E19\u0E43\u0E08\u0E25\u0E2D\u0E07\u0E40\u0E1B\u0E34\u0E14
