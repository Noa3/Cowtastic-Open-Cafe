      \u0E19\u0E21\u0E17\u0E35\u0E48\u0E40\u0E2A\u0E35\u0E22\u0E44\u0E1B\u0E44\u0E14\u0E49\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E40\u0E2A\u0E21\u0E2D\u3002@Jokes_SpoiledMilkAlwaysGotWhatItWanted;
