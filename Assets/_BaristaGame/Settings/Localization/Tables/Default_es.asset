  - m_Id: 175609102947340288
    m_Localized: "Tama\xF1o m\xE1ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 175609289581285376
    m_Localized: Dinero
    m_Metadata:
      m_Items: []
  - m_Id: 175639638851997696
    m_Localized: Felicidad
    m_Metadata:
      m_Items: []
  - m_Id: 175639931622805504
    m_Localized: "Renunciar\xE1 si esto llega a cero."
    m_Metadata:
      m_Items: []
  - m_Id: 175640078645743616
    m_Localized: Plenitud
    m_Metadata:
      m_Items: []
  - m_Id: 175640229514858496
    m_Localized: Alcanza los 2000 ml para ganar.
