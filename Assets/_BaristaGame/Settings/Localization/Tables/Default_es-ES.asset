    m_Localized: 'Tazas vendidas:'
    m_Metadata:
      m_Items: []
  - m_Id: 133995165042450432
    m_Localized: "Elaboraci\xF3n de bebidas"
    m_Metadata:
      m_Items: []
  - m_Id: 133035279336972288
    m_Localized: Gana $10,000.
    m_Metadata:
      m_Items: []
  - m_Id: 133847226483580928
    m_Localized: Salir del tutorial
