    m_Metadata:
      m_Items: []
  - m_Id: 230078679445504
    m_Localized: "Modo Milky Activado: Pon a prueba tu velocidad mientras la Barista
      se llena cada vez m\xE1s r\xE1pido. \xBFPodras seguirle el ritmo?"
    m_Metadata:
      m_Items: []
  - m_Id: 231146272419840
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 231298777313280
