      \u0398\u03AD\u03BB\u03C9 \u03BD\u03B1 \u03B3\u03AF\u03BD\u03C9 \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF\u03C2,
      \u03B1\u03BB\u03BB\u03AC \u03B1\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BB\u03AF\u03B3\u03BF \u03AC\u03B2\u03BF\u03BB\u03BF...? \u03A7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BC\u03B1\u03B9
      \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7 \u03C7\u03C9\u03C1\u03B7\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03C0\u03BF\u03C1\u03AD\u03C3\u03C9
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03B5\u03AF\u03BD\u03C9 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C0\u03BF\u03BB\u03CD...? \u0393\u03BA\u03B1! \u0391\u03C0\u03BB\u03AC
      \u03AC\u03C1\u03BC\u03B5 \u03BC\u03B5 \u03AE\u03B4\u03B7!? \u0393\u03AC\u03BB\u03B1\u03C3\u03AD
      \u03BC\u03B5! \u0393\u03AC\u03BB\u03B1\u03C3\u03AD \u03BC\u03B5! \u03A3\u03B1\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03BF\u03CD\u03BC\u03B5!; \u0391\u03BD
      \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03C4\u03CC\u03C3\u03BF
      \u03AC\u03B2\u03BF\u03BB\u03BF, \u03B8\u03B1 \u03BC\u03BF\u03C5 \u03AC\u03C1\u03B5\u03C3\u03B5
      \u03B1\u03C5\u03C4\u03CC... \u0394\u03B5\u03BD \u03BC\u03B5 \u03C0\u03B5\u03B9\u03C1\u03AC\u03B6\u03B5\u03B9
      \u03BD\u03B1 \u03B4\u03BF\u03C5\u03BD, \u03B1\u03C0\u03BB\u03AC \u03B1\u03B4\u03B5\u03B9\u03AC\u03C3\u03C4\u03B5
      \u03BC\u03B5 \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE...? \u039D\u03B9\u03CE\u03B8\u03C9
      \u03C4\u03CC\u03C3\u03BF \u03C0\u03C1\u03B7\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2!?
      \u03B5\u03BB\u03C0\u03B9\u03B6\u03C9 \u03BD\u03B1 \u03BC\u03B7\u03BD \u03BE\u03B5\u03C7\u03B5\u03B9\u03BB\u03C9\u03C3\u03C9!?
      \u039D\u03B9\u03CE\u03B8\u03B5\u03B9\u03C2 \u03C3\u03B1\u03BD \u03AD\u03BD\u03B1
      \u03BC\u03C0\u03B1\u03BB\u03CC\u03BD\u03B9 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF
      \u03B3\u03AC\u03BB\u03B1! \u03A6\u03BF\u03B2\u03AC\u03BC\u03B1\u03B9 \u03BD\u03B1
      \u03BA\u03B9\u03BD\u03B7\u03B8\u03CE \u03C0\u03AC\u03C1\u03B1 \u03C0\u03BF\u03BB\u03CD!?
      \u0395\u03C0\u03AF\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03C5\u03C0\u03B5\u03C1\u03C7\u03B5\u03AF\u03BB\u03B9\u03C3\u03B7!
      \u03A3\u03A5\u039D\u0398\u0397\u039C\u0391 \u039A\u0399\u039D\u0394\u03A5\u039D\u039F\u03A5!;
      \u03A4\u03B1 \u03C6\u03BB\u03B9\u03C4\u03B6\u03AC\u03BD\u03B9\u03B1 \u03BC\u03BF\u03C5
      \u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03BD, \u03BA\u03C5\u03C1\u03B9\u03BF\u03BB\u03B5\u03BA\u03C4\u03B9\u03BA\u03AC...?
      \u03A0\u03B9\u03C3\u03C4\u03B5\u03CD\u03B5\u03C4\u03B5 \u03CC\u03C4\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03B8\u03B1 \u03C4\u03BF \u03C0\u03C1\u03BF\u03C3\u03AD\u03BE\u03B5\u03B9
      \u03B1\u03BD \u03B4\u03B9\u03AD\u03C1\u03C1\u03B5\u03C5\u03C3\u03B1; \u03A0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03BA\u03C4\u03BF\u03BD\u03CE\u03C3\u03C9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03B1
      \u03C0\u03AF\u03B5\u03C3\u03B7, \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1!
      \u0391\u03B9\u03C3\u03B8\u03AC\u03BD\u03BF\u03BC\u03B1\u03B9 \u03C3\u03B1\u03BD
      \u03AD\u03BD\u03B1 \u03B5\u03C1\u03B3\u03BF\u03C3\u03C4\u03AC\u03C3\u03B9\u03BF
      \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2 \u03C3\u03B5 \u03C5\u03C0\u03B5\u03C1\u03B2\u03BF\u03BB\u03B9\u03BA\u03AE
      \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7! \u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03CE
      \u03BD\u03B1 \u03B5\u03C3\u03C4\u03B9\u03AC\u03C3\u03C9 \u03BC\u03B5 \u03CC\u03BB\u03BF
      \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03B3\u03AC\u03BB\u03B1 \u03BD\u03B1
      \u03C7\u03B1\u03B6\u03B5\u03CD\u03B5\u03B9! \u039D\u03B9\u03CE\u03B8\u03C9
      \u03C3\u03B1\u03BD \u03BD\u03B1 \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03BE\u03B5\u03C3\u03C0\u03AC\u03C3\u03BF\u03C5\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C3\u03C4\u03AE\u03B8\u03BF\u03C2 \u03BC\u03BF\u03C5! \u0392\u03BF\u03B7\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03BC\u03B5 \u03B5\u03B4\u03CE, \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03C3\u03B5 \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7 \u03BC\u03AC\u03B6\u03B1!?
      \u0391\u03C5\u03C4\u03CC \u03B5\u03BD\u03BD\u03BF\u03BF\u03CD\u03BD \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03CC\u03C1\u03BF \xAB\u03AC\u03C1\u03BC\u03B5\u03B3\u03BC\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C4\u03B5\u03BB\u03B5\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\xBB;
      \u039D\u03B9\u03CE\u03B8\u03C9 \u03C3\u03B1\u03BD \u03BD\u03B1 \u03BA\u03BF\u03C5\u03B2\u03B1\u03BB\u03AC\u03C9
      \u03BC\u03B9\u03B1 \u03C6\u03AC\u03C1\u03BC\u03B1 \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03BF\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2!
      \u03A0\u03C1\u03BF\u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03C5\u03C0\u03B5\u03C1\u03C7\u03B5\u03AF\u03BB\u03B9\u03C3\u03B7\u03C2! \u039A\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2,
      \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2! \u0395\u03AF\u03BC\u03B1\u03B9
      \u03AD\u03BD\u03B1 \u03B7\u03C6\u03B1\u03AF\u03C3\u03C4\u03B5\u03B9\u03BF \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2
      \u03AD\u03C4\u03BF\u03B9\u03BC\u03BF \u03BD\u03B1 \u03B5\u03BA\u03C1\u03B1\u03B3\u03B5\u03AF!
      \u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1 \u03B5\u03C3\u03C4\u03B9\u03AC\u03C3\u03C9
      \u03BC\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03CE\u03B4\u03B7
      \u03B1\u03C0\u03CC\u03C3\u03C0\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE\u03C2!
      \u0391\u03C0\u03BB\u03AC \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
      \u03B2\u03C1\u03BF\u03CD\u03BC\u03B5 \u03AD\u03BD\u03B1\u03BD \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03BD\u03B1 \u03B1\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03CE\u03C3\u03B5\u03C4\u03B5
      \u03CC\u03BB\u03BF \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03B3\u03AC\u03BB\u03B1!?
      \u0391\u03C5\u03C4\u03AD\u03C2 \u03BF\u03B9 \u03BA\u03B1\u03BD\u03AC\u03C4\u03B5\u03C2
      \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AD\u03C4\u03BF\u03B9\u03BC\u03B5\u03C2 \u03BD\u03B1 \u03B5\u03BA\u03C1\u03B1\u03B3\u03BF\u03CD\u03BD!
      \u03B8\u03B1 \u03B5\u03BA\u03C1\u03B1\u03B3\u03CE."
    m_Metadata:
      m_Items: []
  - m_Id: 175664836233940992
    m_Localized: "\u039C\u03AE\u03C0\u03C9\u03C2 \u03AE\u03C1\u03B8\u03B5 \u03B7
      \u03CE\u03C1\u03B1 \u03B3\u03B9\u03B1 \u03B1\u03BD\u03B1\u03B2\u03AC\u03B8\u03BC\u03B9\u03C3\u03B7;
      \u0397 \u03B5\u03C0\u03AD\u03BD\u03B4\u03C5\u03C3\u03B7 \u03C3\u03B5 \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03BF\u03B9\u03AC\u03B6\u03B5\u03B9 \u03BC\u03B5 \u03C3\u03C7\u03AD\u03B4\u03B9\u03BF!
      \u0391\u03C2 \u03B4\u03BF\u03CD\u03BC\u03B5 \u03C0\u03BF\u03B9\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B5\u03C2. \u038A\u03C3\u03C9\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03B9\u03C1\u03CC\u03C2 \u03BD\u03B1
      \u03B2\u03B5\u03BB\u03C4\u03B9\u03CE\u03C3\u03BF\u03C5\u03BC\u03B5 \u03C4\u03B9\u03C2
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03BC\u03B1\u03C2. \u0397 \u03B5\u03BD\u03AF\u03C3\u03C7\u03C5\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03C3\u03AE\u03C2
      \u03BC\u03B1\u03C2 \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C0\u03C9\u03C6\u03B5\u03BB\u03AE\u03C2.
      \u0391\u03BD\u03B1\u03C1\u03C9\u03C4\u03B9\u03AD\u03BC\u03B1\u03B9 \u03B1\u03BD
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B1\u03BE\u03B9\u03CC\u03BB\u03BF\u03B3\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2. \u039B\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C5\u03C0\u03CC\u03C8\u03B7 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03BF \u03BA\u03B1\u03C6\u03AD \u03BC\u03B1\u03C2. \u0397 \u03B4\u03B9\u03B5\u03C1\u03B5\u03CD\u03BD\u03B7\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03CE\u03BD \u03B1\u03BD\u03B1\u03B2\u03AC\u03B8\u03BC\u03B9\u03C3\u03B7\u03C2
      \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BA\u03B1\u03BB\u03AE \u03B9\u03B4\u03AD\u03B1.
      \u0391\u03C2 \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03AC
      \u03BC\u03B1\u03C2 \u03BC\u03B5 \u03BC\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2! \u039F\u03B9
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2 \u03B8\u03B1
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B1\u03BD \u03BD\u03B1 \u03BC\u03B1\u03C2
      \u03B4\u03CE\u03C3\u03BF\u03C5\u03BD \u03AD\u03BD\u03B1 \u03C0\u03BB\u03B5\u03BF\u03BD\u03AD\u03BA\u03C4\u03B7\u03BC\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC. \u039D\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03AC\u03C4\u03B9;"
    m_Metadata:
      m_Items: []
  - m_Id: 175666128926822400
    m_Localized: "\u0391\u03C5\u03C4\u03CC \u03AE\u03C4\u03B1\u03BD, \u03C4\u03B1
      \u03C0\u03B1\u03C1\u03AC\u03C4\u03B7\u03C3\u03B1!? \u03A4\u03BF \u03C7\u03B5\u03B9\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF
      \u03B1\u03C6\u03B5\u03BD\u03C4\u03B9\u03BA\u03CC \u03C0\u03BF\u03C4\u03AD...
      \u0395\u03AF\u03BC\u03B1\u03B9 \u03AD\u03BE\u03C9 \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE.
      \u03A0\u03BF\u03BD\u03AC\u03C9 \u03C0\u03BF\u03BB\u03CD \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03B4\u03BF\u03C5\u03BB\u03AD\u03C8\u03C9, \u03B1\u03BD\u03C4\u03AF\u03BF...?
      \u0388\u03C7\u03C9 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9 \u03BC\u03B5
      \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C7\u03AC\u03BF\u03C2! \u03A0\u03B1\u03C1\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B1\u03B9!;
      \u0394\u03B5\u03BD \u03B1\u03BD\u03C4\u03AD\u03C7\u03C9 \u03AC\u03BB\u03BB\u03BF!
      \u03A6\u03B5\u03CD\u03B3\u03C9!; \u039C\u03BF\u03C5 \u03B1\u03BE\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03CC!
      \u0395\u03AF\u03BC\u03B1\u03B9 \u03B5\u03BA\u03C4\u03CC\u03C2!; \u0391\u03C5\u03C4\u03AE
      \u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC \u03B4\u03B5\u03BD \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03BF \u03AC\u03B3\u03C7\u03BF\u03C2. \u03A4\u03B5\u03BB\u03B5\u03AF\u03C9\u03C3\u03B1!;
      \u039A\u03B1\u03BC\u03AF\u03B1 \u03C0\u03BF\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03C6\u03AD \u03B4\u03B5\u03BD \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD \u03C4\u03B1\u03BB\u03B1\u03B9\u03C0\u03C9\u03C1\u03AF\u03B1.
      \u0395\u03C7\u03C9 \u03C6\u03CD\u03B3\u03B5\u03B9!; \u0391\u03C1\u03BA\u03B5\u03C4\u03AC
      \u03B1\u03BD\u03AD\u03C7\u03C4\u03B7\u03BA\u03B1! \u038F\u03C1\u03B1 \u03BD\u03B1
      \u03B2\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03B5\u03C5\u03BA\u03B1\u03B9\u03C1\u03AF\u03B1. \u0391\u03C1\u03BD\u03BF\u03CD\u03BC\u03B1\u03B9
      \u03BD\u03B1 \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03CE \u03C5\u03C0\u03CC
      \u03B1\u03C5\u03C4\u03AD\u03C2 \u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03B8\u03AE\u03BA\u03B5\u03C2.
      \u03A0\u03B1\u03C1\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B1\u03B9!; \u0397
      \u03B6\u03C9\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03BB\u03CD
      \u03BC\u03B9\u03BA\u03C1\u03AE \u03B3\u03B9\u03B1 \u03B1\u03C5\u03C4\u03AD\u03C2
      \u03C4\u03B9\u03C2 \u03B1\u03BD\u03BF\u03B7\u03C3\u03AF\u03B5\u03C2. \u03A6\u03B5\u03CD\u03B3\u03C9.;
      \u03A3\u03C5\u03B3\u03B3\u03BD\u03CE\u03BC\u03B7, \u03B1\u03BB\u03BB\u03AC
      \u03C4\u03B5\u03BB\u03B5\u03AF\u03C9\u03C3\u03B1 \u03BD\u03B1 \u03C0\u03B1\u03AF\u03B6\u03C9
      barista. \u0395\u03AF\u03BC\u03B1\u03B9 \u03AD\u03BE\u03C9 \u03B1\u03C0\u03CC
      \u03B5\u03B4\u03CE! \u0394\u03B5\u03BD \u03AD\u03B3\u03C1\u03B1\u03C8\u03B1
      \u03B3\u03B9\u03B1 \u03B1\u03C5\u03C4\u03CC! \u03A0\u03B1\u03C1\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B1\u03B9!;
      \u039E\u03AD\u03C7\u03BD\u03B1 \u03C4\u03BF, \u03C0\u03AC\u03C9 \u03C3\u03C0\u03AF\u03C4\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 175674616369401856
    m_Localized: "\u03A0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE+"
