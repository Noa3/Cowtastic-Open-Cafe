  - m_Id: 133034372322926592
    m_Localized: "\u0394\u03BF\u03C5\u03BB\u03B5\u03CD\u03C9 \u03C5\u03C0\u03B5\u03C1\u03C9\u03C1\u03AF\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 134010572390375424
    m_Localized: "\u0395\u03BE\u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03C0\u03B5\u03BB\u03B1\u03C4\u03CE\u03BD"
    m_Metadata:
      m_Items: []
  - m_Id: 134010918655336448
    m_Localized: "\u03A0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03AD\u03C7\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B7, \u03BF\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9
      \u03B5\u03B4\u03CE \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BD\u03B1
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03CD\u03BF\u03C5\u03BD \u03CC\u03C4\u03B1\u03BD
      \u03BC\u03B9\u03B1 \u03BA\u03BF\u03C0\u03AD\u03BB\u03B1 \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03B3\u03B1\u03BB\u03CC\u03C3\u03C9\u03BC\u03B7 \u03BA\u03B1\u03B9
      \u03B3\u03B5\u03BC\u03AC\u03C4\u03B7, \u03BF\u03C0\u03CC\u03C4\u03B5 \u03B7
      \u03B5\u03BD\u03C4\u03C5\u03C0\u03C9\u03C3\u03B9\u03B1\u03BA\u03AE \u03B9\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03BC\u03AD\u03B3\u03B5\u03B8\u03CC\u03C2
      \u03C4\u03B7\u03C2 \u03B8\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
      \u03C4\u03C1\u03B1\u03B2\u03AE\u03BE\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE
      \u03C4\u03C9\u03BD \u03C0\u03B5\u03BB\u03B1\u03C4\u03CE\u03BD \u03CC\u03C3\u03BF
      \u03C0\u03B5\u03C1\u03BD\u03AC\u03B5\u03B9 \u03BF \u03BA\u03B1\u03B9\u03C1\u03CC\u03C2.\n\n\u0391\u03BB\u03BB\u03AC
      \u03C0\u03BF\u03B9\u03BF \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BD\u03CC\u03B7\u03BC\u03B1
      \u03C3\u03C4\u03BF\u03C5\u03C2 \u03B5\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2;  \u039B\u03BF\u03B9\u03C0\u03CC\u03BD,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B1\u03C1\u03AD\u03C3\u03B5\u03B9 \u03BA\u03AC\u03C4\u03B9 \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD
      \u03C3\u03C4\u03BF \u03C0\u03BF\u03C4\u03CC \u03C4\u03BF\u03C5\u03C2, \u03B1\u03BD
      \u03C4\u03BF \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03B7
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03AE \u03C4\u03BF\u03C5\u03C2!  \u0388\u03BD\u03B1
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF \u03C3\u03C5\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03BF\u03C5 \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9 \u03C0\u03BF\u03BB\u03BB\u03AC
      \u03BB\u03B5\u03C6\u03C4\u03AC...!"
    m_Metadata:
      m_Items: []
  - m_Id: 134011413927141376
    m_Localized: "\u03A7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03B1
      \u03B3\u03B5\u03B3\u03BF\u03BD\u03CC\u03C4\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 134011680659709952
    m_Localized: "\u039C\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03C6\u03BF\u03C1\u03AD\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B8\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03B9\u03C3\u03C4\u03BF\u03CD\u03BD
      \u03C3\u03C5\u03BC\u03B2\u03AC\u03BD\u03C4\u03B1 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03B1.\n\n\u039C\u03B5\u03C1\u03B9\u03BA\u03AC
      \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03AC \u03C4\u03B1 \u03B3\u03B5\u03B3\u03BF\u03BD\u03CC\u03C4\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C4\u03BF\u03C5\u03BD \u03C0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B7,
      \u03BC\u03B5\u03C1\u03B9\u03BA\u03AC \u03C3\u03B1\u03C2 \u03B4\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03AD\u03BD\u03B1 \u03B1\u03C0\u03B1\u03C1\u03B1\u03AF\u03C4\u03B7\u03C4\u03BF
      \u03B4\u03B9\u03AC\u03BB\u03B5\u03B9\u03BC\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C1\u03B9\u03BA\u03AC
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03BF \u03B1\u03BD\u03CC\u03B7\u03C4\u03B1.\n\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B1 \u03B3\u03B5\u03B3\u03BF\u03BD\u03CC\u03C4\u03B1 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BC\u03B2\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03AE\u03C3\u03C4\u03B5 \u03BD\u03B1
      \u03BC\u03B7\u03BD \u03C0\u03B1\u03C1\u03B1\u03C3\u03C5\u03C1\u03B8\u03B5\u03AF\u03C4\u03B5
      \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03AC!"
    m_Metadata:
      m_Items: []
  - m_Id: 134179468267331584
    m_Localized: "\u0395\u03BD\u03CE \u03C0\u03B1\u03AF\u03B6\u03B5\u03C4\u03B5 \u03C3\u03B5
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 arcade, \u03C4\u03BF
      \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF
      \u03CC\u03C0\u03BF\u03C5 \u03B2\u03C1\u03AF\u03C3\u03BA\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AD\u03C2
      \u03C3\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD barista \u03C3\u03B1\u03C2. 
      \u0397 \u03B1\u03CD\u03BE\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5 \u03C1\u03C5\u03B8\u03BC\u03BF\u03CD
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03C4\u03B7\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B2\u03C1\u03B5\u03B8\u03B5\u03AF \u03B5\u03BA\u03B5\u03AF. 
      \u039C\u03B1\u03B6\u03AF \u03BC\u03B5 \u03B5\u03BD\u03B9\u03C3\u03C7\u03C5\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7\u03C2.\n\n\u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03AD\u03BD\u03B1 \u03BC\u03B5\u03BD\u03BF\u03CD
      \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE\u03C2 \u03BC\u03B5
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03C1\u03BF\u03CD\u03C7\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03C7\u03C1\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD.\n\u039F\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF
      \u03BD\u03B1 \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03C9\u03B8\u03BF\u03CD\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 134179994149167104
    m_Localized: "\u039E\u03B5\u03BA\u03AF\u03BD\u03B1 \u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9"
    m_Metadata:
      m_Items: []
  - m_Id: 134180089527640064
    m_Localized: "\u03A4\u03BF \u03C6\u03C1\u03BF\u03BD\u03C4\u03B9\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5"
    m_Metadata:
      m_Items: []
  - m_Id: 134180290938118144
    m_Localized: "\u0391\u03C5\u03C4\u03CC \u03B8\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2
      \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B9\u03B5\u03C5\u03BA\u03C1\u03B9\u03BD\u03B9\u03C3\u03C4\u03BF\u03CD\u03BD.\n\u039F
      \u03B2\u03C1\u03CC\u03C7\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BE\u03B5\u03BA\u03AC\u03B8\u03B1\u03C1\u03BF\u03C2, \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03C0\u03BF\u03C4\u03AC, \u03BD\u03B1 \u03B2\u03B3\u03AC\u03BB\u03B5\u03B9
      \u03BB\u03B5\u03C6\u03C4\u03AC, \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C0\u03BF\u03C4\u03AC,
      \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD barista \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF,
      \u03BD\u03B1 \u03B2\u03B3\u03AC\u03B6\u03B5\u03B9 \u03B1\u03BA\u03CC\u03BC\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03BD\u03B1 \u03B5\u03C0\u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03BC\u03AD\u03C7\u03C1\u03B9 \u03C4\u03BF moo.\n\n\u0391\u03BD \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5
      \u03BC\u03B9\u03B1 \u03C0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B7, \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03BD\u03B1 \u03B2\u03C1\u03B5\u03AF\u03C4\u03B5 \u03AD\u03BE\u03C5\u03C0\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03B9\u03BA\u03AD\u03C2 \u03AE \u03BD\u03B1
      \u03B1\u03BD\u03B1\u03B2\u03B1\u03B8\u03BC\u03AF\u03C3\u03B5\u03C4\u03B5 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AD\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2 \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5\u03C2. 
      \u0391\u03BD \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B2\u03B5\u03BB\u03C4\u03B9\u03CE\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C3\u03BA\u03AD\u03B4\u03B1\u03C3\u03B7,
      \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03C3\u03B5\u03C4\u03B5
      \u03BC\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2
      \u03C1\u03BF\u03CD\u03C7\u03C9\u03BD!  \u03A3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7, \u03B1\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5
      \u03C4\u03BF\u03BD \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03CE\u03B4\u03B7 \u03BA\u03B1\u03C6\u03AD
      \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
