      $"
    m_Metadata:
      m_Items: []
  - m_Id: 549811962343424
    m_Localized: "\u03A3\u03AC\u03BB\u03C4\u03C3\u03B1 \u03BA\u03B1\u03C1\u03B1\u03BC\u03AD\u03BB\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 1683534711713792
    m_Localized: "\u03A4\u03BF \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03BF\u03BA\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03C3\u03B1\u03C2 \u03B1\u03B3\u03C1\u03CC\u03BA\u03C4\u03B7\u03BC\u03B1 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B9\u03C3\u03B5
      \u03C0\u03C1\u03CC\u03C3\u03C6\u03B1\u03C4\u03B1 \u03BD\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03B5\u03B9
      \u03BD\u03B1 \u03B1\u03BD\u03BF\u03AF\u03BE\u03B5\u03B9 \u03AD\u03BD\u03B1
      \"\u03BA\u03B1\u03C6\u03B5\u03C4\u03AD\u03C1\u03B9\u03B1 \u03B1\u03B3\u03B5\u03BB\u03AC\u03B4\u03C9\u03BD\"
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03BC\u03AC\u03C1\u03BA\u03B5\u03C4\u03B9\u03BD\u03B3\u03BA,
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03C3\u03B1\u03BD \u03AD\u03BD\u03B1\u03C2
      \u03C0\u03BF\u03BB\u03CD \u03BA\u03B1\u03BB\u03CC\u03C2 \u03C4\u03C1\u03CC\u03C0\u03BF\u03C2
      \u03BD\u03B1 \u03B4\u03CE\u03C3\u03B5\u03C4\u03B5 \u03C3\u03C4\u03B1 \u03BD\u03AD\u03B1
      \u03BA\u03BF\u03C1\u03AF\u03C4\u03C3\u03B9\u03B1 \u03B1\u03B3\u03B5\u03BB\u03AC\u03B4\u03B1\u03C2
      \u03BA\u03AC\u03C4\u03B9 \u03BD\u03B1 \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03B5\u03BD\u03CE \u03C4\u03B1 \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03B6\u03B5\u03C4\u03B5
      \u03B3\u03B9\u03B1 \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03BF\u03BA\u03BF\u03BC\u03B9\u03BA\u03AC
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1.\n\n\u039F \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2
      \u03C3\u03B1\u03C2 barista \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B8\u03BF\u03C5\u03C3\u03B9\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AC\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF\u03C2
      \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2, \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03BD\u03B1 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03AE\u03C3\u03B5\u03B9
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2 \u03B5\u03BD\u03CE
      \u03C4\u03B7\u03BD \u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C3\u03C4\u03B5 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7 \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03CE\u03B4\u03B7
      \u03B4\u03CD\u03BD\u03B1\u03BC\u03AE \u03C4\u03B7\u03C2!\n\n\u03A4\u03BF \u03BA\u03B1\u03C6\u03AD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03B9\u03BD\u03BF\u03CD\u03C1\u03B3\u03B9\u03BF,
      \u03B5\u03C0\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2 \u03B8\u03B1 \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF
      \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03C4\u03B5 \u03BA\u03B1\u03B9\u03BD\u03BF\u03CD\u03C1\u03B3\u03B9\u03B1
      \u03C5\u03BB\u03B9\u03BA\u03AC \u03C3\u03C4\u03B7\u03BD \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1.\n\u0395\u03C5\u03C4\u03C5\u03C7\u03CE\u03C2
      \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03CC\u03C4\u03B9 \u03BF\u03B9
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2 \u03B5\u03B4\u03CE \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03CD \u03B4\u03B5\u03BA\u03C4\u03B9\u03BA\u03BF\u03AF \u03C3\u03C4\u03B7\u03BD
      \u03B9\u03B4\u03AD\u03B1 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03BF\u03C5\u03BD
      \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03B3\u03B9\u03B1 \u03BB\u03AF\u03B3\u03BF
      \u03C6\u03C1\u03AD\u03C3\u03BA\u03BF \u200B\u200B\u03B3\u03AC\u03BB\u03B1 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1, \u03B5\u03AC\u03BD
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03C4\u03B7 \u03C3\u03C9\u03C3\u03C4\u03AE
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7.\n\n\u0395\u03AC\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C3\u03C4\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B7 \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE,
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03AD\u03C2
      \u03B5\u03C1\u03B3\u03B1\u03BB\u03B5\u03AF\u03C9\u03BD \u03C0\u03BF\u03C5 \u03C4\u03BF\u03C0\u03BF\u03B8\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BD\u03C4\u03B9\u03BA\u03B9\u03BF\u03CD."
    m_Metadata:
      m_Items: []
  - m_Id: 1683396865912832
    m_Localized: "\u039A\u03B1\u03BB\u03CE\u03C2 \u03AE\u03C1\u03B8\u03B1\u03C4\u03B5
      \u03C3\u03C4\u03BF Cowtastic Cafe!"
    m_Metadata:
      m_Items: []
  - m_Id: 1684540275126272
    m_Localized: "\u038A\u03C3\u03C9\u03C2 \u03AD\u03C0\u03C1\u03B5\u03C0\u03B5 \u03BD\u03B1
      \u03B5\u03AF\u03C7\u03B1\u03C4\u03B5 \u03BC\u03B5\u03AF\u03BD\u03B5\u03B9 \u03C3\u03C0\u03AF\u03C4\u03B9
      \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1, \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF
      \u03C4\u03BF \u03BA\u03B1\u03C6\u03AD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03B5
      \u03C7\u03AC\u03BF\u03C2 \u03BA\u03B1\u03B8\u03CE\u03C2 \u03CC\u03BB\u03B1
      \u03C4\u03B1 \u03C4\u03C1\u03B5\u03BB\u03AC \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B1
      \u03C3\u03C5\u03BC\u03B2\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD \u03B5\u03B4\u03CE! 
      \u03A0\u03BF\u03B9\u03B5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03AD\u03C2
      \u03BF\u03B9 \u03C4\u03B9\u03BC\u03AD\u03C2;  \u0393\u03B9\u03B1\u03C4\u03AF
      \u03CC\u03BB\u03B1 \u03B1\u03C5\u03C4\u03AC \u03C3\u03C5\u03BC\u03B2\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC
      \u03C0\u03BF\u03C5 \u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BD\u03B1\u03C2
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B7\u03C2;\n\n\u0393\u03B5\u03B9\u03B1, \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03B2\u03C1\u03AE\u03BA\u03B1\u03C4\u03B5 \u03C4\u03BF
      \u03BC\u03B9\u03BA\u03C1\u03CC \u03BC\u03B1\u03C2 \u03C0\u03B1\u03C3\u03C7\u03B1\u03BB\u03B9\u03BD\u03CC
      \u03B1\u03C5\u03B3\u03CC, \u03AF\u03C3\u03C9\u03C2 \u03BD\u03B1 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03AF\u03BE\u03B5\u03C4\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
      \u03BC\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1, \u03B1\u03BD
      \u03BC\u03B5 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03C4\u03BF \u03B2\u03C1\u03AE\u03BA\u03B1\u03C4\u03B5 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C3\u03B1\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C0\u03AC\u03B8\u03B5\u03B9\u03B1.\n\n\u0398\u03B1
      \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF\u03C4\u03B5 \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2
      \u03B3\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF
      \u03C0\u03CE\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF
      \u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03BE\u03B5\u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC
      \u03C4\u03BF \u03C7\u03AC\u03BF\u03C2, \u03AE \u03CC\u03C7\u03B9... \u0395\u03B9\u03BB\u03B9\u03BA\u03C1\u03B9\u03BD\u03AC,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BD\u03B9\u03BA\u03B7\u03B8\u03B5\u03AF; 
      \u039C\u03CC\u03BD\u03BF \u03AD\u03BD\u03B1\u03C2 \u03C4\u03C1\u03CC\u03C0\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03AC\u03B8\u03B5\u03C4\u03B5.\n\n\u0395\u03C0\u03AF\u03C3\u03B7\u03C2
      \u03B5\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03CE \u03B3\u03B9\u03B1 \u03C4\u03BF
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9!"
    m_Metadata:
      m_Items: []
