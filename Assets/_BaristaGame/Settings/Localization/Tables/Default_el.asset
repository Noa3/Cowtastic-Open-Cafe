      \u03B8\u03B1 \u03B5\u03AF\u03C7\u03B1\u03BC\u03B5 \u03C4\u03CC\u03C3\u03B1
      \u03C0\u03BF\u03BB\u03BB\u03AC \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03B1 \u03BC\u03B1\u03C2! @Spoken_Hm; \u0391\u03C1\u03C7\u03AF\u03B6\u03C9
      \u03BD\u03B1 \u03BD\u03BF\u03BC\u03AF\u03B6\u03C9 \u03CC\u03C4\u03B9 \u03B5\u03AF\u03BC\u03B1\u03C3\u03C4\u03B5
      \u03C3\u03C4\u03B7 \u03BB\u03AC\u03B8\u03BF\u03C2 \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03C3\u03B7,
      \u03BC\u03B5 \u03C4\u03CC\u03C3\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1!
      @Spoken_Hm; \u03A4\u03B1 \u03BA\u03AD\u03C1\u03B4\u03B7 \u03BC\u03B1\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C4\u03B1 \u03CD\u03C8\u03B7 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1!
      @Spoken_Hm; \u0395\u03AF\u03BD\u03B1\u03B9 \u03C3\u03B1\u03BD \u03BD\u03B1
      \u03B4\u03B9\u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03BC\u03B5 \u03BC\u03B9\u03B1
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03C3\u03B7 \u03B5\u03BA\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7\u03C2
      \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03AF \u03B3\u03B9\u03B1
      \u03BA\u03B1\u03C6\u03B5\u03C4\u03AD\u03C1\u03B9\u03B1! @Spoken_Hm; \u0388\u03C7\u03BF\u03C5\u03BC\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03CC,\u03C4\u03B9 \u03BE\u03AD\u03C1\u03BF\u03C5\u03BC\u03B5
      \u03C4\u03B9 \u03BD\u03B1 \u03C4\u03B1 \u03BA\u03AC\u03BD\u03BF\u03C5\u03BC\u03B5!
      @Spoken_Hm; \u03A0\u03BF\u03C4\u03AD \u03B4\u03B5\u03BD \u03AD\u03C7\u03C9
      \u03B4\u03B5\u03B9 \u03C4\u03CC\u03C3\u03B1 \u03C0\u03BF\u03BB\u03BB\u03AC
      \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C3\u03B5 \u03AD\u03BD\u03B1
      \u03BC\u03AD\u03C1\u03BF\u03C2! @Spoken_Hm; \u03A3\u03AE\u03BC\u03B5\u03C1\u03B1
      \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AC \u03C0\u03BD\u03B9\u03B3\u03CC\u03BC\u03B1\u03C3\u03C4\u03B5
      \u03C3\u03C4\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1! @Spoken_Hm;
      \u039C\u03B5 \u03CC\u03BB\u03B1 \u03B1\u03C5\u03C4\u03AC \u03C4\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B1\u03BC\u03B5 \u03BD\u03B1
      \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7
      \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7! @Spoken_Hm; \u0395\u03BC\u03BC,
      \u03B1\u03C6\u03B5\u03BD\u03C4\u03B9\u03BA\u03CC, \u03B8\u03C5\u03BC\u03AC\u03C3\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1
      \u03BE\u03BF\u03B4\u03AD\u03C8\u03B5\u03B9\u03C2 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03C3\u03C9\u03C3\u03C4\u03AC; @Spoken_Hm"
