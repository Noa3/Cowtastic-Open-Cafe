  - m_Id: 133031481403088896
    m_Localized: "\u039B\u03AC\u03C4\u03C1\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 132754228769300480
    m_Localized: "\u0393\u03AC\u03BB\u03B1 \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9:"
    m_Metadata:
      m_Items: []
  - m_Id: 1661098758860800
    m_Localized: "\u03A4\u03CD\u03C0\u03BF\u03C2 \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 132867783132815360
    m_Localized: "\u0393\u03B1\u03BB\u03B1\u03BA\u03C4\u03CE\u03B4\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 229470362759168
    m_Localized: Milky Mode
    m_Metadata:
      m_Items: []
  - m_Id: 230078679445504
    m_Localized: "\u0395\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      Milky Mode:\n\u0394\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03C4\u03B7\u03BD
      \u03C4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03AC \u03C3\u03B1\u03C2 \u03BA\u03B1\u03B8\u03CE\u03C2
      \u03C4\u03BF Barista \u03B3\u03B5\u03BC\u03AF\u03B6\u03B5\u03B9 \u03CC\u03BB\u03BF
      \u03BA\u03B1\u03B9 \u03C0\u03B9\u03BF \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1. 
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C3\u03C5\u03BC\u03B2\u03B1\u03B4\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03B1\u03B6\u03AF \u03C4\u03B7\u03C2;"
    m_Metadata:
      m_Items: []
  - m_Id: 132865505260838912
    m_Localized: "\u039A\u03B5\u03C1\u03B4\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1:"
    m_Metadata:
      m_Items: []
  - m_Id: 133035228871106560
    m_Localized: Moonopoly
    m_Metadata:
      m_Items: []
  - m_Id: 1663875916591104
    m_Localized: "\u03A0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF
      \u03B3\u03AC\u03BB\u03B1, \u03C4\u03CE\u03C1\u03B1!"
    m_Metadata:
      m_Items: []
  - m_Id: 1655167128006656
    m_Localized: "\u039C\u039F\u03A5\u03A3\u0399\u039A\u0397"
    m_Metadata:
      m_Items: []
  - m_Id: 133998653654802432
    m_Localized: "\u0394\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5
      Barista \u03C3\u03B1\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 133998700043804672
    m_Localized: "\u039F \u03B1\u03C0\u03CE\u03C4\u03B5\u03C1\u03BF\u03C2 \u03C3\u03C4\u03CC\u03C7\u03BF\u03C2
      \u03C3\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BD\u03B1 \u03C6\u03AD\u03C1\u03B5\u03C4\u03B5
      \u03C4\u03B7 barista \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF \u03BC\u03AD\u03B3\u03B9\u03C3\u03C4\u03BF
      \u03C4\u03C9\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD
      \u03C4\u03B7\u03C2, \u03B1\u03BB\u03BB\u03AC \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03B5\u03BB\u03AE\u03C3\u03B5\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03C5\u03C4\u03C5\u03C7\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03CC\u03C3\u03BF \u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9. 
      \u03A0\u03AE\u03C1\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
      \u03B5\u03BB\u03C0\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03C2 \u03BD\u03B1 \u03BA\u03B5\u03C1\u03B4\u03AF\u03C3\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B1\u03B3\u03C9\u03B3\u03AE \u03C3\u03B5
      \u03BC\u03B9\u03B1 \u03B8\u03AD\u03C3\u03B7 \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03BF\u03BA\u03BF\u03BC\u03AF\u03B1\u03C2,
      \u03B1\u03BB\u03BB\u03AC \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BA\u03B9 \u03B1\u03BD
      \u03B1\u03C5\u03C4\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
      \u03C4\u03C9\u03BD \u03BF\u03BD\u03B5\u03AF\u03C1\u03C9\u03BD \u03C4\u03B7\u03C2,
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03BC\u03B5\u03AF\u03BD\u03B5\u03B9 \u03B5\u03BA\u03B5\u03AF
      \u03B1\u03BD \u03B3\u03AF\u03BD\u03B5\u03B9 \u03C0\u03BF\u03BB\u03CD \u03B4\u03C5\u03C3\u03C4\u03C5\u03C7\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7.\n\n\u0395\u03BE\u03B9\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03AE\u03C3\u03C4\u03B5
      \u03C4\u03B7 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03AE \u03C4\u03B7\u03C2
      \u03B5\u03BD\u03CE \u03C0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B1 \u03C3\u03B7\u03BC\u03B5\u03B9\u03CE\u03BD\u03B5\u03C4\u03B5
      \u03C0\u03C1\u03CC\u03BF\u03B4\u03BF \u03C3\u03C4\u03BF \u03BC\u03AD\u03B3\u03B5\u03B8\u03CC\u03C2
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2, \u03BA\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2 \u03C7\u03B1\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03BD\u03B1 \u03C4\u03B7\u03BD \u03B1\u03B4\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B5
      \u03C4\u03B1\u03BA\u03C4\u03B9\u03BA\u03AC, \u03B8\u03B1 \u03C4\u03B7 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03AE\u03C3\u03B5\u03B9 \u03C4\u03B7
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03AE \u03C4\u03B7\u03C2 \u03C8\u03B7\u03BB\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 133998785406279680
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03C5\u03C4\u03C5\u03C7\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03BB\u03B7\u03C1\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5
      barista \u03C3\u03B1\u03C2 \u03B5\u03B4\u03CE.  \u0391\u03BD \u03B7 \u03B5\u03C5\u03C4\u03C5\u03C7\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03AD\u03C3\u03B5\u03B9 \u03C3\u03C4\u03BF 0, \u03C0\u03B1\u03C1\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9.\n\n\u038C\u03C3\u03BF
      \u03BA\u03B9 \u03B1\u03BD \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BD\u03B1 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CE\u03C3\u03B5\u03B9,
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1
      \u03C4\u03B7\u03BD \u03BA\u03C1\u03B1\u03C4\u03AC\u03C4\u03B5 \u03C0\u03BF\u03BB\u03CD
      \u03B3\u03B5\u03BC\u03AC\u03C4\u03B7 \u03CC\u03BB\u03B7 \u03C4\u03B7\u03BD
      \u03CE\u03C1\u03B1, \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC
      \u03BF \u03C0\u03CC\u03BD\u03BF\u03C2 \u03B8\u03B1 \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C3\u03C4\u03B1\u03C4\u03CE\u03C3\u03B5\u03B9,
      \u03B1\u03BB\u03BB\u03AC \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03B4\u03B5\u03BD
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C4\u03B7\u03BD \u03BA\u03C1\u03B1\u03C4\u03AC\u03C4\u03B5
      \u03B5\u03BD\u03C4\u03B5\u03BB\u03CE\u03C2 \u03AC\u03B4\u03B5\u03B9\u03B1 \u03CC\u03BB\u03B7
      \u03C4\u03B7\u03BD \u03CE\u03C1\u03B1 \u03AE \u03B1\u03C5\u03C4\u03CC \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C4\u03B7\u03BD \u03B5\u03BD\u03BF\u03C7\u03BB\u03AE\u03C3\u03B5\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 , \u03BF\u03C0\u03CC\u03C4\u03B5 \u03C0\u03C1\u03BF\u03C3\u03C0\u03B1\u03B8\u03AE\u03C3\u03C4\u03B5
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C4\u03CD\u03C7\u03B5\u03C4\u03B5 \u03BC\u03B9\u03B1
      \u03B9\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03AF\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 133847557804236800
    m_Localized: "\u0395\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF"
    m_Metadata:
      m_Items: []
  - m_Id: 133055089148010496
    m_Localized: "\u039A\u03B1\u03BC\u03AF\u03B1 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE"
    m_Metadata:
      m_Items: []
  - m_Id: 132870450861154304
    m_Localized: "\u039A\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03CC\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 266676540370944
    m_Localized: "\u03A0\u03B1\u03AF\u03BE\u03C4\u03B5 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03BF Barista \u03C3\u03B1\u03C2 \u03BD\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9
      \u03CC\u03C3\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03AE \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03BD\u03B1 \u03B8\u03C5\u03BC\u03CE\u03C3\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03BD\u03B1 \u03C4\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9."
    m_Metadata:
