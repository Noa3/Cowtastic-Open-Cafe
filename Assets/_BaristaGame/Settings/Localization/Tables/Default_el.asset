  - m_Id: 175234412265361408
    m_Localized: "\u03A3\u03BF\u03BA\u03BF\u03BB\u03AC\u03C4\u03B1"
    m_Metadata:
      m_Items: []
  - m_Id: 175234481072918528
    m_Localized: "\u0394\u03B9\u03B1\u03C3\u03BA\u03AD\u03B4\u03B1\u03C3\u03B7"
    m_Metadata:
      m_Items: []
  - m_Id: 175274055513952256
    m_Localized: "\u0395\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03CE!; \u039C\u03BF\u03C5
      \u03AC\u03C1\u03B5\u03C3\u03B5 \u03B7 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC. \u0389\u03C4\u03B1\u03BD
      \u03C4\u03AD\u03BB\u03B5\u03B9\u03B1!; \u03A4\u03BF \u03B1\u03B3\u03AC\u03C0\u03B7\u03C3\u03B1!;
      \u0391\u03C1\u03B9\u03C3\u03C4\u03B7 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C3\u03B7!;
      \u039D\u03CC\u03C3\u03C4\u03B9\u03BC\u03BF \u03C0\u03BF\u03C4\u03CC!; \u03A3\u03C5\u03BD\u03B9\u03C3\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03BD\u03B5\u03C0\u03B9\u03C6\u03CD\u03BB\u03B1\u03BA\u03C4\u03B1!?
      \u03A5\u03C0\u03AD\u03C1\u03BF\u03C7\u03B7 \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1!?
      \u03A6\u03B1\u03BD\u03C4\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2!; \u039A\u03B1\u03C4\u03B1\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C3\u03B7!? \u039C\u03BF\u03C5
      \u03AC\u03C1\u03B5\u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B3\u03BF\u03C5\u03BB\u03B9\u03AC!
      \u0391\u03C1\u03B9\u03C3\u03C4\u03BF!; \u0394\u03B5\u03BD \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF!?
      \u03A4\u03AD\u03BB\u03B5\u03B9\u03BF \u03C0\u03BF\u03C4\u03CC!? \u03A6\u03BF\u03B2\u03B5\u03C1\u03AE
      \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C3\u03B7!? \u0391\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03B1\u03C5\u03C4\u03CC \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B5\u03B9\u03B1\u03B6\u03CC\u03BC\u03BF\u03C5\u03BD!?
      \u039A\u03B1\u03BB\u03AE \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC!; \u03A3\u03C5\u03BD\u03AD\u03C7\u03B9\u03C3\u03B5
      \u03AD\u03C4\u03C3\u03B9!? \u03A3\u03AF\u03B3\u03BF\u03C5\u03C1\u03B1 \u03B8\u03B1
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C8\u03B5\u03B9!? \u0395\u03BD\u03C4\u03C5\u03C0\u03C9\u03C3\u03B9\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2!"
    m_Metadata:
      m_Items: []
  - m_Id: 175274128738111488
    m_Localized: "\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B1\u03C5\u03C4\u03CC
      \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AE\u03B3\u03B3\u03B5\u03B9\u03BB\u03B1.
      \u0394\u03B5\u03BD \u03C4\u03BF \u03B6\u03AE\u03C4\u03B7\u03C3\u03B1 \u03B1\u03C5\u03C4\u03CC.?
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC
      \u03C0\u03BF\u03C5 \u03AE\u03B8\u03B5\u03BB\u03B1. \u039B\u03C5\u03C0\u03BF\u03CD\u03BC\u03B1\u03C3\u03C4\u03B5,
      \u03B1\u03BB\u03BB\u03AC \u03B1\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BB\u03AC\u03B8\u03BF\u03C2. \u039C\u03B5 \u03C3\u03C5\u03B3\u03C7\u03C9\u03C1\u03B5\u03AF\u03C4\u03B5,
      \u03B1\u03BB\u03BB\u03AC \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C3\u03C9\u03C3\u03C4\u03CC. \u039B\u03C5\u03C0\u03AC\u03BC\u03B1\u03B9,
      \u03B1\u03BB\u03BB\u03AC \u03B7 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03BC\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AC\u03B8\u03BF\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5 \u03BD\u03B1 \u03C4\u03BF
      \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03C3\u03BF\u03C5\u03BC\u03B5 \u03B1\u03C5\u03C4\u03CC;
      \u0398\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B1\u03C4\u03B5 \u03BD\u03B1
      \u03B5\u03BB\u03AD\u03B3\u03BE\u03B5\u03C4\u03B5 \u03BE\u03B1\u03BD\u03AC \u03C4\u03B7\u03BD
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03BC\u03BF\u03C5;
      \u039D\u03BF\u03BC\u03AF\u03B6\u03C9 \u03CC\u03C4\u03B9 \u03AD\u03B3\u03B9\u03BD\u03B5
      \u03BB\u03AC\u03B8\u03BF\u03C2. \u03C0\u03B1\u03C1\u03AE\u03B3\u03B3\u03B5\u03B9\u03BB\u03B1
      \u03BA\u03AC\u03C4\u03B9 \u03AC\u03BB\u03BB\u03BF.? \u0391\u03C5\u03C4\u03CC
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC
      \u03C0\u03BF\u03C5 \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B1. \u039C\u03C0\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5
      \u03BD\u03B1 \u03BB\u03CD\u03C3\u03BF\u03C5\u03BC\u03B5 \u03B1\u03C5\u03C4\u03CC
      \u03C4\u03BF \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1; \u03A5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9
      \u03BC\u03C0\u03AD\u03C1\u03B4\u03B5\u03BC\u03B1; \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03C4\u03B5
      \u03B4\u03B9\u03C0\u03BB\u03CC \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF; \u0395\u03AF\u03BC\u03B1\u03B9
      \u03BB\u03AF\u03B3\u03BF \u03B1\u03C0\u03BF\u03B3\u03BF\u03B7\u03C4\u03B5\u03C5\u03BC\u03AD\u03BD\u03BF\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03BF
      \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03C3\u03B5\u03C4\u03B5 \u03B3\u03B9\u03B1
      \u03BC\u03AD\u03BD\u03B1; \u0394\u03B5\u03BD \u03B5\u03AF\u03BC\u03B1\u03B9
      \u03B9\u03BA\u03B1\u03BD\u03BF\u03C0\u03BF\u03B9\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5 \u03B1\u03C5\u03C4\u03CC. \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03CC \u03C0\u03BF\u03C5 \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B1."
