  - m_Id: 175674851527249920
    m_Localized: "\u0391\u03CD\u03BE\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C0\u03BF\u03C3\u03BF\u03C3\u03C4\u03BF\u03CD
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2
      Barista."
    m_Metadata:
      m_Items: []
  - m_Id: 181788866099826688
    m_Localized: "\u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03C0\u03B1\u03BD\u03AD\u03BC\u03BF\u03C1\u03C6\u03BF.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03CC\u03BC\u03BF\u03C1\u03C6\u03B5.;
      \u0393\u03B5\u03B9\u03AC \u03C3\u03BF\u03C5 \u03B7\u03BB\u03B9\u03B1\u03C7\u03C4\u03AF\u03B4\u03B1.;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03C6\u03B1\u03AF\u03BD\u03B5\u03C3\u03B1\u03B9
      \u03BA\u03B1\u03C4\u03B1\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE. \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5 \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC. \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5, \u03B5\u03BA\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7
      \u03BA\u03C5\u03C1\u03AF\u03B1. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5
      \u03B3\u03BB\u03CD\u03BA\u03B1.; \u0395 \u03CC\u03BC\u03BF\u03C1\u03C6\u03B5.;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03B3\u03BF\u03CD\u03C1\u03B9.
      \u0393\u03B5\u03B9\u03AC \u03C3\u03BF\u03C5 \u03AC\u03B3\u03B3\u03B5\u03BB\u03B5.;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BA\u03BF\u03CD\u03BA\u03BB\u03B1.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC
      \u03BC\u03BF\u03C5.; \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03B5\u03AF\u03C3\u03B1\u03B9
      \u03C5\u03C0\u03AD\u03C1\u03BF\u03C7\u03BF\u03C2 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7.;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03BC\u03C9\u03C1\u03CC.; \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5, hottie. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03C9\u03C1\u03B1\u03AF\u03BF
      \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF. \u0393\u03B5\u03B9\u03B1,
      \u03BC\u03B1\u03B3\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE. \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5, \u03C6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9\u03C2 \u03C4\u03B7\u03BD
      \u03BC\u03C0\u03AC\u03C1\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 181789087093510144
    m_Localized: "\u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03BC\u03BF\u03C5
      \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C4\u03B7 \u03BC\u03AD\u03C1\u03B1
      \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7 \u03BC\u03B5 \u03AD\u03BD\u03B1
      \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF; \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5 \u03C0\u03B1\u03BD\u03AD\u03BC\u03BF\u03C1\u03C6\u03B7,
      \u03C0\u03BF\u03B9\u03BF \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03BF\u03C5 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9\u03C2
      \u03C4\u03CC\u03C3\u03BF \u03C9\u03C1\u03B1\u03AF\u03B1; \u0393\u03B5\u03B9\u03B1
      \u03C3\u03B1\u03C2, \u03B5\u03BA\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE,
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03BD\u03B1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03C3\u03C4\u03BF \u03BC\u03B5\u03BD\u03BF\u03CD;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7
      \u03BA\u03C5\u03C1\u03AF\u03B1, \u03AD\u03C7\u03B5\u03B9\u03C2 \u03AD\u03BD\u03B1
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC \u03C0\u03BF\u03C4\u03CC \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03AE \u03C3\u03BF\u03C5;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03B3\u03BF\u03CD\u03C1\u03B9,
      \u03C4\u03BF \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03CC \u03C3\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03B1\u03C0\u03BF\u03BA\u03BF\u03C1\u03CD\u03C6\u03C9\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B1\u03C2 \u03BC\u03BF\u03C5.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03AC\u03B3\u03B3\u03B5\u03BB\u03B5,
      \u03B7 \u03BF\u03BC\u03BF\u03C1\u03C6\u03B9\u03AC \u03C3\u03BF\u03C5 \u03B8\u03B1
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1 \u03C6\u03C9\u03C4\u03AF\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C0\u03B9\u03BF \u03C3\u03BA\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC
      \u03B4\u03C9\u03BC\u03AC\u03C4\u03B9\u03BF. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5,
      \u03BA\u03BF\u03CD\u03BA\u03BB\u03B1, \u03AD\u03C7\u03B5\u03B9\u03C2 \u03BC\u03B1\u03B3\u03B9\u03BA\u03AC
      \u03C6\u03AF\u03BB\u03C4\u03C1\u03B1 \u03B3\u03B9\u03B1 \u03BC\u03B9\u03B1
      \u03BC\u03BF\u03BD\u03B1\u03C7\u03B9\u03BA\u03AE \u03BA\u03B1\u03C1\u03B4\u03B9\u03AC;
      \u0393\u03B5\u03B9\u03B1, \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC \u03BC\u03BF\u03C5,
      \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2 \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03C0\u03BF\u03C4\u03AC
      \u03C4\u03CC\u03C3\u03BF \u03B3\u03BB\u03C5\u03BA\u03AC \u03CC\u03C3\u03BF
      \u03B5\u03C3\u03CD; \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BC\u03C9\u03C1\u03CC
      \u03BC\u03BF\u03C5, \u03B7 \u03BF\u03BC\u03BF\u03C1\u03C6\u03B9\u03AC \u03C3\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B5\u03B8\u03C5\u03C3\u03C4\u03B9\u03BA\u03AE.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, hottie, \u03B7 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
      \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1 \u03B5\u03B4\u03CE."
    m_Metadata:
      m_Items: []
  - m_Id: 181789098002894848
    m_Localized: "\u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7,
      \u03C4\u03BF \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03CC \u03C3\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03AD\u03C2 \u03BF\u03B9 \u03BA\u03B1\u03BC\u03C0\u03CD\u03BB\u03B5\u03C2
      \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD \u03BA\u03B1\u03C1\u03B4\u03B9\u03AC
      \u03BC\u03BF\u03C5 \u03BD\u03B1 \u03C7\u03C4\u03C5\u03C0\u03AC\u03B5\u03B9
      \u03B4\u03C5\u03BD\u03B1\u03C4\u03AC. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5,
      \u03C0\u03B1\u03BD\u03AD\u03BC\u03BF\u03C1\u03C6\u03B7, \u03C3\u03B5\u03C1\u03B2\u03AF\u03C1\u03B5\u03B9\u03C2
      \u03BA\u03AC\u03C4\u03B9 \u03C4\u03CC\u03C3\u03BF \u03BC\u03B1\u03B3\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03CC\u03C3\u03BF \u03C4\u03B1 \u03BC\u03AC\u03C4\u03B9\u03B1 \u03C3\u03BF\u03C5;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03B1\u03C2, \u03B5\u03BA\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE,
      \u03B7 \u03C6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B1 \u03C3\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1
      \u03B5\u03B4\u03CE. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7
      \u03BA\u03C5\u03C1\u03AF\u03B1, \u03B7 \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03AE
      \u03C3\u03BF\u03C5 \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03C0\u03BF\u03C4\u03CC \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B3\u03B5\u03CD\u03C3\u03B7.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03B3\u03BF\u03CD\u03C1\u03B9,
      \u03B7 \u03BF\u03BC\u03BF\u03C1\u03C6\u03B9\u03AC \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C0\u03B9\u03BF \u03B1\u03BD\u03B1\u03B6\u03C9\u03BF\u03B3\u03BF\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03CC \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03BA\u03BF\u03BA\u03C4\u03AD\u03B9\u03BB. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5,
      \u03AC\u03B3\u03B3\u03B5\u03BB\u03B5, \u03BC\u03B5 \u03C3\u03CE\u03BC\u03B1
      \u03C3\u03B1\u03BD \u03C4\u03BF \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5,
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03AD\u03BD\u03B1 \u03C0\u03BF\u03C4\u03CC; \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5,
      \u03BA\u03BF\u03CD\u03BA\u03BB\u03B1, \u03BF\u03B9 \u03BA\u03B1\u03BC\u03C0\u03CD\u03BB\u03B5\u03C2
      \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03C4\u03AD\u03BB\u03B5\u03B9\u03BF\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC\u03C2 \u03BF\u03BC\u03BF\u03C1\u03C6\u03B9\u03AC\u03C2.
      \u0393\u03B5\u03B9\u03B1, \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC \u03BC\u03BF\u03C5,
      \u03B7 \u03C6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B1 \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C4\u03BF \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03B1\u03C5\u03C4\u03BF\u03CD \u03C4\u03BF\u03C5 \u03BC\u03C0\u03B1\u03C1.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BC\u03C9\u03C1\u03CC \u03BC\u03BF\u03C5,
      \u03B7 \u03B5\u03BA\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5
      \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03BC\u03B5 \u03B6\u03B1\u03BB\u03AF\u03B6\u03B5\u03B9.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03C6\u03AF\u03BB\u03B5, \u03B7
      \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C3\u03BF\u03C5 \u03C4\u03B1
      \u03BA\u03AC\u03BD\u03B5\u03B9 \u03CC\u03BB\u03B1 \u03C0\u03B9\u03BF \u03B3\u03BB\u03C5\u03BA\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 181789109562396672
    m_Localized: "\u0393\u03B5\u03B9\u03B1, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7,
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5 \u03BB\u03AF\u03B3\u03B7
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BC\u03B1\u03B3\u03B5\u03AF\u03B1 \u03C3\u03B1\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C6\u03AD \u03BC\u03BF\u03C5; \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5, \u03C0\u03B1\u03BD\u03AD\u03BC\u03BF\u03C1\u03C6\u03B7,
      \u03C3\u03B5\u03C1\u03B2\u03AF\u03C1\u03B5\u03B9\u03C2 \u03BA\u03AC\u03C4\u03B9
      \u03AC\u03BB\u03BB\u03BF \u03B5\u03BA\u03C4\u03CC\u03C2 \u03B1\u03C0\u03CC
      \u03C0\u03BF\u03C4\u03AC \u03BC\u03B5 \u03B1\u03C5\u03C4\u03AD\u03C2 \u03C4\u03B9\u03C2
      \u03BA\u03B1\u03BC\u03C0\u03CD\u03BB\u03B5\u03C2; \u0393\u03B5\u03B9\u03B1
      \u03C3\u03B1\u03C2, \u03B5\u03BA\u03C0\u03BB\u03B7\u03BA\u03C4\u03B9\u03BA\u03AE,
      \u03C4\u03BF \u03BC\u03C0\u03BF\u03CD\u03C3\u03C4\u03BF \u03C3\u03B1\u03C2
      \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
      \u03BC\u03AD\u03C1\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C6\u03AD
      \u03BC\u03BF\u03C5. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7
      \u03BA\u03C5\u03C1\u03AF\u03B1, \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03BA\u03AC\u03C4\u03B9 \u03B5\u03BA\u03C4\u03CC\u03C2 \u03BC\u03B5\u03BD\u03BF\u03CD,
      \u03CC\u03C0\u03C9\u03C2 \u03AD\u03BD\u03B1 \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF
      \u03AE \u03AD\u03BD\u03B1 \u03C1\u03B1\u03BD\u03C4\u03B5\u03B2\u03BF\u03CD;
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03B3\u03BF\u03CD\u03C1\u03B9,
      \u03BC\u03B5 \u03C3\u03CE\u03BC\u03B1 \u03C3\u03B1\u03BD \u03C4\u03BF \u03B4\u03B9\u03BA\u03CC
      \u03C3\u03BF\u03C5, \u03B8\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B3\u03B3\u03B5\u03B9\u03BB\u03B1
      \u03BF\u03C4\u03B9\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5. \u0393\u03B5\u03B9\u03B1
      \u03C3\u03BF\u03C5, \u03AC\u03B3\u03B3\u03B5\u03BB\u03B5, \u03B7 \u03BF\u03BC\u03BF\u03C1\u03C6\u03B9\u03AC
      \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C4\u03AD\u03BB\u03B5\u03B9\u03BF
      \u03C3\u03C5\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03BF\u03C4\u03CC. \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BA\u03BF\u03CD\u03BA\u03BB\u03B1,
      \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1 \u03C0\u03B9\u03C9 \u03AD\u03BD\u03B1\u03BD
      \u03BA\u03B1\u03C6\u03AD \u03BC\u03B5 \u03AD\u03BD\u03B1 \u03AC\u03B3\u03B3\u03B9\u03B3\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03B3\u03BF\u03B7\u03C4\u03B5\u03AF\u03B1\u03C2 \u03C3\u03BF\u03C5;
      \u0393\u03B5\u03B9\u03B1, \u03B3\u03BB\u03C5\u03BA\u03B9\u03AC \u03BC\u03BF\u03C5,
      \u03C4\u03BF \u03BC\u03C0\u03BF\u03CD\u03C3\u03C4\u03BF \u03C3\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C0\u03AD\u03C3\u03B9\u03B1\u03BB \u03C4\u03B7\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B1\u03C2.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BC\u03C9\u03C1\u03CC \u03BC\u03BF\u03C5,
      \u03B7 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C3\u03BF\u03C5
      \u03B5\u03B4\u03CE \u03BA\u03AC\u03BD\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03BF\u03C4\u03CC \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF.
      \u0393\u03B5\u03B9\u03B1 \u03C3\u03BF\u03C5, hottie, \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03AD\u03BD\u03B1 \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF \u03BC\u03B5
      \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD \u03C5\u03C0\u03AD\u03C1\u03BF\u03C7\u03B7
      \u03C6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B1;"
    m_Metadata:
      m_Items: []
  - m_Id: 182195982329466880
    m_Localized: "\u0391\u03C5\u03BE\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7\u03BD \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2 Barista."
