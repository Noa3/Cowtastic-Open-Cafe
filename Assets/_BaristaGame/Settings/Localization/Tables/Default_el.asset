      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03C1\u03CC\u03BC\u03BF\u03C5\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03B1 \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C4\u03AD\u03BB\u03BF\u03C2! 
