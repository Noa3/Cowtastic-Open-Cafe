  - m_Id: 182196626104799232
    m_Localized: "\u03A7\u03B1\u03BC\u03B7\u03BB\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2
      \u03C1\u03C5\u03B8\u03BC\u03CC\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2
      \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2 Barista."
    m_Metadata:
