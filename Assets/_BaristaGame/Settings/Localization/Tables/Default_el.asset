      \u03B3\u03B1\u03BB\u03B1!  \u03A4\u03B9 \u03BA\u03B1\u03BD\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03BD???  \u03A4\u03B7\u03BD \u03AD\u03C7\u03B5\u03C4\u03B5 \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03AD\u03C8\u03B5\u03B9
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03B1\u03C0\u03CD\u03B8\u03BC\u03B5\u03BD\u03BF
      \u03C0\u03B7\u03B3\u03AC\u03B4\u03B9 \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2,
