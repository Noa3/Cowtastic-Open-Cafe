    m_Metadata:
      m_Items: []
  - m_Id: 182196364988403712
    m_Localized: "\u0392\u03B5\u03BB\u03C4\u03B9\u03CE\u03C3\u03C4\u03B5 \u03C4\u03B7
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7 \u03C4\u03BF\u03C5 Barista."
