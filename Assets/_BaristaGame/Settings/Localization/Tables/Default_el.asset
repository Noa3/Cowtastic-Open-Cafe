  - m_Id: 182196947719835648
    m_Localized: "\u039F Barista \u03C7\u03AC\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03C5\u03C4\u03C5\u03C7\u03AF\u03B1 \u03C0\u03B9\u03BF \u03B1\u03C1\u03B3\u03AC."
    m_Metadata:
      m_Items: []
  - m_Id: 182201446488363008
    m_Localized: "\u03A4\u03BF \u03BC\u03AD\u03B3\u03B9\u03C3\u03C4\u03BF \u03B5\u03AF\u03BD\u03B1\u03B9
      500"
    m_Metadata:
      m_Items: []
  - m_Id: 182205256204046336
    m_Localized: "\u03A0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE, \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BB\u03AF\u03B3\u03BF \u03B6\u03AD\u03C3\u03C4\u03B7!?
      \u0395\u03B4\u03CE! \u0395\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03BF
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF, \u03BC\u03CC\u03BD\u03BF
      \u03B3\u03B9\u03B1 \u03C3\u03AD\u03BD\u03B1!? \u0395\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03CC \u03C3\u03C9\u03C3\u03C4\u03CC;; \u03A0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03AF\u03BB\u03B5\u03C4\u03B5!~;
      \u0391\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC
      \u03C3\u03B1\u03C2! \u0395\u03BB\u03C0\u03AF\u03B6\u03C9 \u03BD\u03B1 \u03C3\u03B1\u03C2
      \u03B1\u03C1\u03AD\u03C3\u03B5\u03B9.; \u039F\u03C1\u03AF\u03C3\u03C4\u03B5,
      \u03BD\u03B1 \u03AD\u03C7\u03B5\u03C4\u03B5 \u03BC\u03B9\u03B1 \u03C5\u03C0\u03AD\u03C1\u03BF\u03C7\u03B7
      \u03BC\u03AD\u03C1\u03B1! \u039F\u03C1\u03AF\u03C3\u03C4\u03B5, \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C8\u03C4\u03B5
      \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B1!~; Voil! \u0397 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C3\u03B1\u03C2,
      \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2! \u0388\u03B2\u03B1\u03BB\u03B1
      \u03BB\u03AF\u03B3\u03B7 \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03B1\u03B3\u03AC\u03C0\u03B7
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC, \u03B1\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5!?
      \u0395\u03B4\u03CE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC
      \u03C3\u03B1\u03C2, \u03C6\u03C4\u03B9\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03BC\u03B5 \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE! \u0397 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03C3\u03B1\u03C2, \u03C3\u03B5\u03C1\u03B2\u03AF\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF! \u0395\u03AF\u03B8\u03B5
      \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC \u03BD\u03B1
      \u03C6\u03AD\u03C1\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B7 \u03C7\u03B1\u03C1\u03AC
      \u03C3\u03C4\u03B7 \u03BC\u03AD\u03C1\u03B1 \u03C3\u03B1\u03C2! \u03A4\u03B5\u03BB\u03B5\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03C6\u03BB\u03B9\u03C4\u03B6\u03AC\u03BD\u03B9,
      \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2! \u0391\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5
      \u03C4\u03B7 \u03B3\u03BF\u03C5\u03BB\u03B9\u03AC \u03C4\u03B7\u03C2 \u03B5\u03C5\u03C4\u03C5\u03C7\u03AF\u03B1\u03C2
      \u03C3\u03B1\u03C2! \u03A4\u03BF \u03C0\u03BF\u03C4\u03CC \u03C3\u03B1\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9! \u03A0\u03B9\u03B5\u03AF\u03C4\u03B5
      \u03BA\u03B1\u03B9 \u03B3\u03B5\u03C5\u03C4\u03B5\u03AF\u03C4\u03B5!? \u03A6\u03C4\u03B9\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03BC\u03B5 \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B4\u03B1, \u03BC\u03CC\u03BD\u03BF
      \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2! \u0397 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03C3\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03C4\u03BF\u03B9\u03BC\u03B7,
      \u03B1\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03B3\u03B5\u03CD\u03C3\u03B7!
      \u0395\u03B4\u03CE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC
      \u03C3\u03B1\u03C2, \u03C6\u03C4\u03B9\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03C3\u03C4\u03B7\u03BD \u03C4\u03B5\u03BB\u03B5\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1!
      \u0395\u03BB\u03C0\u03AF\u03B6\u03C9 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF
      \u03C0\u03BF\u03C4\u03CC \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03C4\u03B7
      \u03BC\u03AD\u03C1\u03B1 \u03C3\u03B1\u03C2 \u03BB\u03AF\u03B3\u03BF \u03C0\u03B9\u03BF
      \u03C6\u03C9\u03C4\u03B5\u03B9\u03BD\u03AE! \u0391\u03C6\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03BC\u03B9\u03BA\u03C1\u03AE
      \u03B1\u03C0\u03CC\u03BB\u03B1\u03C5\u03C3\u03B7, \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03CC\u03BB\u03B7 \u03B4\u03B9\u03BA\u03AE \u03C3\u03B1\u03C2! \u0391\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5
      \u03C4\u03B7 \u03B3\u03B5\u03CD\u03C3\u03B7! \u03A0\u03B1\u03C1\u03B1\u03C3\u03BA\u03B5\u03C5\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2! \u039F\u03C1\u03AF\u03C3\u03C4\u03B5!
      \u03A0\u03B9\u03B5\u03AF\u03C4\u03B5 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5!?
      \u03A4\u03BF \u03C4\u03AD\u03BB\u03B5\u03B9\u03BF \u03C6\u03BB\u03B9\u03C4\u03B6\u03AC\u03BD\u03B9
      \u03C3\u03B1\u03C2, \u03C3\u03B5\u03C1\u03B2\u03AF\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C7\u03B1\u03BC\u03CC\u03B3\u03B5\u03BB\u03BF! \u03A0\u03B9\u03B5\u03AF\u03C4\u03B5
      \u03BC\u03B9\u03B1 \u03B3\u03BF\u03C5\u03BB\u03B9\u03AC \u03BA\u03B1\u03B9
      \u03B1\u03C6\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03CC\u03C3\u03BC\u03BF
      \u03BD\u03B1 \u03BB\u03B9\u03CE\u03C3\u03B5\u03B9! \u0395\u03BB\u03C0\u03AF\u03B6\u03C9
      \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC \u03BD\u03B1
      \u03BE\u03B5\u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03C3\u03B4\u03BF\u03BA\u03AF\u03B5\u03C2
      \u03C3\u03B1\u03C2! \u0395\u03AF\u03B8\u03B5 \u03B7 \u03BC\u03AD\u03C1\u03B1
      \u03C3\u03B1\u03C2 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03CC\u03C3\u03BF
      \u03B1\u03C0\u03BF\u03BB\u03B1\u03C5\u03C3\u03C4\u03B9\u03BA\u03AE \u03CC\u03C3\u03BF
      \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC! \u0395\u03AF\u03B8\u03B5
      \u03B7 \u03BC\u03AD\u03C1\u03B1 \u03C3\u03B1\u03C2 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C4\u03CC\u03C3\u03BF \u03B1\u03C0\u03BF\u03BB\u03B1\u03C5\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03CC\u03C3\u03BF \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03BF\u03C4\u03CC!
      \u03A0\u03B9\u03B5\u03AF\u03C4\u03B5, \u03B3\u03B5\u03C5\u03C4\u03B5\u03AF\u03C4\u03B5
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03BB\u03B1\u03CD\u03C3\u03C4\u03B5!
      \u0395\u03AF\u03BD\u03B1\u03B9 \u03C6\u03C4\u03B9\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2! \u0395\u03B4\u03CE
      \u03B5\u03AF\u03BD\u03B1\u03B9, \u03B8\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03CC\u03C0\u03C9\u03C2 \u03C3\u03B1\u03C2 \u03B1\u03C1\u03AD\u03C3\u03B5\u03B9."
