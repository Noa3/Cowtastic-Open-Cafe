  - m_Id: 162454964742496256
    m_Localized: "\u0388\u03BA\u03B1\u03BD\u03B5\u03C2 \u03C4\u03B7 Barista \u03C3\u03BF\u03C5
      \u03CC\u03C3\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF!  \u0388\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C6\u03C4\u03AC\u03C3\u03B5\u03B9 \u03C3\u03C4\u03BF \u03AD\u03C0\u03B1\u03BA\u03C1\u03BF
      \u03C4\u03B9\u03C2 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03B7\u03C2, \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03C5\u03C7\u03AC\u03C1\u03B9\u03C3\u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7
      \u03BD\u03B1 \u03B5\u03BD\u03C4\u03B1\u03C7\u03B8\u03B5\u03AF \u03C3\u03C4\u03BF
      \u03B3\u03B1\u03BB\u03B1\u03BA\u03C4\u03BF\u03BA\u03BF\u03BC\u03B5\u03AF\u03BF
      \u03C3\u03B1\u03C2 \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7 \u03B1\u03C0\u03B1\u03C3\u03C7\u03CC\u03BB\u03B7\u03C3\u03B7,
      \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C4\u03BF\u03BD\u03C4\u03B1\u03C2 \u03AD\u03BD\u03B1
      \u03AC\u03BB\u03BB\u03BF \u03C0\u03BF\u03B9\u03BF\u03C4\u03B9\u03BA\u03CC \u03BA\u03BF\u03C1\u03AF\u03C4\u03C3\u03B9
      \u03B1\u03B3\u03B5\u03BB\u03AC\u03B4\u03B1\u03C2 \u03C3\u03C4\u03BF \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC
      \u03C3\u03B1\u03C2!\n\nbtw, \u03B5\u03C0\u03AC\u03BD\u03C9 \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03AC
      \u03C3\u03C4\u03BF Arcade Mode. ;)"
    m_Metadata:
      m_Items: []
