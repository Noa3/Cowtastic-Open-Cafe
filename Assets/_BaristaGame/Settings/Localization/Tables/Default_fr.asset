    m_Localized: Normale
    m_Metadata:
      m_Items: []
  - m_Id: 266676540370944
    m_Localized: "Jouez jusqu'\xE0 ce que votre Barista soit aussi grande que possible,
      ou jusqu'\xE0 ce qu'elle se mette en col\xE8re et arr\xEAte."
