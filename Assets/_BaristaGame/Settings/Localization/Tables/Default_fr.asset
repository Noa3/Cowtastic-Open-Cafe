      m_Items: []
  - m_Id: 167535336119881728
    m_Localized: "Salut!; Bonjour.; H\xE9! beaut\xE9.; H\xE9.; Salut.; Bonjour!;
      Salut...; Hum...\_; Euh...; Euh...; Ah !; Yo.; Bonjour...; Salutations.; Bonjour
      jeune femme.; Eyo.; Souper.; Euh...; Salut!; Salut!; H\xE9! Quoi de neuf?;
      Bonne journ\xE9e!; Salut !; H\xE9! \xC9tranger.; Salutations\_!\_; Bien! Bonjour!;
      Salut! comment vas-tu?; H\xE9! Content de te voir!; H\xE9! Cela fait longtemps
      qu'on ne s'est pas vu!; H\xE9! Qu'est ce qui se cuisine?; H\xE9! Comment \xE7a
      va?; H\xE9! Ravi de vous rencontrer!; H\xE9! Quoi de neuf?; H\xE9! Comment
      va la vie?; H\xE9! Comment \xE7a va ?; H\xE9! Comment est ta journ\xE9e?; H\xE9!
      Comment se passe ta journ\xE9e?; H\xE9! Comment \xE7a se passe?; H\xE9! Comment
      as-tu \xE9t\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 167615756777836544
    m_Localized: "J'en veux ; Puis-je en avoir ; As-tu ; Puis-je commander\_? Puis-je
