  - m_Id: 182196916119949312
    m_Localized: Tolleranza alla pienezza+
    m_Metadata:
      m_Items: []
  - m_Id: 182196947719835648
    m_Localized: "Il barista perde la felicit\xE0 pi\xF9 lentamente."
