    m_Localized: "\u306D\u3048\u3001\u7F8E\u3057\u3044\u3001\u3042\u306A\u305F\u306E\u7B11\u9854\u3068\u305D\u306E\u66F2\u7DDA\u304C\u79C1\u306E\u5FC3\u81D3\u3092\u9AD8\u9CF4\u3089\u305B\u307E\u3059\u3002\u3053\u3093\u306B\u3061\u306F\u3001\u30B4\u30FC\u30B8\u30E3\u30B9\u3001\u3042\u306A\u305F\u306E\u76EE\u307B\u3069\u9B45\u529B\u7684\u306A\u3082\u306E\u306F\u3042\u308A\u307E\u3059\u304B?;\u3053\u3093\u306B\u3061\u306F\u3001\u7D20\u6674\u3089\u3057\u3044\u3067\u3059\u306D\u3001\u3042\u306A\u305F\u306E\u59FF\u306F\u3053\u3053\u3067\u306F\u672C\u7269\u3067\u3059\u3002;\u306D\u3048\u3001\u304D\u308C\u3044\u306A\u5973\u6027\u3001\u3042\u306A\u305F\u306E\u30EB\u30C3\u30AF\u30B9\u306F\u3069\u3093\u306A\u98F2\u307F\u7269\u3082\u304A\u3044\u3057\u304F\u3057\u3066\u304F\u308C\u307E\u3059\u3002;\u3053\u3093\u306B\u3061\u306F\u3001\u30C1\u30E3\u30FC\u30E0\u3055\u3093\u3001\u3042\u306A\u305F\u306E\u7F8E\u3057\u3055\u306F\u3069\u3093\u306A\u30AB\u30AF\u30C6\u30EB\u3088\u308A\u3082\u3055\u308F\u3084\u304B\u3067\u3059\u3002\u3053\u3093\u306B\u3061\u306F\u3001\u5929\u4F7F\u3001\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u4F53\u3092\u6301\u3063\u3066\u3044\u308B\u306E\u306B\u3001\u8AB0\u304C\u98F2\u307F\u7269\u3092\u5FC5\u8981\u3068\u3057\u307E\u3059\u304B?;\u306D\u3048\u3001\u304A\u4EBA\u5F62\u3055\u3093\u3001\u3042\u306A\u305F\u306E\u66F2\u7DDA\u306F\u7F8E\u3057\u3055\u306E\u5B8C\u74A7\u306A\u878D\u5408\u3067\u3059\u3002\u3053\u3093\u306B\u3061\u306F\u3001\u53EF\u611B\u3044\u4EBA\u3001\u3042\u306A\u305F\u306E\u59FF\u306F\u3053\u306E\u30D0\u30FC\u306E\u4E00\u756A\u306E\u90E8\u5206\u3067\u3059\u3002;\u306D\u3048\u3001\u30D9\u30A4\u30D3\u30FC\u3001\u3042\u306A\u305F\u306E\u898B\u4E8B\u306A\u5BB9\u59FF\u306B\u306F\u3081\u307E\u3044\u304C\u3059\u308B\u308F\u3002\u3053\u3093\u306B\u3061\u306F\u3001\u30A4\u30B1\u30E1\u30F3\u3001\u3042\u306A\u305F\u306E\u5B58\u5728\u304C\u3059\u3079\u3066\u3092\u7D20\u6575\u306B\u3057\u3066\u304F\u308C\u307E\u3059\u3002"
