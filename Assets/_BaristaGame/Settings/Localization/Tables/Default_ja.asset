      \u7DF4\u7FD2\u306F\u5B8C\u74A7\u306B\u3059\u308B\u3001\u3067\u3059\u306D\uFF1F@Spoken_Ah;
      \u4ECA\u56DE\u306F\u6B63\u3057\u304F\u3057\u307E\u3059\u3001\u898B\u3066\u304F\u3060\u3055\u3044\uFF01@Spoken_Ah;
      \u904E\u53BB\u306B\u7559\u307E\u3089\u305A\u3001\u6B21\u306E\u30B9\u30C6\u30C3\u30D7\u306B\u9032\u307F\u307E\u3057\u3087\u3046\uFF01@Spoken_Ah;
