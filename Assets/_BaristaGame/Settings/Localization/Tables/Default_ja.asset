      \u5C0F\u3055\u306A\u5F8C\u9000\u3067\u3059\u304C\u3001\u79C1\u306F\u623B\u3063\u3066\u304F\u308B\uFF01@Spoken_Ah;
      \u3042\u3042\u3001\u305D\u308C\u306F\u76EE\u6A19\u306B\u9054\u3057\u307E\u305B\u3093\u3067\u3057\u305F.@Spoken_Ah;
      \u30C7\u30B6\u30A4\u30F3\u306E\u673A\u306B\u623B\u308A\u307E\u3059\u3001\u3068\u601D\u3044\u307E\u3059.@Spoken_Ah;
      Hmm\u3001\u3082\u3046\u4E00\u5EA6\u8ABF\u6574\u3057\u307E\u3059.@Spoken_Ah;
      \u79C1\u306E\u30DE\u30B9\u30BF\u30FC\u30D4\u30FC\u30B9\u3092\u4F5C\u6210\u3059\u308B\u30D7\u30ED\u30BB\u30B9\u3067\u306E\u5C0F\u3055\u306A\u30DF\u30B9\u3067\u3059.@Spoken_Ah;
