    m_Localized: "\u4ECA\u65E5\u306F\u5BB6\u306B\u3044\u308B\u3079\u304D\u3060\u3063\u305F\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\u3053\u3053\u3067\u306F\u3042\u3089\u3086\u308B\u7A2E\u985E\u306E\u30AF\u30EC\u30A4\u30B8\u30FC\u306A\u3053\u3068\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u305F\u3081\u3001\u30AB\u30D5\u30A7\u5168\u4F53\u304C\u6DF7\u4E71\u3057\u3066\u3044\u307E\u3059\u3002 
